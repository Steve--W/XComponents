  +'.CurrentParser.Scanner;'#13#10'      if Scanner<>nil then'#13#10'        be'
  +'gin'#13#10'        State:=Scanner.WarnMsgState[MsgNumber];'#13#10'        c'
  +'ase State of'#13#10'        wmsOff:'#13#10'          begin'#13#10'         '
  +' {$IFDEF VerbosePasAnalyzer}'#13#10'          writeln(''TPasAnalyzer.EmitMe'
  +'ssage ignoring ['',Id,''] '',MsgType,'': ('',MsgNumber,'') Fmt={'',Fmt,''} '
