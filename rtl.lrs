  +'or(const AYear, AWeekOfYear, ADayOfWeek: Word);'#13#10'Procedure InvalidDat'
  +'eDayError(const AYear, ADayOfYear: Word);'#13#10'Procedure InvalidDateMonth'
  +'WeekError(const AYear, AMonth, AWeekOfMonth, ADayOfWeek: Word);'#13#10'Proc'
  +'edure InvalidDayOfWeekInMonthError(const AYear, AMonth, ANthDayOfWeek,  ADa'
  +'yOfWeek: Word);'#13#10#13#10'{ --------------------------------------------'
