  +#10'  if not PAElementExists(DeclProc) then'#13#10'    begin'#13#10'    // p'
  +'rocedure never used'#13#10'    if ProcScope.DeclarationProc=nil then'#13#10
  +'      begin'#13#10'      if El.Visibility in [visPrivate,visStrictPrivate] '
