  +' (aExponent<0) then'#13#10'      Result:=''-''+Result'#13#10'    else if (a'
  +'Exponent>0) and (aSign=''+'') then'#13#10'      Result:=aSign+Result;'#13#10
  +'  end;'#13#10#13#10'var'#13#10'  I,S : Integer;'#13#10'  C,Q : Char;'#13#10
  +'  PA : TPosArray;'#13#10'  InLiteral : Boolean;'#13#10#13#10'begin'#13#10' '
  +' SetLength(PA,4);'#13#10'  Result:='''';'#13#10'  Initvars;'#13#10'  // Wha'
  ,'t section to use ?'#13#10'  if (E>0) then'#13#10'    S:=1'#13#10'  else if '
  +'(E<0) then'#13#10'    S:=2'#13#10'  else'#13#10'    S:=3;'#13#10'  PA[0]:=0'
  +';'#13#10'  I:=GetSections(PA);'#13#10'  if (I<S) or (PA[S]-PA[S-1]=0) then'
  +#13#10'    S:=1;'#13#10'  // Extract correct section'#13#10'  SectionLength:'
  +'=PA[S]-PA[S-1]-1;'#13#10'  Section:=Copy(Fmt,PA[S-1]+1,SectionLength);'#13
  +#10'  SetLength(Section,SectionLength);'#13#10'  // Writeln(''Section '',I,'
  +''' : "'',Section,''" '',SectionLength);'#13#10'  AnalyzeFormat;'#13#10'  //'
  +' Writeln(''RequestedDigits: '',RequestedDigits,'', DecimalPos : '',DecimalP'
  +'os,'', LastDigit: '',LastDigit,'', FirstDigit: '',FirstDigit);'#13#10'  Cal'
  +'cRunVars;'#13#10'  // If we cannot process value using current settings, fa'
