  +'  DecodeDateWeek(AValue,Y,Result,DOW)'#13#10'end;'#13#10#13#10#13#10'Functi'
  +'on WeekOfTheYear(const AValue: TDateTime; out AYear: Word): Word;'#13#10#13
  +#10'Var'#13#10'  DOW : Word;'#13#10#13#10'begin'#13#10'  DecodeDateWeek(AVal'
  +'ue,AYear,Result,DOW);'#13#10'end;'#13#10#13#10#13#10'Function DayOfTheYear('
  +'const AValue: TDateTime): Word;'#13#10'begin'#13#10'  Result:=Trunc(AValue-'
  +'StartOfTheYear(AValue)+1);'#13#10'end;'#13#10#13#10#13#10'Function HourOfTh'
  +'eYear(const AValue: TDateTime): Word;'#13#10#13#10'Var'#13#10'  H,M,S,MS : '
  +'Word;'#13#10#13#10'begin'#13#10'  DecodeTime(AValue,H,M,S,MS);'#13#10'  Res'
  +'ult:=H+((DayOfTheYear(AValue)-1)*24);'#13#10'end;'#13#10#13#10#13#10'Functi'
  +'on MinuteOfTheYear(const AValue: TDateTime): LongWord;'#13#10#13#10'Var'#13
  +#10'  H,M,S,MS : Word;'#13#10#13#10'begin'#13#10'  DecodeTime(AValue,H,M,S,M'
  +'S);'#13#10'  Result:=M+(H+((DayOfTheYear(AValue)-1)*24))*60;'#13#10'end;'#13
  +#10#13#10#13#10'Function SecondOfTheYear(const AValue: TDateTime): LongWord;'
  +#13#10#13#10'Var'#13#10'  H,M,S,MS : Word;'#13#10#13#10'begin'#13#10'  Decod'
  +'eTime(AValue,H,M,S,MS);'#13#10'  Result:=(M+(H+((DayOfTheYear(AValue)-1)*24'
  +'))*60)*60+S;'#13#10'end;'#13#10#13#10#13#10'Function MilliSecondOfTheYear(c'
  +'onst AValue: TDateTime): NativeLargeInt;'#13#10#13#10'Var'#13#10'  H,M,S,MS'
  +' : Word;'#13#10#13#10'begin'#13#10'  DecodeTime(AValue,H,M,S,MS);'#13#10'  '
  +'Result:=((M+(H+((NativeLargeInt(DayOfTheYear(AValue))-1)*24))*60)*60+S)*100'
  +'0+MS;'#13#10'end;'#13#10#13#10#13#10'{ ------------------------------------'
  +'---------------------------------'#13#10'    Part of month functions.'#13#10
  +'  ---------------------------------------------------------------------}'#13
  +#10#13#10#13#10'Function WeekOfTheMonth(const AValue: TDateTime): Word;'#13
  +#10#13#10'var'#13#10'  Y,M,DOW : word;'#13#10#13#10'begin'#13#10'  DecodeDat'
  +'eMonthWeek(AValue,Y,M,Result,DOW);'#13#10'end;'#13#10#13#10#13#10'Function '
  +'WeekOfTheMonth(const AValue: TDateTime; out AYear, AMonth: Word): Word;'#13
  +#10#13#10'Var'#13#10'  DOW : Word;'#13#10#13#10'begin'#13#10'  DecodeDateMon'
  +'thWeek(AValue,AYear,AMonth,Result,DOW);'#13#10'end;'#13#10#13#10#13#10'Func'
  +'tion DayOfTheMonth(const AValue: TDateTime): Word;'#13#10#13#10'Var'#13#10
  +'  Y,M : Word;'#13#10#13#10'begin'#13#10'  DecodeDate(AValue,Y,M,Result);'#13
  +#10'end;'#13#10#13#10#13#10'Function HourOfTheMonth(const AValue: TDateTime)'
  +': Word;'#13#10#13#10'Var'#13#10'  Y,M,D,H,N,S,MS : Word;'#13#10#13#10'begin'
  +#13#10'  DecodeDateTime(AValue,Y,M,D,H,N,S,MS);'#13#10'  Result:=(D-1)*24+H;'
  +#13#10'end;'#13#10#13#10#13#10'Function MinuteOfTheMonth(const AValue: TDate'
  +'Time): Word;'#13#10#13#10'Var'#13#10'  Y,M,D,H,N,S,MS : Word;'#13#10#13#10
  +'begin'#13#10'  DecodeDateTime(AValue,Y,M,D,H,N,S,MS);'#13#10'  Result:=((D-'
  +'1)*24+H)*60+N;'#13#10'end;'#13#10#13#10#13#10'Function SecondOfTheMonth(con'
  +'st AValue: TDateTime): LongWord;'#13#10#13#10'Var'#13#10'  Y,M,D,H,N,S,MS :'
  +' Word;'#13#10#13#10'begin'#13#10'  DecodeDateTime(AValue,Y,M,D,H,N,S,MS);'
  +#13#10'  Result:=(((D-1)*24+H)*60+N)*60+S;'#13#10'end;'#13#10#13#10#13#10'Fu'
  +'nction MilliSecondOfTheMonth(const AValue: TDateTime): LongWord;'#13#10#13
  +#10'Var'#13#10'  Y,M,D,H,N,S,MS : Word;'#13#10#13#10'begin'#13#10'  DecodeDa'
  +'teTime(AValue,Y,M,D,H,N,S,MS);'#13#10'  Result:=((((D-1)*24+H)*60+N)*60+S)*'
  ,'1000+MS;'#13#10'end;'#13#10#13#10'{ ---------------------------------------'
  +'------------------------------'#13#10'    Part of week functions.'#13#10'  '
  +'---------------------------------------------------------------------}'#13
  +#10#13#10#13#10'Function DayOfTheWeek(const AValue: TDateTime): Word;'#13#10
  +#13#10'begin'#13#10'  Result:=DowMAP[DayOfWeek(AValue)];'#13#10'end;'#13#10
  +#13#10#13#10'Function HourOfTheWeek(const AValue: TDateTime): Word;'#13#10#13
  +#10'Var'#13#10'  H,M,S,MS : Word;'#13#10#13#10'begin'#13#10'  DecodeTime(AVa'
  +'lue,H,M,S,MS);'#13#10'  Result:=(DayOfTheWeek(AValue)-1)*24+H;'#13#10'end;'
  +#13#10#13#10#13#10'Function MinuteOfTheWeek(const AValue: TDateTime): Word;'
  +#13#10#13#10'Var'#13#10'  H,M,S,MS : Word;'#13#10#13#10'begin'#13#10'  Decod'
  +'eTime(AValue,H,M,S,MS);'#13#10'  Result:=((DayOfTheWeek(AValue)-1)*24+H)*60'
  +'+M;'#13#10'end;'#13#10#13#10#13#10'Function SecondOfTheWeek(const AValue: T'
  +'DateTime): LongWord;'#13#10#13#10'Var'#13#10'  H,M,S,MS : Word;'#13#10#13#10
  +'begin'#13#10'  DecodeTime(AValue,H,M,S,MS);'#13#10'  Result:=(((DayOfTheWee'
  +'k(AValue)-1)*24+H)*60+M)*60+S;'#13#10'end;'#13#10#13#10#13#10'Function Mill'
  +'iSecondOfTheWeek(const AValue: TDateTime): LongWord;'#13#10#13#10#13#10'Var'
  +#13#10'  H,M,S,MS : Word;'#13#10#13#10'begin'#13#10'  DecodeTime(AValue,H,M,'
  +'S,MS);'#13#10'  Result:=((((DayOfTheWeek(AValue)-1)*24+H)*60+M)*60+S)*1000+'
  +'MS;'#13#10'end;'#13#10#13#10'{ --------------------------------------------'
  +'-------------------------'#13#10'    Part of day functions.'#13#10'  ------'
  +'---------------------------------------------------------------}'#13#10#13
  +#10#13#10'Function HourOfTheDay(const AValue: TDateTime): Word;'#13#10'begin'
  +#13#10'  Result:=HourOf(AValue);'#13#10'end;'#13#10#13#10#13#10'Function Min'
  +'uteOfTheDay(const AValue: TDateTime): Word;'#13#10#13#10'Var'#13#10'  H,M,S'
  +',MS : Word;'#13#10#13#10'begin'#13#10'  DecodeTime(AValue,H,M,S,MS);'#13#10
  +'  Result:=(H*60)+M;'#13#10'end;'#13#10#13#10#13#10'Function SecondOfTheDay('
  +'const AValue: TDateTime): LongWord;'#13#10#13#10'Var'#13#10'  H,M,S,MS : Wo'
  +'rd;'#13#10#13#10'begin'#13#10'  DecodeTime(AValue,H,M,S,MS);'#13#10'  Resul'
  +'t:=((H*60)+M)*60+S;'#13#10'end;'#13#10#13#10#13#10'Function MilliSecondOfTh'
  +'eDay(const AValue: TDateTime): LongWord;'#13#10#13#10'Var'#13#10'  H,M,S,MS'
  +' : Word;'#13#10#13#10'begin'#13#10'  DecodeTime(AValue,H,M,S,MS);'#13#10'  '
  +'Result:=(((H*60)+M)*60+S)*1000+MS;'#13#10'end;'#13#10#13#10'{ -------------'
  +'--------------------------------------------------------'#13#10'    Part of'
  +' hour functions.'#13#10'  -------------------------------------------------'
  +'--------------------}'#13#10#13#10#13#10'Function MinuteOfTheHour(const AVa'
  +'lue: TDateTime): Word;'#13#10'begin'#13#10'  Result:=MinuteOf(AValue);'#13
  +#10'end;'#13#10#13#10#13#10'Function SecondOfTheHour(const AValue: TDateTime'
  +'): Word;'#13#10#13#10'Var'#13#10'  H,S,M,MS : Word;'#13#10#13#10'begin'#13
  +#10'  DecodeTime(AValue,H,M,S,MS);'#13#10'  Result:=M*60+S;'#13#10'end;'#13
  +#10#13#10#13#10'Function MilliSecondOfTheHour(const AValue: TDateTime): Long'
  +'Word;'#13#10#13#10'Var'#13#10'  H,S,M,MS : Word;'#13#10#13#10'begin'#13#10
  +'  DecodeTime(AValue,H,M,S,MS);'#13#10'  Result:=(M*60+S)*1000+MS;'#13#10'en'
  +'d;'#13#10#13#10'{ ---------------------------------------------------------'
  +'------------'#13#10'    Part of minute functions.'#13#10'  ----------------'
  +'-----------------------------------------------------}'#13#10#13#10#13#10'F'
  +'unction SecondOfTheMinute(const AValue: TDateTime): Word;'#13#10'begin'#13
  +#10'  Result:=SecondOf(AValue);'#13#10'end;'#13#10#13#10#13#10'Function Mill'
  +'iSecondOfTheMinute(const AValue: TDateTime): LongWord;'#13#10#13#10'Var'#13
  +#10'  H,S,M,MS : Word;'#13#10#13#10'begin'#13#10'  DecodeTime(AValue,H,M,S,M'
  +'S);'#13#10'  Result:=S*1000+MS;'#13#10'end;'#13#10#13#10'{ ----------------'
  +'-----------------------------------------------------'#13#10'    Part of se'
  +'cond functions.'#13#10'  --------------------------------------------------'
  +'-------------------}'#13#10#13#10'Function MilliSecondOfTheSecond(const AVa'
  +'lue: TDateTime): Word;'#13#10'begin'#13#10'  Result:=MilliSecondOf(AValue);'
  +#13#10'end;'#13#10#13#10'{ -------------------------------------------------'
  +'--------------------'#13#10'    Range checking functions.'#13#10'  --------'
  +'-------------------------------------------------------------}'#13#10#13#10
  +'Function WithinPastYears(const ANow, AThen: TDateTime; const AYears: Intege'
  +'r): Boolean;'#13#10'begin'#13#10'  Result:=YearsBetween(ANow,AThen)<=AYears'
  +';'#13#10'end;'#13#10#13#10#13#10'Function WithinPastMonths(const ANow, AThe'
  +'n: TDateTime; const AMonths: Integer): Boolean;'#13#10'begin'#13#10'  Resul'
  +'t:=MonthsBetween(ANow,AThen)<=AMonths;'#13#10'end;'#13#10#13#10#13#10'Funct'
  +'ion WithinPastWeeks(const ANow, AThen: TDateTime; const AWeeks: Integer): B'
  +'oolean;'#13#10'begin'#13#10'  Result:=WeeksBetween(ANow,AThen)<=AWeeks;'#13
  ,#10'end;'#13#10#13#10#13#10'Function WithinPastDays(const ANow, AThen: TDate'
  +'Time; const ADays: Integer): Boolean;'#13#10'begin'#13#10'  Result:=DaysBet'
  +'ween(ANow,AThen)<=ADays;'#13#10'end;'#13#10#13#10#13#10'Function WithinPast'
  +'Hours(const ANow, AThen: TDateTime; const AHours: NativeLargeInt): Boolean;'
  +#13#10'begin'#13#10'  Result:=HoursBetween(ANow,AThen)<=AHours;'#13#10'end;'
  +#13#10#13#10#13#10'Function WithinPastMinutes(const ANow, AThen: TDateTime; '
  +'const AMinutes: NativeLargeInt): Boolean;'#13#10'begin'#13#10'  Result:=Min'
  +'utesBetween(ANow,AThen)<=AMinutes;'#13#10'end;'#13#10#13#10#13#10'Function '
  +'WithinPastSeconds(const ANow, AThen: TDateTime; const ASeconds: NativeLarge'
  +'Int): Boolean;'#13#10'begin'#13#10'  Result:=SecondsBetween(ANow,Athen)<=AS'
  +'econds;'#13#10'end;'#13#10#13#10#13#10'Function WithinPastMilliSeconds(cons'
  +'t ANow, AThen: TDateTime; const AMilliSeconds: NativeLargeInt): Boolean;'#13
  +#10'begin'#13#10'  Result:=MilliSecondsBetween(ANow,AThen)<=AMilliSeconds;'
  +#13#10'end;'#13#10#13#10#13#10'{ -------------------------------------------'
  +'--------------------------'#13#10'    Period functions.'#13#10'  ----------'
  +'-----------------------------------------------------------}'#13#10#13#10'{'
  +#13#10'  These functions are declared as approximate by Borland.'#13#10'  A '
  +'bit strange, since it can be calculated exactly ?'#13#10#13#10'  -- No, bec'
  +'ause you need rounding or truncating (JM)'#13#10'}'#13#10#13#10#13#10'Funct'
  +'ion DateTimeDiff(const ANow, AThen: TDateTime): TDateTime;'#13#10'begin'#13
  +#10'  Result:= ANow - AThen;'#13#10'  if (ANow>0) and (AThen<0) then'#13#10
  +'    Result:=Result-0.5'#13#10'  else if (ANow<-1.0) and (AThen>-1.0) then'
  +#13#10'    Result:=Result+0.5;'#13#10'end;'#13#10#13#10#13#10'Function Years'
  +'Between(const ANow, AThen: TDateTime; AExact : Boolean = False): Integer;'
  +#13#10#13#10'var'#13#10'  yy, mm, dd: Word;'#13#10'  '#13#10'begin'#13#10'  '
  +'if AExact and (ANow >= -DateDelta) and (AThen >= -DateDelta) and'#13#10'   '
  +'  (ANow <= MaxDateTime) and (AThen <= MaxDateTime) then'#13#10'    begin'#13
  +#10'    PeriodBetween(ANow, AThen, yy , mm, dd);'#13#10'    Result := yy;'#13
  +#10'    end'#13#10'  else'#13#10'    Result:=Trunc((Abs(DateTimeDiff(ANow,AT'
  +'hen))+HalfMilliSecond)/ApproxDaysPerYear);'#13#10'end;'#13#10#13#10#13#10'F'
  +'unction MonthsBetween(const ANow, AThen: TDateTime; AExact : Boolean = Fals'
  +'e): Integer;'#13#10#13#10'var'#13#10'  y, m, d: Word;'#13#10#13#10'begin'#13
  +#10'  if AExact and (ANow >= -DateDelta) and (AThen >= -DateDelta) and'#13#10
  +'     (ANow <= MaxDateTime) and (AThen <= MaxDateTime) then'#13#10'    begin'
  +#13#10'    PeriodBetween(ANow, AThen, y, m, d);'#13#10'    Result := y*12 + '
  +'m;'#13#10'    end'#13#10'  else'#13#10'    Result:=Trunc((Abs(DateTimeDiff('
  +'ANow,AThen))+HalfMilliSecond)/ApproxDaysPerMonth);'#13#10'end;'#13#10#13#10
  +#13#10'Function WeeksBetween(const ANow, AThen: TDateTime): Integer;'#13#10
  +'begin'#13#10'  Result:=Trunc(Abs(DateTimeDiff(ANow,AThen))+HalfMilliSecond)'
  +' div 7;'#13#10'end;'#13#10#13#10#13#10'Function DaysBetween(const ANow, ATh'
  +'en: TDateTime): Integer;'#13#10'begin'#13#10'  Result:=Trunc(Abs(DateTimeDi'
  +'ff(ANow,AThen))+HalfMilliSecond);'#13#10'end;'#13#10#13#10#13#10'Function H'
  +'oursBetween(const ANow, AThen: TDateTime): NativeLargeInt;'#13#10'begin'#13
  +#10'  Result:=Trunc((Abs(DateTimeDiff(ANow,AThen))+HalfMilliSecond)*HoursPer'
  +'Day);'#13#10'end;'#13#10#13#10#13#10'Function MinutesBetween(const ANow, AT'
  +'hen: TDateTime): NativeLargeInt;'#13#10'begin'#13#10'  Result:=Trunc((Abs(D'
  +'ateTimeDiff(ANow,AThen))+HalfMilliSecond)*MinsPerDay);'#13#10'end;'#13#10#13
  +#10#13#10'Function SecondsBetween(const ANow, AThen: TDateTime): NativeLarge'
  +'Int;'#13#10'begin'#13#10'  Result:=Trunc((Abs(DateTimeDiff(ANow,AThen))+Hal'
  +'fMilliSecond)*SecsPerDay);'#13#10'end;'#13#10#13#10#13#10'Function MilliSec'
  +'ondsBetween(const ANow, AThen: TDateTime): NativeLargeInt;'#13#10'begin'#13
  +#10'  Result:=Trunc((Abs(DateTimeDiff(ANow,AThen))+HalfMilliSecond)*MSecsPer'
  +'Day);'#13#10'end;'#13#10#13#10'Procedure PeriodBetween(Const ANow, AThen: T'
  +'DateTime; Out Years, months, days : Word); '#13#10#13#10'var'#13#10'  Y1, Y'
  +'2, M1, M2, D1, D2: word;'#13#10#13#10'begin'#13#10'  if (AThen>ANow) then'
  +#13#10'    begin'#13#10'    DecodeDate(ANow,Y1,M1,D1);'#13#10'    DecodeDate'
  +'(AThen,Y2,M2,D2);'#13#10'    end'#13#10'  else'#13#10'    begin  '#13#10'  '
  +'  DecodeDate(AThen,Y1,M1,D1);'#13#10'    DecodeDate(ANow,Y2,M2,D2);'#13#10
  +'    end;'#13#10'  Years:=Y2-Y1;'#13#10'  if (M1>M2) or ((M1=M2) and (D1>D2)'
  +') then Dec(Years);'#13#10'  if (M1>M2) then Inc(M2,12); //already adjusted '
  +'Years in that case'#13#10'  Months:=M2-M1;'#13#10'  if (D2>=D1) then'#13#10
  +'    Days:=D2-D1'#13#10'  else'#13#10'    begin'#13#10'    if (Months=0) the'
  +'n'#13#10'      Months:=11'#13#10'    else'#13#10'      Dec(Months);'#13#10
  +'    Days:=(DaysInAMonth(Y1,M1)-D1)+D2;'#13#10'    end;'#13#10'end;         '
  ,'           '#13#10#13#10'{ ------------------------------------------------'
  +'---------------------'#13#10'    Timespan in xxx functions.'#13#10'  ------'
  +'---------------------------------------------------------------}'#13#10#13
  +#10'Function YearSpan(const ANow, AThen: TDateTime): Double;'#13#10'begin'#13
  +#10'  Result:=Abs(DateTimeDiff(ANow,AThen))/ApproxDaysPerYear;'#13#10'end;'
  +#13#10#13#10#13#10'Function MonthSpan(const ANow, AThen: TDateTime): Double;'
  +#13#10'begin'#13#10'  Result:=Abs(DateTimeDiff(ANow,AThen))/ApproxDaysPerMon'
  +'th;'#13#10'end;'#13#10#13#10#13#10'Function WeekSpan(const ANow, AThen: TDa'
  +'teTime): Double;'#13#10'begin'#13#10'  Result:=Abs(DateTimeDiff(ANow,AThen)'
  +') / 7'#13#10'end;'#13#10#13#10#13#10'Function DaySpan(const ANow, AThen: TD'
  +'ateTime): Double;'#13#10'begin'#13#10'  Result:=Abs(DateTimeDiff(ANow,AThen'
  +'));'#13#10'end;'#13#10#13#10#13#10'Function HourSpan(const ANow, AThen: TDa'
  +'teTime): Double;'#13#10'begin'#13#10'  Result:=Abs(DateTimeDiff(ANow,AThen)'
  +')*HoursPerDay;'#13#10'end;'#13#10#13#10#13#10'Function MinuteSpan(const ANo'
  +'w, AThen: TDateTime): Double;'#13#10'begin'#13#10'  Result:=Abs(DateTimeDif'
  +'f(ANow,AThen))*MinsPerDay;'#13#10'end;'#13#10#13#10#13#10'Function SecondSp'
  +'an(const ANow, AThen: TDateTime): Double;'#13#10'begin'#13#10'  Result:=Abs'
  +'(DateTimeDiff(ANow,AThen))*SecsPerDay;'#13#10'end;'#13#10#13#10#13#10'Funct'
  +'ion MilliSecondSpan(const ANow, AThen: TDateTime): Double;'#13#10'begin'#13
  +#10'  Result:=Abs(DateTimeDiff(ANow,AThen))*MSecsPerDay;'#13#10'end;'#13#10
  +#13#10#13#10'{ -------------------------------------------------------------'
  +'--------'#13#10'    Increment/decrement functions.'#13#10'  ---------------'
  +'------------------------------------------------------}'#13#10#13#10'{ TDat'
  +'eTime is not defined in the interval [-1.0..0.0[. Additionally, when'#13#10
  +'  negative the time part must be treated using its absolute value (0.25 alw'
  +'ays'#13#10'  means "6 a.m.") -> skip the gap and convert the time part when'
  +' crossing the'#13#10'  gap -- and take care of rounding errors }'#13#10'Pro'
  +'cedure MaybeSkipTimeWarp(OldDate: TDateTime; var NewDate: TDateTime);'#13#10
  +'begin'#13#10'  if (OldDate>=0) and (NewDate<-TDateTimeEpsilon) then'#13#10
  +'    NewDate:=int(NewDate-1.0+TDateTimeEpsilon)-frac(1.0+frac(NewDate))'#13
  +#10'  else if (OldDate<=-1.0) and (NewDate>-1.0+TDateTimeEpsilon) then'#13#10
  +'    NewDate:=int(NewDate+1.0-TDateTimeEpsilon)+frac(1.0-abs(frac(1.0+NewDat'
  +'e)));'#13#10'end;'#13#10#13#10#13#10'function IncNegativeTime(AValue, Adden'
  +'d: TDateTime): TDateTime;'#13#10'var'#13#10'  newtime: tdatetime;'#13#10'be'
  +'gin'#13#10'  newtime:=-frac(Avalue)+frac(Addend);'#13#10'  { handle roundin'
  +'g errors }'#13#10'  if SameValue(newtime,int(newtime)+1,TDateTimeEpsilon) t'
  +'hen'#13#10'    newtime:=int(newtime)+1'#13#10'  else if SameValue(newtime,i'
  +'nt(newtime),TDateTimeEpsilon) then'#13#10'    newtime:=int(newtime);'#13#10
  +'  { time underflow -> previous day }'#13#10'  if newtime<-TDateTimeEpsilon '
  +'then'#13#10'    begin'#13#10'      newtime:=1.0+newtime;'#13#10'      avalu'
  +'e:=int(avalue)-1;'#13#10'    end'#13#10'  { time overflow -> next day }'#13
  +#10'  else if newtime>=1.0-TDateTimeEpsilon then'#13#10'    begin'#13#10'   '
  +'   newtime:=newtime-1.0;'#13#10'      avalue:=int(avalue)+1;'#13#10'    end'
  +';'#13#10'  Result:=int(AValue)+int(Addend)-newtime;'#13#10'end;'#13#10#13#10
  +'Function IncYear(const AValue: TDateTime; const ANumberOfYears: Integer ): '
  +'TDateTime;'#13#10#13#10'Var'#13#10'  Y,M,D,H,N,S,MS : Word;'#13#10'begin'#13
  +#10'  DecodeDateTime(AValue,Y,M,D,H,N,S,MS);'#13#10'  Y:=Y+ANumberOfYears;'
  +#13#10'  If (M=2) and (D=29) And (Not IsLeapYear(Y)) then'#13#10'    D:=28;'
  +#13#10'  Result:=EncodeDateTime(Y,M,D,H,N,S,MS);'#13#10'end;'#13#10#13#10#13
  +#10'Function IncYear(const AValue: TDateTime): TDateTime; // ; const ANumber'
  +'OfYears: Integer = 1)'#13#10'begin'#13#10'  Result:=IncYear(Avalue,1);'#13
  +#10'end;'#13#10#13#10#13#10'Function IncWeek(const AValue: TDateTime; const '
  +'ANumberOfWeeks: Integer): TDateTime;'#13#10'begin'#13#10'  Result:=AValue+A'
  +'NumberOfWeeks*7;'#13#10'  MaybeSkipTimeWarp(AValue,Result);'#13#10'end;'#13
  +#10#13#10#13#10'Function IncWeek(const AValue: TDateTime): TDateTime; // ; c'
  +'onst ANumberOfWeeks: Integer = 1)'#13#10'begin'#13#10'  Result:=IncWeek(Ava'
  +'lue,1);'#13#10'end;'#13#10#13#10#13#10'Function IncDay(const AValue: TDateT'
  +'ime; const ANumberOfDays: Integer): TDateTime;'#13#10'begin'#13#10'  Result'
  +':=AValue+ANumberOfDays;'#13#10'  MaybeSkipTimeWarp(AValue,Result);'#13#10'e'
  +'nd;'#13#10#13#10#13#10'Function IncDay(const AValue: TDateTime): TDateTime;'
  +' //; const ANumberOfDays: Integer = 1)'#13#10'begin'#13#10'  Result:=IncDay'
  +'(Avalue,1);'#13#10'end;'#13#10#13#10#13#10'Function IncHour(const AValue: T'
  +'DateTime; const ANumberOfHours: NativeLargeInt): TDateTime;'#13#10'begin'#13
  +#10'  if AValue>=0 then'#13#10'    Result:=AValue+ANumberOfHours/HoursPerDay'
  ,#13#10'  else'#13#10'    Result:=IncNegativeTime(Avalue,ANumberOfHours/Hours'
  +'PerDay);'#13#10'  MaybeSkipTimeWarp(AValue,Result);'#13#10'end;'#13#10#13#10
  +#13#10'Function IncHour(const AValue: TDateTime): TDateTime; //; const ANumb'
  +'erOfHours: NativeLargeInt = 1'#13#10'begin'#13#10'  Result:=IncHour(AValue,'
  +'1);'#13#10'end;'#13#10#13#10#13#10'Function IncMinute(const AValue: TDateTi'
  +'me; const ANumberOfMinutes: NativeLargeInt): TDateTime;'#13#10'begin'#13#10
  +'  if AValue>=0 then'#13#10'    Result:=AValue+ANumberOfMinutes/MinsPerDay'
  +#13#10'  else'#13#10'    Result:=IncNegativeTime(Avalue,ANumberOfMinutes/Min'
  +'sPerDay);'#13#10'  MaybeSkipTimeWarp(AValue,Result);'#13#10'end;'#13#10#13
  +#10#13#10'Function IncMinute(const AValue: TDateTime): TDateTime; // ; const'
  +' ANumberOfMinutes: NativeLargeInt = 1'#13#10'begin'#13#10'  Result:=IncMinu'
  +'te(AValue,1);'#13#10'end;'#13#10#13#10#13#10'Function IncSecond(const AValu'
  +'e: TDateTime; const ANumberOfSeconds: NativeLargeInt): TDateTime;'#13#10'be'
  +'gin'#13#10'  if AValue>=0 then'#13#10'    Result:=AValue+ANumberOfSeconds/S'
  +'ecsPerDay'#13#10'  else'#13#10'    Result:=IncNegativeTime(Avalue,ANumberOf'
  +'Seconds/SecsPerDay);'#13#10'  MaybeSkipTimeWarp(AValue,Result);'#13#10'end;'
  +#13#10#13#10#13#10'Function IncSecond(const AValue: TDateTime): TDateTime; /'
  +'/ ; const ANumberOfSeconds: NativeLargeInt = 1'#13#10'begin'#13#10'  Result'
  +':=IncSecond(Avalue,1);'#13#10'end;'#13#10#13#10#13#10'Function IncMilliSeco'
  +'nd(const AValue: TDateTime; const ANumberOfMilliSeconds: NativeLargeInt): T'
  +'DateTime;'#13#10'begin'#13#10'  if Avalue>=0 then'#13#10'    Result:=AValue'
  +'+ANumberOfMilliSeconds/MSecsPerDay'#13#10'  else'#13#10'    Result:=IncNega'
  +'tiveTime(Avalue,ANumberOfMilliSeconds/MSecsPerDay);'#13#10'  MaybeSkipTimeW'
  +'arp(AValue,Result);'#13#10'end;'#13#10#13#10#13#10'Function IncMilliSecond('
  +'const AValue: TDateTime): TDateTime; // ; const ANumberOfMilliSeconds: Nati'
  +'veLargeInt = 1'#13#10'begin'#13#10'  Result:=IncMilliSecond(AValue,1);'#13
  +#10'end;'#13#10#13#10#13#10'{ ----------------------------------------------'
  +'-----------------------'#13#10'    Encode/Decode of complete timestamp'#13
  +#10'  ---------------------------------------------------------------------}'
  +#13#10#13#10#13#10'Function EncodeDateTime(const AYear, AMonth, ADay, AHour,'
  +' AMinute, ASecond, AMilliSecond: Word): TDateTime;'#13#10'begin'#13#10'  If'
  +' Not TryEncodeDateTime(AYear, AMonth, ADay, AHour, AMinute, ASecond, AMilli'
  +'Second,Result) then'#13#10'    InvalidDateTimeError(AYear, AMonth, ADay, AH'
  +'our, AMinute, ASecond, AMilliSecond)'#13#10'end;'#13#10#13#10#13#10'Procedu'
  +'re DecodeDateTime(const AValue: TDateTime; out AYear, AMonth, ADay, AHour, '
  +'AMinute, ASecond, AMilliSecond: Word);'#13#10'begin'#13#10'  DecodeTime(AVa'
  +'lue,AHour,AMinute,ASecond,AMilliSecond);'#13#10'  if AHour=24 then // can h'
  +'appen due rounding issues mantis 17123'#13#10'    begin'#13#10'      AHour:'
  +'=0; // rest is already zero'#13#10'      DecodeDate(round(AValue),AYear,AMo'
  +'nth,ADay);'#13#10'    end'#13#10'  else'#13#10'    DecodeDate(AValue,AYear,'
  +'AMonth,ADay);'#13#10'end;'#13#10#13#10#13#10'Function TryEncodeDateTime(con'
  +'st AYear, AMonth, ADay, AHour, AMinute, ASecond, AMilliSecond: Word; out AV'
  +'alue: TDateTime): Boolean;'#13#10#13#10'Var'#13#10' tmp : TDateTime;'#13#10
  +#13#10'begin'#13#10'  Result:=TryEncodeDate(AYear,AMonth,ADay,AValue);'#13#10
  +'  Result:=Result and TryEncodeTime(AHour,AMinute,ASecond,Amillisecond,Tmp);'
  +#13#10'  If Result then'#13#10'    Avalue:=ComposeDateTime(AValue,Tmp);'#13
  +#10'end;'#13#10#13#10'{ ----------------------------------------------------'
  +'-----------------'#13#10'    Encode/decode date, specifying week of year an'
  +'d day of week'#13#10'  ----------------------------------------------------'
  +'-----------------}'#13#10#13#10'Function EncodeDateWeek(const AYear, AWeekO'
  +'fYear: Word; const ADayOfWeek: Word): TDateTime;'#13#10'begin'#13#10'  If N'
  +'ot TryEncodeDateWeek(AYear,AWeekOfYear,Result,ADayOfWeek) then'#13#10'    I'
  +'nvalidDateWeekError(AYear,AWeekOfYear,ADayOfWeek);'#13#10'end;'#13#10#13#10
  +#13#10'Function EncodeDateWeek(const AYear, AWeekOfYear: Word): TDateTime; /'
  +'/; const ADayOfWeek: Word = 1'#13#10'begin'#13#10'  Result := EncodeDateWee'
  +'k(AYear,AWeekOfYear,1);'#13#10'end;'#13#10#13#10#13#10'Procedure DecodeDate'
  +'Week(const AValue: TDateTime; out AYear, AWeekOfYear, ADayOfWeek: Word);'#13
  +#10#13#10'var'#13#10'  DOY : Integer;'#13#10'  D: Word;'#13#10'  YS : TDateT'
  +'ime;'#13#10'  YSDOW, YEDOW: Word;'#13#10#13#10'begin'#13#10'  AYear:=YearOf'
  +'(AValue);'#13#10'  // Correct to ISO DOW'#13#10'  ADayOfWeek:=DayOfWeek(AVa'
  +'lue)-1;'#13#10'  If ADAyOfWeek=0 then'#13#10'    ADayofweek:=7;'#13#10'  YS'
  +':=StartOfAYear(AYear);'#13#10'  DOY:=Trunc(AValue-YS)+1;'#13#10'  YSDOW:=Da'
  +'yOfTheWeek(YS);'#13#10'  // Correct week if later than wednesday. First wee'
  +'k never starts later than wednesday'#13#10'  if (YSDOW<5) then'#13#10'    I'
  ,'nc(DOY,YSDOW-1)'#13#10'  else'#13#10'    Dec(DOY,8-YSDOW);'#13#10'  if (DOY'
  +'<=0) then // Day is in last week of previous year.'#13#10'    DecodeDateWee'
  +'k(YS-1,AYear,AWeekOfYear,D)'#13#10'  else'#13#10'    begin'#13#10'    AWeek'
  +'OfYear:=DOY div 7;'#13#10'    if ((DOY mod 7)<>0) then'#13#10'      Inc(AWe'
  +'ekOfYear);'#13#10'    if (AWeekOfYear>52) then // Maybe in first week of ne'
  +'xt year ?'#13#10'      begin'#13#10'      YEDOW:=YSDOW;'#13#10'      if IsL'
  +'eapYear(AYear) then'#13#10'        begin'#13#10'        Inc(YEDOW);'#13#10
  +'        if (YEDOW>7) then'#13#10'          YEDOW:=1;'#13#10'        end;'#13
  +#10'      if (YEDOW<4) then // Really next year.'#13#10'        begin'#13#10
  +'        Inc(AYear);'#13#10'        AWeekOfYear:=1;'#13#10'        end;'#13
  +#10'      end;'#13#10'  end;'#13#10'end;'#13#10#13#10#13#10#13#10'Function T'
  +'ryEncodeDateWeek(const AYear, AWeekOfYear: Word; out AValue: TDateTime; con'
  +'st ADayOfWeek: Word): Boolean;'#13#10#13#10'Var'#13#10'  DOW : Word;'#13#10
  +'  Rest : Integer;'#13#10#13#10'begin'#13#10'  Result:=IsValidDateWeek(Ayear'
  +',AWeekOfYear,ADayOfWeek);'#13#10'  If Result then'#13#10'    begin'#13#10' '
  +'   AValue:=EncodeDate(AYear,1,1)+(7*(AWeekOfYear-1));'#13#10'    DOW:=DayOf'
  +'TheWeek(AValue);'#13#10'    Rest:=ADayOfWeek-DOW;'#13#10'    If (DOW>4) the'
  +'n'#13#10'      Inc(Rest,7);'#13#10'    AValue:=AValue+Rest;'#13#10'    end;'
  +#13#10'end;'#13#10#13#10#13#10'Function TryEncodeDateWeek(const AYear, AWeek'
  +'OfYear: Word; out AValue: TDateTime): Boolean; //; const ADayOfWeek: Word ='
  +' 1'#13#10'begin'#13#10'  Result:=TryEncodeDateWeek(AYear,AWeekOfYear,AValue'
  +',1);'#13#10'end;'#13#10#13#10'{ -------------------------------------------'
  +'--------------------------'#13#10'    Encode/decode date, specifying day of'
  +' year'#13#10'  ------------------------------------------------------------'
  +'---------}'#13#10#13#10'Function EncodeDateDay(const AYear, ADayOfYear: Wor'
  +'d): TDateTime;'#13#10'begin'#13#10'  If Not TryEncodeDateDay(AYear,ADayOfYe'
  +'ar,Result) then'#13#10'    InvalidDateDayError(AYear,ADayOfYear);'#13#10'en'
  +'d;'#13#10#13#10#13#10'Procedure DecodeDateDay(const AValue: TDateTime; out '
  +'AYear, ADayOfYear: Word);'#13#10#13#10'Var'#13#10'  M,D : Word;'#13#10#13#10
  +'begin'#13#10'  DecodeDate(AValue,AYear,M,D);'#13#10'  ADayOfyear:=Trunc(AVa'
  +'lue-EncodeDate(AYear,1,1))+1;'#13#10'end;'#13#10#13#10#13#10'Function TryEn'
  +'codeDateDay(const AYear, ADayOfYear: Word; out AValue: TDateTime): Boolean;'
  +#13#10'begin'#13#10'  Result:=(ADayOfYear<>0) and (ADayOfYear<=DaysPerYear ['
  +'IsleapYear(AYear)]);'#13#10'  If Result then'#13#10'    AValue:=EncodeDate('
  +'AYear,1,1)+ADayOfYear-1;'#13#10'end;'#13#10#13#10#13#10'{ -----------------'
  +'----------------------------------------------------'#13#10'    Encode/deco'
  +'de date, specifying week of month'#13#10'  --------------------------------'
  +'-------------------------------------}'#13#10#13#10#13#10'Function EncodeDa'
  +'teMonthWeek(const AYear, AMonth, AWeekOfMonth, ADayOfWeek: Word): TDateTime'
  +';'#13#10'begin'#13#10'  If Not TryEncodeDateMonthWeek(Ayear,AMonth,AWeekOfM'
  +'onth,ADayOfWeek,Result) then'#13#10'    InvalidDateMonthWeekError(AYear,AMo'
  +'nth,AWeekOfMonth,ADayOfWeek);'#13#10'end;'#13#10#13#10'Procedure DecodeDate'
  +'MonthWeek(const AValue: TDateTime; out AYear, AMonth, AWeekOfMonth, ADayOfW'
  +'eek: Word);'#13#10#13#10'Var'#13#10'  D,SDOM,EDOM : Word;'#13#10'  SOM : Td'
  +'ateTime;'#13#10'  DOM : Integer;'#13#10'begin'#13#10'  DecodeDate(AValue,AY'
  +'ear,AMonth,D);'#13#10'  ADayOfWeek:=DayOfTheWeek(AValue);'#13#10'  SOM:=Enc'
  +'odeDate(Ayear,Amonth,1);'#13#10'  SDOM:=DayOfTheWeek(SOM);'#13#10'  DOM:=D-'
  +'1+SDOM;'#13#10'  If SDOM>4 then'#13#10'    Dec(DOM,7);'#13#10'  // Too earl'
  +'y in the month. First full week is next week, day is after thursday.'#13#10
  +'  If DOM<=0 Then'#13#10'    DecodeDateMonthWeek(SOM-1,AYear,AMonth,AWeekOfM'
  +'onth,D)'#13#10'  else'#13#10'    begin'#13#10'    AWeekOfMonth:=(DOM div 7)'
  +';'#13#10'    if (DOM mod 7)<>0 then'#13#10'      Inc(AWeekOfMonth);'#13#10
  +'    EDOM:=DayOfTheWeek(EndOfAMonth(Ayear,AMonth));'#13#10'    // In last da'
  +'ys of last long week, so in next month...'#13#10'    If (EDOM<4) and ((Days'
  +'InAMonth(AYear,Amonth)-D)<EDOM) then'#13#10'      begin'#13#10'      AWeekO'
  +'fMonth:=1;'#13#10'      Inc(AMonth);'#13#10'      If (AMonth=13) then'#13#10
  +'        begin'#13#10'        AMonth:=1;'#13#10'        Inc(AYear);'#13#10' '
  +'       end;'#13#10'      end;'#13#10'    end;'#13#10'end;'#13#10#13#10'Func'
  +'tion TryEncodeDateMonthWeek(const AYear, AMonth, AWeekOfMonth, ADayOfWeek: '
  +'Word; out AValue: TDateTime): Boolean;'#13#10#13#10'var'#13#10'  S : Word;'
  +#13#10'  DOM : Integer;'#13#10#13#10'begin'#13#10'  Result:=IsValidDateMonth'
  +'Week(AYear,AMonth,AWeekOfMonth,ADayOfWeek);'#13#10'  if Result then'#13#10
  +'    begin'#13#10'    AValue:=EncodeDate(AYear,AMonth,1);'#13#10'    DOM:=(A'
  +'WeekOfMonth-1)*7+ADayOfWeek-1;'#13#10'    { Correct for first week in last '
  ,'month.}'#13#10'    S:=DayOfTheWeek(AValue);'#13#10'    Dec(DOM,S-1);'#13#10
  +'    if (S=DayFriday) or (S=DaySaturday) or (S=DaySunday) then'#13#10'      '
  +'Inc(DOM,7);'#13#10'    AValue:=AValue+DOM;'#13#10'    end;'#13#10'end;'#13
  +#10#13#10'{ ----------------------------------------------------------------'
  +'-----'#13#10'    Encode time interval, allowing hours>24'#13#10'  ---------'
  +'------------------------------------------------------------}'#13#10#13#10
  +'function TryEncodeTimeInterval(Hour, Min, Sec, MSec: word; out Time: TDateT'
  +'ime): boolean;'#13#10'begin'#13#10' Result:= (Min<60) and (Sec<60) and (MSe'
  +'c<1000);'#13#10' If Result then'#13#10'   Time:=TDateTime(cardinal(Hour)*36'
  +'00000+cardinal(Min)*60000+cardinal(Sec)*1000+MSec)/MSecsPerDay;'#13#10'end;'
  +#13#10#13#10'function EncodeTimeInterval(Hour, Minute, Second, MilliSecond: '
  +'word): TDateTime;'#13#10'begin'#13#10'   If not TryEncodeTimeInterval(Hour,'
  +'Minute,Second,MilliSecond,Result) then'#13#10'     Raise EConvertError.Crea'
  +'teFmt(SerrInvalidHourMinuteSecMsec,'#13#10'                               ['
  +'Hour,Minute,Second,MilliSecond]);'#13#10'end;'#13#10#13#10'{ --------------'
  +'-------------------------------------------------------'#13#10'    Replace '
  +'given element with supplied value.'#13#10'  -------------------------------'
  +'--------------------------------------}'#13#10#13#10'Const'#13#10'  LFAI = '
  +'RecodeLeaveFieldAsIS; // Less typing, readable code'#13#10'{'#13#10'  Note:'
  +' We have little choice but to implement it like Borland did:'#13#10'  If AV'
  +'alue contains some ''wrong'' value, it will throw an error.'#13#10'  To sim'
  +'ulate this we''d have to check in each function whether'#13#10'  both argum'
  +'ents are correct. To avoid it, all is routed through'#13#10'  the ''central'
  +''' RecodeDateTime function as in Borland''s implementation.'#13#10'}'#13#10
  +#13#10'Function RecodeYear(const AValue: TDateTime; const AYear: Word): TDat'
  +'eTime;'#13#10#13#10'begin'#13#10'  Result := RecodeDateTime(AValue,AYear,LF'
  +'AI,LFAI,LFAI,LFAI,LFAI,LFAI);'#13#10'end;'#13#10#13#10#13#10'Function Recod'
  +'eMonth(const AValue: TDateTime; const AMonth: Word): TDateTime;'#13#10'begi'
  +'n'#13#10'  Result := RecodeDateTime(AValue,LFAI,AMonth,LFAI,LFAI,LFAI,LFAI,'
  +'LFAI);'#13#10'end;'#13#10#13#10#13#10'Function RecodeDay(const AValue: TDat'
  +'eTime; const ADay: Word): TDateTime;'#13#10'begin'#13#10'  Result := Recode'
  +'DateTime(AValue,LFAI,LFAI,ADay,LFAI,LFAI,LFAI,LFAI);'#13#10'end;'#13#10#13
  +#10#13#10'Function RecodeHour(const AValue: TDateTime; const AHour: Word): T'
  +'DateTime;'#13#10'begin'#13#10'  Result := RecodeDateTime(AValue,LFAI,LFAI,L'
  +'FAI,AHour,LFAI,LFAI,LFAI);'#13#10'end;'#13#10#13#10#13#10'Function RecodeMi'
  +'nute(const AValue: TDateTime; const AMinute: Word): TDateTime;'#13#10'begin'
  +#13#10'  Result := RecodeDateTime(AValue,LFAI,LFAI,LFAI,LFAI,AMinute,LFAI,LF'
  +'AI);'#13#10'end;'#13#10#13#10#13#10'Function RecodeSecond(const AValue: TDa'
  +'teTime; const ASecond: Word): TDateTime;'#13#10'begin'#13#10'  Result := Re'
  +'codeDateTime(AValue,LFAI,LFAI,LFAI,LFAI,LFAI,ASecond,LFAI);'#13#10'end;'#13
  +#10#13#10#13#10'Function RecodeMilliSecond(const AValue: TDateTime; const AM'
  +'illiSecond: Word): TDateTime;'#13#10'begin'#13#10'  Result := RecodeDateTim'
  +'e(AValue,LFAI,LFAI,LFAI,LFAI,LFAI,LFAI,AMilliSecond);'#13#10'end;'#13#10#13
  +#10#13#10'Function RecodeDate(const AValue: TDateTime; const AYear, AMonth, '
  +'ADay: Word): TDateTime;'#13#10'begin'#13#10'  Result := RecodeDateTime(AVal'
  +'ue,AYear,AMonth,ADay,LFAI,LFAI,LFAI,LFAI);'#13#10'end;'#13#10#13#10#13#10'F'
  +'unction RecodeTime(const AValue: TDateTime; const AHour, AMinute, ASecond, '
  +'AMilliSecond: Word): TDateTime;'#13#10'begin'#13#10'  Result := RecodeDateT'
  +'ime(AValue,LFAI,LFAI,LFAI,AHour,AMinute,ASecond,AMilliSecond);'#13#10'end;'
  +#13#10#13#10#13#10'Function RecodeDateTime(const AValue: TDateTime; const AY'
  +'ear, AMonth, ADay, AHour, AMinute, ASecond, AMilliSecond: Word): TDateTime;'
  +#13#10'begin'#13#10'  If Not TryRecodeDateTime(AValue,AYear,AMonth,ADay,AHou'
  +'r,AMinute,ASecond,AMilliSecond,Result) then'#13#10'    InvalidDateTimeError'
  +'(AYear,AMonth,ADay,AHour,AMinute,ASecond,AMilliSecond,AValue);'#13#10'end;'
  +#13#10#13#10#13#10'Function TryRecodeDateTime(const AValue: TDateTime; const'
  +' AYear, AMonth, ADay, AHour, AMinute, ASecond, AMilliSecond: Word; out ARes'
  +'ult: TDateTime): Boolean;'#13#10#13#10'  Procedure FV (var AV{%H-} : Word; '
  +'Arg : Word);'#13#10#13#10'  begin'#13#10'    If (Arg<>LFAI) then'#13#10'   '
  +'   AV:=Arg;'#13#10'  end;'#13#10#13#10'Var'#13#10'  Y,M,D,H,N,S,MS : Word;'
  +#13#10#13#10'begin'#13#10'  DecodeDateTime(AValue,Y,M,D,H,N,S,MS);'#13#10'  '
  +'FV(Y,AYear);'#13#10'  FV(M,AMonth);'#13#10'  FV(D,ADay);'#13#10'  FV(H,AHou'
  +'r);'#13#10'  FV(N,AMinute);'#13#10'  FV(S,ASecond);'#13#10'  FV(MS,AMillise'
  +'cond);'#13#10'  Result:=TryEncodeDateTime(Y,M,D,H,N,S,MS,AResult);'#13#10'e'
  +'nd;'#13#10#13#10'{ --------------------------------------------------------'
  ,'-------------'#13#10'    Comparision of date/time'#13#10'  ----------------'
  +'-----------------------------------------------------}'#13#10#13#10#13#10'F'
  +'unction CompareDateTime(const A, B: TDateTime): TValueRelationship;'#13#10
  +'begin'#13#10'  If SameDateTime(A,B) then'#13#10'    Result:=EqualsValue'#13
  +#10'  else if trunc(a)=trunc(b) then'#13#10'    begin'#13#10'    if abs(frac'
  +'(a))>abs(frac(b)) then '#13#10'      result:=GreaterThanValue'#13#10'    el'
  +'se '#13#10'      result:=LessThanValue;'#13#10'    end '#13#10'  else '#13
  +#10'    begin'#13#10'    if a>b then '#13#10'      result:=GreaterThanValue'
  +#13#10'    else '#13#10'      result:=LessThanValue;'#13#10'    end;'#13#10
  +'end;'#13#10#13#10#13#10'Function CompareDate(const A, B: TDateTime): TValue'
  +'Relationship;'#13#10'begin'#13#10'  If SameDate(A,B) then'#13#10'    Result'
  +':=EQualsValue'#13#10'  else if A<B then'#13#10'    Result:=LessThanValue'#13
  +#10'  else'#13#10'    Result:=GreaterThanValue;'#13#10'end;'#13#10#13#10#13
  +#10'Function CompareTime(const A, B: TDateTime): TValueRelationship;'#13#10
  +#13#10'begin'#13#10'  If SameTime(A,B) then'#13#10'    Result:=EQualsValue'
  +#13#10'  else If Frac(A)<Frac(B) then'#13#10'    Result:=LessThanValue'#13#10
  +'  else'#13#10'    Result:=GreaterThanValue;'#13#10'end;'#13#10#13#10#13#10
  +'Function SameDateTime(const A, B: TDateTime): Boolean;'#13#10'begin'#13#10
  +'  Result:=Abs(A-B)<OneMilliSecond;'#13#10'end;'#13#10#13#10#13#10'Function '
  +'SameDate(const A, B: TDateTime): Boolean;'#13#10'begin'#13#10'  Result:=Tru'
  +'nc(A)=Trunc(B);'#13#10'end;'#13#10#13#10#13#10'Function SameTime(const A, B'
  +': TDateTime): Boolean;'#13#10#13#10'begin'#13#10'  Result:=Frac(Abs(A-B))<O'
  +'neMilliSecond;'#13#10'end;'#13#10#13#10#13#10'Function InternalNthDayOfWeek'
  +'(DoM : Word) : Word;'#13#10#13#10'begin'#13#10'  Result:=(Dom-1) div 7 +1;'
  +#13#10'end;'#13#10#13#10'Function NthDayOfWeek(const AValue: TDateTime): Wor'
  +'d;'#13#10#13#10'begin'#13#10'  Result:=InternalNthDayOfWeek(DayOfTheMonth(A'
  +'Value));'#13#10'end;'#13#10#13#10#13#10'Procedure DecodeDayOfWeekInMonth(co'
  +'nst AValue: TDateTime; out AYear, AMonth, ANthDayOfWeek, ADayOfWeek: Word);'
  +#13#10#13#10'var'#13#10'  D: Word;'#13#10#13#10'begin'#13#10'  DecodeDate(AV'
  +'alue,AYear,AMonth,D);'#13#10'  ADayOfWeek:=DayOfTheWeek(AValue);'#13#10'  A'
  +'NthDayOfWeek:=InternalNthDayOfWeek(D);'#13#10'end;'#13#10#13#10#13#10'Funct'
  +'ion EncodeDayOfWeekInMonth(const AYear, AMonth, ANthDayOfWeek,  ADayOfWeek:'
  +' Word): TDateTime;'#13#10'begin'#13#10'  If Not TryEncodeDayOfWeekInMonth(A'
  +'Year,AMonth,ANthDayOfWeek,ADayOfWeek,Result) then'#13#10'    InvalidDayOfWe'
  +'ekInMonthError(AYear,AMonth,ANthDayOfWeek,ADayOfWeek);'#13#10'end;'#13#10#13
  +#10#13#10'Function TryEncodeDayOfWeekInMonth(const AYear, AMonth, ANthDayOfW'
  +'eek,  ADayOfWeek: Word; out AValue: TDateTime): Boolean;'#13#10#13#10'Var'
  +#13#10'  SOM,D : Word;'#13#10#13#10'begin'#13#10'  SOM:=DayOfTheWeek(EncodeD'
  +'ate(Ayear,AMonth,1));'#13#10'  D:=1+ADayOfWeek-SOM+7*(ANthDayOfWeek-1);'#13
  +#10'  If SOM>ADayOfWeek then'#13#10'    D:=D+7; // Clearer would have been I'
  +'nc(ANthDayOfweek) but it''s a const'#13#10'  Result:=TryEncodeDate(Ayear,AM'
  +'onth,D,AValue);'#13#10'end;'#13#10#13#10'{ --------------------------------'
  +'-------------------------------------'#13#10'    Exception throwing routine'
  +'s'#13#10'  ----------------------------------------------------------------'
  +'-----}'#13#10#13#10#13#10#13#10'Procedure InvalidDateTimeError(const AYear,'
  +' AMonth, ADay, AHour, AMinute, ASecond, AMilliSecond: Word; const ABaseDate'
  +': TDateTime);'#13#10#13#10'  Function DoField(Arg,Def : Word; Unknown: Stri'
  +'ng) : String;'#13#10#13#10'  begin'#13#10'    if Def=0 then ;'#13#10'    If'
  +' (Arg<>LFAI) then'#13#10'      Result:=Format(''%.*d'',[Length(Unknown),Arg'
  +'])'#13#10'    else if (ABaseDate=0) then'#13#10'      Result:=Unknown'#13#10
  +'    else'#13#10'      Result:=Format(''%.*d'',[Length(Unknown),Arg]);'#13#10
  +'  end;'#13#10#13#10'Var'#13#10'  Y,M,D,H,N,S,MS : Word;'#13#10'  Msg : Stri'
  +'ng;'#13#10#13#10'begin'#13#10'  DecodeDateTime(ABasedate,Y,M,D,H,N,S,MS);'
  +#13#10'  Msg:=DoField(AYear,Y,''????'');'#13#10'  Msg:=Msg+DateSeparator+DoF'
  +'ield(AMonth,M,''??'');'#13#10'  Msg:=Msg+DateSeparator+DoField(ADay,D,''??'
  +''');'#13#10'  Msg:=Msg+'' ''+DoField(AHour,H,''??'');'#13#10'  Msg:=Msg+Tim'
  +'eSeparator+DoField(AMinute,N,''??'');'#13#10'  Msg:=Msg+TimeSeparator+Dofie'
  +'ld(ASecond,S,''??'');'#13#10'  Msg:=Msg+DecimalSeparator+DoField(AMilliSeco'
  +'nd,MS,''???'');'#13#10'  Raise EConvertError.CreateFmt(SErrInvalidTimeStamp'
  +',[Msg]);'#13#10'end;'#13#10#13#10#13#10'Procedure InvalidDateTimeError(cons'
  +'t AYear, AMonth, ADay, AHour, AMinute, ASecond, AMilliSecond: Word); // con'
