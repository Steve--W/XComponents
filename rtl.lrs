  +'rent:=TControl(MouseDownComponent).Parent'#13#10'    else'#13#10'    begin'
  +#13#10'      //showmessage(''mousedowncomponent is ''+MouseDownComponent.Cla'
  +'ssName);'#13#10'      if HasProperty(MouseDownComponent,''myControl'') then'
  +#13#10'      begin'#13#10'        // is a wrapperpanel'#13#10'        tmp:=G'
  +'etObjectProp(MouseDownComponent,''myControl'');'#13#10'        //if tmp<>ni'
  +'l then showmessage(''myControl is ''+tmp.ClassName);'#13#10'        NewPare'
  +'nt:=TComponent(tmp);                //!!!!! this doesn''t work here - still'
  +' uses original parent'#13#10'        //showmessage(''set parent to ''+NewPa'
  +'rent.ClassName);'#13#10'      end'#13#10'      else if (MouseDownComponent.'
  +'GetParentComponent is TWrapperPanel) then'#13#10'      begin'#13#10'       '
  +' // is fine. Nothing to do.'#13#10'      end;'#13#10'    end;'#13#10#13#10
  +#13#10'    //if NewParent<>nil then showmessage(''ac. new parent is ''+NewPa'
  +'rent.ClassName);'#13#10'    if (IsPublishedProp(AComponentClass,''myNode'')'
  +' = false) then'#13#10'    begin'#13#10'      showmessage(''WARNING:  This c'
  +'omponent is not cross-compilable to javascript - please select only from th'
  +'e available XComponents'');'#13#10'    end;'#13#10'  end;'#13#10'  Result:='
  +'true;'#13#10'end;'#13#10#13#10'procedure InsertUnderParent(var MyComponent:'
  +'TControl;MyParent:TWinControl;position:integer);'#13#10'var'#13#10'  bw,c:i'
  +'nteger;'#13#10'begin'#13#10'  if MyComponent.Parent<>nil then'#13#10'    My'
  +'Component.Parent.RemoveControl(MyComponent);'#13#10#13#10'  if position=-1 '
  +'then'#13#10'  begin'#13#10'    //insert the new control as the LAST child'
  +#13#10'    c:=MyParent.ControlCount;'#13#10'    MyParent.InsertControl(MyCom'
  +'ponent,c)'#13#10'  end'#13#10'  else'#13#10'  begin'#13#10'    if MyParent.'
  +'ControlCount>=position then'#13#10'      MyParent.InsertControl(MyComponent'
  +',position)'#13#10'    else'#13#10'      MyParent.InsertControl(MyComponent,'
  +'0);'#13#10'  end;'#13#10#13#10'  if MyParent is TWrapperPanel then'#13#10' '
  +' begin'#13#10'    if TWrapperPanel(MyParent).BorderStyle<>bsNone then      '
  +'  //!!!! is this still ok?'#13#10'    begin'#13#10'      bw:=MyParent.Borde'
  +'rWidth;'#13#10'      MyComponent.BorderSpacing.Left:=bw;'#13#10'      MyCom'
  +'ponent.BorderSpacing.Top:=bw;'#13#10'    end;'#13#10'  end;'#13#10#13#10'en'
  +'d;'#13#10#13#10'function DeleteScreenObject(MyNode:TDataNode):string;  over'
  +'load;'#13#10'var'#13#10'    ThisObject:TObject;'#13#10'begin'#13#10'   if ('
  +'MyNode.ScreenObject<>nil)'#13#10'   and (MyNode.ScreenObject<>MyNode) then'
  +#13#10'     if Assigned(MyNode.ScreenObject) then'#13#10'       FreeAndNil(M'
  ,'yNode.ScreenObject);  // this will free all child objects at same time'#13
  +#10'   NilScreenObject(MyNode);              // this clears all the pointers'
  +' to the (now freed) children'#13#10'end;'#13#10#13#10'function DeleteScreen'
  +'Object(ThisObject:TObject):string; overload;'#13#10'begin'#13#10'   if This'
  +'Object<>nil then'#13#10'   begin'#13#10'     FreeAndNil(ThisObject);'#13#10
  +'   end;'#13#10'end;'#13#10#13#10'procedure CheckParentIsXContainer(AControl'
  +':TControl);'#13#10'// In Lazarus IDE, user can drag/drop a component in the'
  +' design tree such that it becomes a child'#13#10'// of a wrapperpanel which'
