  +' ---------------------------------------------------------------------'#13
  +#10'    Julian and Modified Julian Date conversion support'#13#10'  --------'
  +'-------------------------------------------------------------}'#13#10#13#10
  +'{$push}'#13#10'{$R-}'#13#10'{$Q-}'#13#10#13#10'Function DateTimeToJulianDat'
  +'e(const AValue: TDateTime): Double;'#13#10'var'#13#10'  day,month,year: wor'
  +'d;'#13#10'  a,y,m: longint;'#13#10'begin'#13#10'  DecodeDate ( AValue, year'
  +', month, day );'#13#10'  a := (14-month) div 12;'#13#10'  y := year + 4800 '
  +'- a;'#13#10'  m := month + (12*a) - 3;'#13#10'  result := day + ((153*m+2) '
  +'div 5) + (365*y)'#13#10'    + (y div 4) - (y div 100) + (y div 400) - 32045'
  +'.5 + frac(avalue);'#13#10'end;'#13#10#13#10#13#10'Function JulianDateToDate'
  +'Time(const AValue: Double): TDateTime;'#13#10'begin'#13#10'  if not TryJuli'
  +'anDateToDateTime(AValue, Result) then'#13#10'    raise EConvertError.Create'
  +'Fmt(SInvalidJulianDate, [AValue]);'#13#10'end;'#13#10#13#10#13#10'Function '
  +'TryJulianDateToDateTime(const AValue: Double; out ADateTime: TDateTime): Bo'
  +'olean;'#13#10'var'#13#10'  a,b,c,d,e,m:longint;'#13#10'  day,month,year: wo'
  +'rd;'#13#10'begin'#13#10'  a := trunc(AValue + 32044.5);'#13#10'  b := (4*a '
  +'+ 3) div 146097;'#13#10'  c := a - (146097*b div 4);'#13#10'  d := (4*c + 3'
  +') div 1461;'#13#10'  e := c - (1461*d div 4);'#13#10'  m := (5*e+2) div 153'
  +';'#13#10'  day := e - ((153*m + 2) div 5) + 1;'#13#10'  month := m + 3 - 12'
  +' *  ( m div 10 );'#13#10'  year := (100*b) + d - 4800 + ( m div 10 );'#13#10
  +'  result := TryEncodeDate ( Year, Month, Day, ADateTime );'#13#10'  if Resu'
  +'lt then'#13#10'//    ADateTime:=IncMilliSecond(IncHour(ADateTime,-12),Milli'
  +'secondOfTheDay(Abs(Frac(aValue))));'#13#10'    ADateTime:=ADateTime+frac(AV'
  +'alue-0.5);'#13#10'end;'#13#10#13#10'Function DateTimeToModifiedJulianDate(c'
  +'onst AValue: TDateTime): Double;'#13#10'begin'#13#10'  result := DateTimeTo'
  +'JulianDate(AValue) - 2400000.5;'#13#10'end;'#13#10#13#10#13#10'Function Mod'
  +'ifiedJulianDateToDateTime(const AValue: Double): TDateTime;'#13#10'begin'#13
  +#10'  result := JulianDateToDateTime(AValue + 2400000.5);'#13#10'end;'#13#10
  +#13#10#13#10'Function TryModifiedJulianDateToDateTime(const AValue: Double; '
  +'out ADateTime: TDateTime): Boolean;'#13#10'begin'#13#10'  Result:=TryJulian'
  +'DateToDateTime(AValue + 2400000.5, ADateTime);'#13#10'end;'#13#10#13#10'{$p'
  +'op}//{$R-}{$Q-} for Julian conversion functions'#13#10#13#10'{ ------------'
  +'---------------------------------------------------------'#13#10'    Unix t'
  +'imestamp support.'#13#10'  ------------------------------------------------'
  +'---------------------}'#13#10#13#10'Function DateTimeToUnix(const AValue: T'
  +'DateTime): NativeLargeInt;'#13#10#13#10'begin'#13#10'  Result:=Round(DateTi'
  +'meDiff(RecodeMillisecond(AValue,0),UnixEpoch)*SecsPerDay);'#13#10'end;'#13
  +#10#13#10#13#10'Function UnixToDateTime(const AValue: NativeLargeInt): TDate'
  +'Time;'#13#10'begin'#13#10'  Result:=IncSecond(UnixEpoch, AValue);'#13#10'en'
  +'d;'#13#10#13#10#13#10'Function UnixTimeStampToMac(const AValue: NativeLarge'
  +'Int): NativeLargeInt;'#13#10'const'#13#10'  Epoch=24107 * 24 * 3600;'#13#10
  +'begin'#13#10'  Result:=AValue + Epoch;'#13#10'end;'#13#10#13#10'{ ---------'
  +'------------------------------------------------------------'#13#10'    Mac'
  +' timestamp support.'#13#10'  ----------------------------------------------'
  +'-----------------------}'#13#10#13#10'Function DateTimeToMac(const AValue: '
  +'TDateTime): NativeLargeInt;'#13#10'var'#13#10'  Epoch:TDateTime;'#13#10'beg'
  +'in'#13#10'  Epoch:=EncodeDateTime( 1904, 1, 1, 0, 0, 0, 0 );'#13#10'  Resul'
  +'t:=SecondsBetween( Epoch, AValue );'#13#10'end;'#13#10#13#10#13#10'Function'
  +' MacToDateTime(const AValue: NativeLargeInt): TDateTime;'#13#10'var'#13#10
  +'  Epoch:TDateTime;'#13#10'begin'#13#10'  Epoch:=EncodeDateTime( 1904, 1, 1,'
  +' 0, 0, 0, 0 );'#13#10'  Result:=IncSecond( Epoch, AValue );'#13#10'end;'#13
  +#10#13#10#13#10'Function MacTimeStampToUnix(const AValue: NativeLargeInt): N'
  +'ativeLargeInt;'#13#10'const'#13#10'  Epoch=24107 * 24 * 3600;'#13#10'begin'
  ,#13#10'  Result:=AValue - Epoch;'#13#10'end;'#13#10#13#10'Function DateTimeT'
  +'oDosDateTime(const AValue: TDateTime): longint;'#13#10'var year,month,day,h'
  +'our,min,sec,msec : word;'#13#10'    zs : longint;'#13#10'begin'#13#10'  dec'
  +'odedatetime(avalue,year,month,day,hour,min,sec,msec);'#13#10'  result:=-198'
  +'0;'#13#10'  result:=result+year and 127;'#13#10'  result:=result shl 4;'#13
  +#10'  result:=result+month;'#13#10'  result:=result shl 5;'#13#10'  result:='
  +'result+day;'#13#10'  result:=result shl 16;'#13#10'  zs:=hour;'#13#10'  zs:'
  +'=zs shl 6;'#13#10'  zs:=zs+min;'#13#10'  zs:=zs shl 5;'#13#10'  zs:=zs+sec '
  +'div 2;'#13#10'  result:=result+(zs and $ffff);'#13#10'end;'#13#10#13#10'Fun'
  +'ction DosDateTimeToDateTime( AValue: longint): TDateTime;'#13#10'var year,m'
  +'onth,day,hour,min,sec : integer;'#13#10'begin'#13#10'  sec:=(AValue and 31)'
  +' * 2;'#13#10'  avalue:=AValue shr 5;'#13#10'  min:=AValue and 63;'#13#10'  '
  +'avalue:=AValue shr 6;'#13#10'  hour:=AValue and 31;'#13#10'  avalue:=AValue'
  +' shr 5;'#13#10'  day:=AValue and 31;'#13#10'  avalue:=AValue shr 5;'#13#10
  +'  month:=AValue and 15;'#13#10'  avalue:=AValue shr 4;'#13#10'  year:=AValu'
  +'e+1980;'#13#10'  result:=EncodeDateTime(year,month,day,hour,min,sec,0);'#13
  +#10'end;'#13#10#13#10#13#10#13#10'const whitespace  = ['' '',#13,#10];'#13#10
  +'      hrfactor    = 1/(24);'#13#10'      minfactor   = 1/(24*60);'#13#10'  '
  +'    secfactor   = 1/(24*60*60);'#13#10'      mssecfactor = 1/(24*60*60*1000'
  +');'#13#10#13#10'const AMPMformatting : array[0..2] of string =(''am/pm'','''
  +'a/p'',''ampm'');'#13#10#13#10'procedure raiseexception(const s:string);'#13
  +#10#13#10'begin'#13#10'  raise EConvertError.Create(s);'#13#10'end;'#13#10#13
  +#10'{ Conversion of UTC to local time and vice versa }'#13#10#13#10'Function'
  +' GetLocalTimeOffset : Integer;'#13#10#13#10'begin'#13#10'  Result:=TJSDate.'
  +'New.getTimezoneOffset();'#13#10'end;'#13#10#13#10'function UniversalTimeToL'
  +'ocal(UT: TDateTime): TDateTime;'#13#10#13#10'begin'#13#10'  Result:=Univers'
  +'alTimeToLocal(UT,-GetLocalTimeOffset);'#13#10'end;'#13#10#13#10'function Un'
  +'iversalTimeToLocal(UT: TDateTime; TZOffset : Integer): TDateTime;'#13#10#13
  +#10'begin'#13#10'  if (TZOffset > 0) then'#13#10'    Result := UT + EncodeTi'
  +'me(TZOffset div 60, TZOffset mod 60, 0, 0)'#13#10'  else if (TZOffset < 0) '
  +'then'#13#10'    Result := UT - EncodeTime(Abs(TZOffset) div 60, Abs(TZOffse'
  +'t) mod 60, 0, 0)'#13#10'  else'#13#10'    Result := UT;'#13#10'end;'#13#10
  +' '#13#10'Function LocalTimeToUniversal(LT: TDateTime): TDateTime;'#13#10#13
  +#10'begin'#13#10'  Result:=LocalTimeToUniversal(LT,-GetLocalTimeOffset);'#13
  +#10'end;'#13#10#13#10'Function LocalTimeToUniversal(LT: TDateTime;TZOffset: '
  +'Integer): TDateTime;'#13#10#13#10'begin'#13#10'  if (TZOffset > 0) then'#13
  +#10'    Result := LT - EncodeTime(TZOffset div 60, TZOffset mod 60, 0, 0)'#13
  +#10'  else if (TZOffset < 0) then'#13#10'    Result := LT + EncodeTime(Abs(T'
  +'ZOffset) div 60, Abs(TZOffset) mod 60, 0, 0)'#13#10'  else'#13#10'    Resul'
  +'t := LT;'#13#10'end;'#13#10#13#10#13#10'{ RFC 3339 }'#13#10#13#10'function '
  +'DateTimeToRFC3339(ADate :TDateTime):string;'#13#10#13#10'begin'#13#10'  Res'
  +'ult:=FormatDateTime(''yyyy-mm-dd"T"hh":"nn":"ss"."zzz"Z"'',ADate);'#13#10'e'
  +'nd;'#13#10#13#10'function DateToRFC3339(ADate: TDateTime): string;'#13#10'b'
  +'egin'#13#10'  Result:=FormatDateTime(''yyyy-mm-dd'',ADate);'#13#10'end;'#13
  +#10#13#10'function TimeToRFC3339(ADate :TDateTime):string;'#13#10#13#10'begi'
  +'n'#13#10'  Result:=FormatDateTime(''hh":"nn":"ss"."zzz'',ADate);'#13#10'end'
  +';'#13#10#13#10'Function TryRFC3339ToDateTime(const Avalue: String; out ADat'
  +'eTime: TDateTime): Boolean;'#13#10#13#10'//          1         2'#13#10'// '
  +'12345678901234567890123'#13#10'// yyyy-mm-ddThh:nn:ss.zzz'#13#10#13#10'Type'
  +#13#10'  TPartPos = (ppTime,ppYear,ppMonth,ppDay,ppHour,ppMinute,ppSec);'#13
  +#10'  TPos = Array [TPartPos] of byte;'#13#10#13#10'Const'#13#10'  P : TPos '
  +'= (11,1,6,9,12,15,18);'#13#10#13#10'var'#13#10'  lY, lM, lD, lH, lMi, lS: I'
  +'nteger;'#13#10#13#10'begin'#13#10'  if Trim(AValue) = '''' then'#13#10'    '
  +'begin'#13#10'    Result:=True;'#13#10'    ADateTime:=0;'#13#10'    end;'#13
  +#10'  lY:=StrToIntDef(Copy(AValue,P[ppYear],4),-1);'#13#10'  lM:=StrToIntDef'
  +'(Copy(AValue,P[ppMonth],2),-1);'#13#10'  lD:=StrToIntDef(Copy(AValue,P[ppDa'
  +'y],2),-1);'#13#10'  if (Length(AValue)>=P[ppTime]) then'#13#10'    begin'#13
  +#10'    lH:=StrToIntDef(Copy(AValue,P[ppHour],2),-1);'#13#10'    lMi:=StrToI'
  +'ntDef(Copy(AValue,P[ppMinute],2),-1);'#13#10'    lS:=StrToIntDef(Copy(AValu'
  +'e,P[ppSec],2),-1);'#13#10'    end'#13#10'  else'#13#10'    begin'#13#10'   '
  +' lH:=0;'#13#10'    lMi:=0;'#13#10'    lS:=0;'#13#10'    end;'#13#10'  Resul'
  +'t:=(lY>=0) and (lM>=0) and (lD>=0) and (lH>=0) and (lMi>=0) and (ls>=0);'#13
  +#10'  if Not Result then'#13#10'    ADateTime:=0'#13#10'  else'#13#10'    { '
  +'Cannot EncodeDate if any part equals 0. EncodeTime is okay. }'#13#10'    if'
  ,' (lY = 0) or (lM = 0) or (lD = 0) then'#13#10'      ADateTime:=EncodeTime(l'
  +'H, lMi, lS, 0)'#13#10'    else'#13#10'      ADateTime:=EncodeDate(lY, lM, l'
  +'D) + EncodeTime(lH, lMi, lS, 0);'#13#10'end;'#13#10#13#10'Function RFC3339T'
  +'oDateTime(const Avalue: String): TDateTime;'#13#10#13#10'begin'#13#10'  if '
