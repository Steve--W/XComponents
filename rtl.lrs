  +'e; Strict : Boolean = False): TJSONStringType;'#13#10#13#10'Var'#13#10'  I,'
  +'J,L : Integer;'#13#10'  C : Char;'#13#10#13#10'begin'#13#10'  I:=1;'#13#10
  +'  J:=1;'#13#10'  Result:='''';'#13#10'  L:=Length(S);'#13#10'  While I<=L d'
  +'o'#13#10'    begin'#13#10'    C:=S[I];'#13#10'    if (C in [''"'',''/'',''\'
  +''',#0..#31]) then'#13#10'      begin'#13#10'      Result:=Result+Copy(S,J,I'
  +'-J);'#13#10'      Case C of'#13#10'        ''\'' : Result:=Result+''\\'';'
  +#13#10'        ''/'' : if Strict then'#13#10'                Result:=Result+'
  +'''\/'''#13#10'              else'#13#10'                Result:=Result+''/'
  +''';'#13#10'        ''"'' : Result:=Result+''\"'';'#13#10'        #8  : Resu'
  +'lt:=Result+''\b'';'#13#10'        #9  : Result:=Result+''\t'';'#13#10'     '
  +'   #10 : Result:=Result+''\n'';'#13#10'        #12 : Result:=Result+''\f'';'
  +#13#10'        #13 : Result:=Result+''\r'';'#13#10'      else'#13#10'       '
  +' Result:=Result+''\u''+HexStr(Ord(C),4);'#13#10'      end;'#13#10'      J:='
  +'I+1;'#13#10'      end;'#13#10'    Inc(I);'#13#10'    end;'#13#10'  Result:='
  +'Result+Copy(S,J,I-1);'#13#10'end;'#13#10#13#10'function JSONStringToString('
  +'const S: TJSONStringType): TJSONStringType;'#13#10#13#10'Var'#13#10'  I,J,L'
  +',U1,U2 : Integer;'#13#10'  App,W : String;'#13#10#13#10'  Procedure MaybeAp'
  +'pendUnicode;'#13#10#13#10'  Var'#13#10'    U : String;'#13#10#13#10'  begin'
  +#13#10'    if (U1<>0) then'#13#10'      begin'#13#10'      U:={$IFDEF FPC_HA'
  +'S_CPSTRING}UTF8Encode(WideChar(U1)){$ELSE}widechar(U1){$ENDIF};'#13#10'    '
  +'  Result:=Result+U;'#13#10'      U1:=0;'#13#10'      end;'#13#10'  end;'#13
  +#10#13#10'begin'#13#10'  I:=1;'#13#10'  J:=1;'#13#10'  L:=Length(S);'#13#10
  +'  Result:='''';'#13#10'  U1:=0;'#13#10'  While (I<=L) do'#13#10'    begin'
  +#13#10'    if (S[I]=''\'') then'#13#10'      begin'#13#10'      Result:=Resu'
  +'lt+Copy(S,J,I-J);'#13#10'      If I<L then'#13#10'        begin'#13#10'    '
  +'    Inc(I);'#13#10'        App:='''';'#13#10'        Case S[I] of'#13#10'  '
  +'        ''\'',''"'',''/'''#13#10'              : App:=S[I];'#13#10'        '
  +'  ''b'' : App:=#8;'#13#10'          ''t'' : App:=#9;'#13#10'          ''n'''
