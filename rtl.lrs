  +#10#13#10'Function DupeString(const AText: string; ACount: Integer): string;'
  +#13#10#13#10'var i : SizeInt;'#13#10#13#10'begin'#13#10' result:='''';'#13#10
  +' for i:=1 to ACount do'#13#10'   Result:=Result+aText;'#13#10'end;'#13#10#13
  +#10'Function ReverseString(const AText: string): string;'#13#10#13#10'var'#13
  +#10'  i,j : SizeInt;'#13#10#13#10'begin'#13#10'  setlength(result,length(ate'
  +'xt));'#13#10'  i:=1; j:=length(atext);'#13#10'  while (i<=j) do'#13#10'    '
  +'begin'#13#10'    result[i]:=atext[j-i+1];'#13#10'    inc(i);'#13#10'    end'
  +';'#13#10'end;'#13#10#13#10#13#10'Function AnsiReverseString(const AText: St'
  +'ring): String;'#13#10#13#10'begin'#13#10'  Result:=ReverseString(AText);'#13
  +#10'end;'#13#10#13#10#13#10'Function StuffString(const AText: string; AStart'
  +', ALength: Cardinal;  const ASubText: string): string;'#13#10#13#10'var i,j'
  +',k : SizeUInt;'#13#10#13#10'begin'#13#10'  j:=length(ASubText);'#13#10'  i:'
  +'=length(AText);'#13#10'  if AStart>i then '#13#10'    aStart:=i+1;'#13#10' '
  +' k:=i+1-AStart;'#13#10'  if ALength> k then'#13#10'    ALength:=k;'#13#10' '
  +' SetLength(Result,i+j-ALength);'#13#10'  Result:=Copy(AText,1,AStart-1)+Cop'
  +'y(ASubText,1,J)+Copy(AText,AStart+ALength,I+1-AStart-ALength);'#13#10'end;'
  +#13#10#13#10'Function RandomFrom(const AValues: array of string): string; ov'
  +'erload;'#13#10#13#10'begin'#13#10'  if high(AValues)=-1 then exit('''');'#13
  +#10'  result:=Avalues[random(High(AValues)+1)];'#13#10'end;'#13#10#13#10'Fun'
  +'ction IfThen(AValue: Boolean; const ATrue: string; const AFalse: string = '
  +'''''): string; overload;'#13#10#13#10'begin'#13#10'  if avalue then'#13#10
  +'    result:=atrue'#13#10'  else'#13#10'    result:=afalse;'#13#10'end;'#13
  +#10#13#10'function NaturalCompareText(const Str1, Str2: string; const ADecSe'
  ,'parator, AThousandSeparator: String): Integer;'#13#10'{'#13#10' NaturalComp'
  +'areBase compares strings in a collated order and'#13#10' so numbers are sor'
  +'ted too. It sorts like this:'#13#10#13#10' 01'#13#10' 001'#13#10' 0001'#13
  +#10#13#10' and'#13#10#13#10' 0'#13#10' 00'#13#10' 000'#13#10' 000_A'#13#10' '
  +'000_B'#13#10#13#10' in a intuitive order.'#13#10' }'#13#10'var'#13#10'  Num'
  +'1, Num2: double;'#13#10'  pStr1, pStr2: integer;'#13#10'  Len1, Len2: SizeI'
  +'nt;'#13#10'  TextLen1, TextLen2: SizeInt;'#13#10'  TextStr1: string = '''';'
  +#13#10'  TextStr2: string = '''';'#13#10'  i: SizeInt;'#13#10'  j: SizeInt;'
  +#13#10'  '#13#10'  function Sign(const AValue: sizeint): integer;'#13#10#13
  +#10'  begin'#13#10'    If Avalue<0 then'#13#10'      Result:=-1'#13#10'    e'
  +'lse If Avalue>0 then'#13#10'      Result:=1'#13#10'    else'#13#10'      Re'
  +'sult:=0;'#13#10'  end;'#13#10#13#10'  function IsNumber(ch: char): boolean;'
  +' overload;'#13#10'  begin'#13#10'    Result := ch in [''0''..''9''];'#13#10
  +'  end;'#13#10#13#10'  function GetInteger(aString : String; var pch: intege'
  +'r; var Len: sizeint): double;'#13#10#13#10'  begin'#13#10'    Result := 0;'
  +#13#10'    while (pch<=length(astring)) and IsNumber(AString[pch]) do'#13#10
  +'      begin'#13#10'      Result := (Result * 10) + Ord(Astring[pch]) - Ord('
  +'''0'');'#13#10'      Inc(Len);'#13#10'      Inc(pch);'#13#10'      end;'#13
  +#10'  end;'#13#10#13#10'  procedure GetChars;'#13#10#13#10'  begin'#13#10'  '
