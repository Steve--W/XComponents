  +'e,CompNode,myValue);'#13#10'      end;'#13#10'    end;'#13#10'  end;'#13#10
  +'end;'#13#10#13#10'function FindAndRunEventHandler(e:TEventStatus;MyEventTyp'
  +'e,nodeID,myValue:string;myNode:TDataNode):Boolean;'#13#10'  var'#13#10'    '
  +' i,NumHandlers:integer;'#13#10'     found:Boolean;'#13#10'  begin'#13#10'  '
  +'  found:=true;'#13#10'    //ShowMessage(''FindAndRunEventHandler. ''+MyEven'
  +'tType+'' NodeId=''+nodeID+'' value=''+myValue);'#13#10'    NumHandlers:= my'
  +'Node.MyEventTypes.count;'#13#10'    for i:=0 to NumHandlers - 1 do'#13#10' '
  +'   begin'#13#10'      if  myNode.MyEventTypes[i]=MyEventType then'#13#10'  '
  +'    begin'#13#10'        // Execute the registered event handler if it exis'
  +'ts'#13#10'        if (myNode.NodeType<>''TXComposite'')'#13#10'        and '
  +'(myNode.NodeType<>''TXCompositeIntf'') then'#13#10'        begin'#13#10'   '
  +'       found:=RunComponentEvent(e,nodeID,e.NameSpace,MyEventType,myNode,myV'
  +'alue);'#13#10'        end'#13#10'        else if (myNode.NodeType=''TXCompo'
  +'site'') then'#13#10'        begin'#13#10'          // for a composite, if t'
  +'he event is ''ReadOnlyInterface'', then execute the corresponding'#13#10'  '
  +'        // event on a TXCompositeIntf node, within the composite element in'
  +'stead.'#13#10'          RunCompositeEvent(e,nodeID,e.NameSpace,MyEventType,'
  +'myNode,myValue);'#13#10'        end'#13#10'        else if (myNode.NodeType'
  +'=''TXCompositeIntf'') then'#13#10'        begin'#13#10'          // for a c'
  +'omposite interface, if the event is NOT ''ReadOnlyInterface'', then execute'
  +' the corresponding'#13#10'          // event on the containing TXComposite '
  +'node instead.'#13#10'          RunInterfaceEvent(e,nodeID,e.NameSpace,MyEve'
  +'ntType,myNode,myValue);'#13#10'        end;'#13#10'      end;'#13#10'    en'
  +'d;'#13#10'    result:=found;'#13#10'end;'#13#10#13#10'function  handleEvent'
  +'(e:TEventStatus;MyEventType,nodeID,NameSpace,myValue,PropName:string):Boole'
  +'an;'#13#10'var'#13#10'  CurrentNode :TDataNode;'#13#10'  m: TMethod;'#13#10
  +'  {$ifndef JScript}'#13#10'  sc:TCursor;'#13#10'  {$endif}'#13#10'  found:B'
  +'oolean;'#13#10'begin'#13#10'  found:=true;'#13#10'  if (StartingUp = false)'
  +#13#10'  and (not SuppressEvents) //!! check this !!!!'#13#10'  then'#13#10
  +'  begin'#13#10#13#10'    if e=nil then'#13#10'    begin'#13#10'      e:=TEv'
  +'entStatus.Create(MyEventType,nodeID);'#13#10'      e.NameSpace:=NameSpace;'
  +#13#10'    end;'#13#10#13#10'     // Identify the system node.'#13#10'     /'
  +'/ nodeID is the screen object name (nodename in the TDataNode tree)'#13#10
  +'     //   **** exception - HTML TreeNode events send in the name of the tre'
  +'enode object'#13#10'     {$ifndef JScript}'#13#10'     sc:=Screen.Cursor;'
  +#13#10'     Screen.Cursor := crHourglass;'#13#10'     CurrentNode:=FindDataN'
  +'odeById(SystemNodeTree,nodeID,NameSpace,false);'#13#10'     {$else}'#13#10
  +'     if (MyEventType = ''TreeNodeClick'')'#13#10'     or (MyEventType = ''D'
  +'ragStart'')'#13#10'     or (MyEventType = ''Drop'')'#13#10'     then'#13#10
  ,'     begin'#13#10'       // try to get the system node name from the treeno'
  +'de name...'#13#10'       CurrentNode:=GetDataNodeFromTreeNode(nodeID,NameSp'
  +'ace);'#13#10'     end'#13#10'     else'#13#10'       //asm console.log(''ha'
  +'ndleEvent ''+MyEventType+'' ''+nodeID+'' ''+NameSpace); end;'#13#10'       '
  +'CurrentNode:=FindDataNodeById(SystemNodeTree,nodeID,NameSpace,false);'#13#10
  +'     {$endif}'#13#10#13#10'    if (CurrentNode<>nil)'#13#10'    and (MainFo'
  +'rm<>nil) then'#13#10'    begin'#13#10#13#10'        // Look for XTrapEvents'
  +' components.  Each may have a ''HandleAny'' process defined.'#13#10'       '
  +'  if e.InitRunning=false then'#13#10'           // don''t re-trap any event'
  +' that is entering the second phase (after async function)'#13#10'          '
  +' ExecuteEventTrappers(e,MyEventType,CurrentNode.nodeName,myValue,CurrentNod'
  +'e)'#13#10'         else'#13#10'           e.ContinueAfterTrappers:=true;'#13
  +#10#13#10'         if e.ContinueAfterTrappers then'#13#10'         begin'#13
  +#10'            // run the specific event handler defined in the form for th'
  +'is component and event type (if any)'#13#10'            //showmessage(''cal'
  +'ling FindAndRunEventHandler'');'#13#10'            found:=FindAndRunEventHa'
  +'ndler(e,MyEventType,CurrentNode.nodeName,myValue,CurrentNode) ;'#13#10'    '
  +'     end;'#13#10#13#10'     end;'#13#10#13#10'     {$ifndef JScript}'#13#10
  +'     Screen.Cursor:=sc;'#13#10'     {$endif}'#13#10'   end;'#13#10'  result'
  +':=found;'#13#10'end;'#13#10#13#10'function  handleEvent(e:TEventStatus;MyEv'
  +'entType,nodeID,NameSpace,myValue:string):Boolean;'#13#10'begin'#13#10'  res'
  +'ult:=handleEvent(e,MyEventType,nodeID,NameSpace,myValue,'''');'#13#10'end;'
  +#13#10'function  handleEvent(MyEventType,nodeID,NameSpace,myValue:string):Bo'
  +'olean;'#13#10'begin'#13#10'  result:=handleEvent(nil,MyEventType,nodeID,Nam'
  +'eSpace,myValue,'''');'#13#10'end;'#13#10#13#10#13#10'////// procedure calle'
  +'d from generated events unit, to execute user''s event handlers and to'#13
  +#10'////// control async functions with the init/main code sections in the e'
  +'vent'#13#10'// initfunc and mainfunc point to Pascal functions to be execut'
  +'ed.'#13#10'// If events are in Python mode, initfunc and mainfunc are null,'
  +' with the Python scripts in InitPyCode,MainPyCode'#13#10'procedure RunTheEv'
  +'entFunc(e:TEventStatus;NodeId: String; myValue: String; fn:THandler;PyCode:'
  +'String);'#13#10'var'#13#10'  bits:TStringList;'#13#10'  str:string;'#13#10
  +'  i:integer;'#13#10'begin'#13#10'  if fn<>nil then  // (Pascal) execute a f'
  +'unction in the dll'#13#10'    fn(e,NodeId,myValue)'#13#10'  else'#13#10'  b'
  +'egin  // run python script'#13#10'    bits:=TStringlist.Create;'#13#10'    '
  +'bits.text:=PyCode;'#13#10'    glbEvent:=e;'#13#10'{$ifdef JScript}'#13#10' '
  +'   // refresh the global ''e'' object in the Python (Pyodide) environment'
  +#13#10'    bits.insert(0,''e = pas.EventsInterface.glbEvent'');'#13#10'    /'
  +'/bits.insert(1,''print("python e.ReturnString:",e.ReturnString)'');'#13#10
  +'    //bits.insert(1,''print("python e:",e)'');'#13#10'{$else}'#13#10'    Pa'
  +'ssEToPythonFunc(e);'#13#10'    bits.Insert(0,''e = PyInterfaceE.Value'');'
  +#13#10'{$endif}'#13#10'    RunPyScriptFunc(bits,NodeId+'' ''+e.EventType);'
  +#13#10'    bits.Free;'#13#10'{$ifndef JScript}'#13#10'    if e<>nil then'#13
  +#10'      e.ReturnString:=GetEFromPythonFunc();'#13#10'{$endif}'#13#10'  end'
  +';'#13#10'end;'#13#10#13#10'procedure ExecuteEventHandler(e:TEventStatus;Nod'
  +'eId: String; myValue: String; initfunc,mainfunc:THandler;InitPyCode,MainPyC'
  +'ode:String);'#13#10'var'#13#10'  asyncWaiting:boolean;'#13#10'begin'#13#10
  +'  asyncWaiting := false;'#13#10'  if (e<>nil) then'#13#10'    asyncWaiting '
  +':= e.EventHasWaitingAsyncProcs;'#13#10'  {$ifndef JScript}'#13#10'  EventsN'
  +'ameSpace:=PChar(e.NameSpace);'#13#10'  {$else}'#13#10'  //asm console.log('
  +'''ExecuteEventHandler code:''+InitPyCode+MainPyCode); end;'#13#10'  EventsN'
  +'ameSpace:=e.NameSpace;'#13#10'  {$endif}'#13#10'  if ((e=nil) or (e.InitDon'
  +'e=false))'#13#10'  and (not asyncWaiting) then'#13#10'  begin'#13#10'    if'
  +' (e=nil) then'#13#10'    begin'#13#10'      e:=TEventStatus.Create(e.eventT'
  +'ype,NodeId);'#13#10'      e.NameSpace:='''';'#13#10'    end;'#13#10'    e.I'
  +'nitRunning:=true;'#13#10'    e.InitDone:=true;'#13#10'    RunTheEventFunc(e'
  +',NodeId,myValue,initfunc,InitPyCode);'#13#10'    e.InitRunning:=false;'#13
  +#10'  end;'#13#10'  if e.AsyncProcsRunning.Count = 1 then'#13#10'    e.Clear'
  +'Async(''ShowBusy'');'#13#10'  if e.EventHasWaitingAsyncProcs = false then'
  +#13#10'  begin'#13#10'    {$ifndef JScript}'#13#10'    RunTheEventFunc(e,Nod'
  +'eId,myValue,mainfunc,MainPyCode);'#13#10'    {$else}'#13#10'    if (e.event'
  +'Type = ''DropAccepted'')'#13#10'    or (e.eventType = ''DragStart'') then'
  +#13#10'      RunTheEventFunc(e,NodeId,myValue,mainfunc,MainPyCode)    // mus'
  +'t do these synchronously'#13#10'    else'#13#10'    begin'#13#10'      /// '
  ,'timeout/job-queue so that any changes made in the ''init'' secton will be r'
  +'efreshed on screen'#13#10'      if mainfunc<>nil then'#13#10'      begin'#13
  +#10'        asm'#13#10'        console.log(''timeout for main (pascal events'
  +')...'');'#13#10'        myTimeout(mainfunc,5,''Event Main'',0,e,NodeId,myVa'
  +'lue,MainPyCode);'#13#10'        end;'#13#10'      end'#13#10'      else'#13
  +#10'      begin'#13#10'        asm'#13#10'        console.log(''timeout for '
  +'main (python events)...'');'#13#10'        myTimeout(pas.Events.RunTheEvent'
  +'Func,5,''Event Main'',0,e,NodeId,myValue,null,MainPyCode);'#13#10'        e'
  +'nd;'#13#10'      end;'#13#10'    end;'#13#10'    {$endif}'#13#10'  end;'#13
  +#10'end;'#13#10#13#10#13#10'//=============================================='
  +'========================================================'#13#10'//========='
  +'===================================  End of Common Events Code ============'
  +'===================='#13#10'//============================================='
  +'========================================================='#13#10'Begin'#13
  +#10'  ExecuteEventHandlerFunc:=@ExecuteEventHandler;'#13#10' {$ifndef JScrip'
  +'t}'#13#10'  EventCode := TEventClass.Create;'#13#10'{$endif}'#13#10#13#10'e'
  +'nd.'#13#10
]);
LazarusResources.Add('eventsinterface','PAS',[
  '(*'#13#10'    Copyright (c) 2018  Steve Wright'#13#10#13#10'    This unit is'
  +' part of the XComponents package.'#13#10#13#10'    This package is distribu'
  +'ted in the hope that it will be useful,'#13#10'    but WITHOUT ANY WARRANTY'
  +'; without even the implied warranty of'#13#10'    MERCHANTABILITY or FITNES'
  +'S FOR A PARTICULAR PURPOSE.'#13#10#13#10' *********************************'
  +'*************************************'#13#10' *)'#13#10'unit EventsInterfac'
  +'e;'#13#10#13#10'{$ifndef JScript}'#13#10'{$mode objfpc}{$H+}'#13#10'{$endif'
  +'}'#13#10#13#10'interface'#13#10#13#10'uses'#13#10'  Classes, SysUtils, Math'
  +';'#13#10#13#10'type TNumArray = Array of real;'#13#10'type TStringArray = A'
  +'rray of String;'#13#10'type T2DNumArray = Array of TNumArray;'#13#10'type T'
  +'3DNumArray = Array of T2DNumArray;'#13#10'type T2DStringArray = Array of TS'
  +'tringArray;'#13#10'type TObjArray = Array of TObject;'#13#10#13#10'type TEv'
  +'entStatus = class(TObject)'#13#10'public'#13#10'  EventType:String;'#13#10
  +'  NodeId:String;'#13#10'  NameSpace:String;'#13#10'  InitRunning:Boolean;  '
  +'         // true for an event that is running (or has run) the initialisati'
  +'on phase, but not yet the main phase.'#13#10'  InitDone:Boolean;'#13#10'  A'
  +'syncProcsRunning:TStringList; // list of async procs fired off during the i'
  +'nitialisation phase.'#13#10'  ContinueAfterTrappers:Boolean; // is true unl'
  +'ess the event was intercepted by a trapper, and stopped.'#13#10'  ReturnStr'
  +'ing:String;           // used by TXThreads, and also for completion stage o'
  +'f async events (eg. in copyfromclip)'#13#10'  eventValue:String;           '
  +'  // to carry original event value, eg. for trapper events'#13#10'  //Value'
  +'Object:TObject;'#13#10'  // used in tree node operations, eg. drag/drop'#13
  +#10'  SourceName,SrcText,DstText:String;'#13#10'  myTreeNode:TObject;'#13#10
  +'  constructor Create(EvType,NdId:String);'#13#10'  function EventHasWaiting'
  +'AsyncProcs():Boolean;'#13#10'  function ClearAsync(ProcName:string):Boolean'
  +';'#13#10'end;'#13#10#13#10'//type TNodeEventValue = class(TObject)'#13#10'/'
  +'/  //myTree:TObject;'#13#10'//  SourceName,SrcText,DstText:String;'#13#10'/'
  +'/  //myNode:TObject;'#13#10'//end;'#13#10#13#10'type'#13#10'  TGPUPixelArra'
  +'y    = array of array of T2DNumArray ;'#13#10#13#10'type TDSKeyValue = reco'
  +'rd'#13#10'  DSKeyType:String;   // ''I'',''F'',''S'''#13#10'  DSKeyInt:inte'
  +'ger;'#13#10'  DSKeyFloat:double;'#13#10'  DSKeyString:String;'#13#10'end;'
  +#13#10'type TDSKeyArray = array of TDSKeyValue;'#13#10#13#10#13#10'var'#13#10
  +'  glbEvent:TEventStatus;'#13#10'  {$ifndef JScript}'#13#10'  EventsNameSpac'
  +'e:PChar;'#13#10'  {$else}'#13#10'  EventsNameSpace:String;'#13#10'  {$endif'
  +'}'#13#10#13#10'type THandler = procedure(e:TEventStatus;NodeId:String;myVal'
  +'ue:String);'#13#10'type TExEvHandler = procedure(e:TEventStatus;NodeId: Str'
  +'ing; myValue: String; initfunc,mainfunc:THandler;InitPyCode,MainPyCode:Stri'
  +'ng);'#13#10'type TRunPyFunc = function(PyScriptCode:TStringList;nm:String):'
  +'Boolean;'#13#10'type TEFunc = procedure(e:TEventStatus);'#13#10'type TEFunc'
  +'NoArgs = function():String;'#13#10'var'#13#10'  RunPyScriptFunc:TRunPyFunc;'
  +#13#10'  PassEToPythonFunc:TEFunc;'#13#10'  GetEFromPythonFunc:TEFuncNoArgs;'
  +#13#10'  ExecuteEventHandlerFunc:TExEvHandler;'#13#10#13#10'implementation'
  +#13#10#13#10'constructor TEventStatus.Create(EvType,NdId:String);'#13#10'beg'
  +'in'#13#10'  self.InitRunning:=false;'#13#10'  self.InitDone:=false;'#13#10
  +'  self.ContinueAfterTrappers:=true;'#13#10'  self.EventType:=EvType;'#13#10
  +'  self.NodeId:=NdId;'#13#10'  self.AsyncProcsRunning:=TStringList.Create;'
  +#13#10'//  self.ValueObject:=nil;'#13#10'  self.myTreeNode:=nil;'#13#10'  se'
  +'lf.SourceName:='''';'#13#10'  self.DstText:='''';'#13#10'  self.SrcText:='''
  +''';'#13#10'//  setlength(self.AsyncReturnObject,0);'#13#10'end;'#13#10#13#10
  +'function TEventStatus.EventHasWaitingAsyncProcs():Boolean;'#13#10'begin'#13
  +#10'  if self.AsyncProcsRunning.Count > 0 then'#13#10'    result:=true'#13#10
  +'  else'#13#10'    result:=false;'#13#10'end;'#13#10'function TEventStatus.C'
  +'learAsync(ProcName:string):Boolean;'#13#10'// remove a async job name from '
  +'the list in this event record.'#13#10'var'#13#10'  i:integer;'#13#10'begin'
  +#13#10'  result:=false;'#13#10'  i:=self.AsyncProcsRunning.IndexOf(ProcName)'
  +';'#13#10'  if i>-1 then'#13#10'  begin'#13#10'    self.AsyncProcsRunning.De'
  +'lete(i);'#13#10'    result:=true;'#13#10'  end;'#13#10'end;'#13#10#13#10'be'
  +'gin'#13#10'  {$ifndef JScript}'#13#10'  EventsNameSpace:=PChar('''');'#13#10
  +'  {$else}'#13#10'  EventsNameSpace:='''';'#13#10'  {$endif}'#13#10#13#10#13
  +#10'end.'#13#10#13#10
]);
