  +'lse).AttribValue;'#13#10#13#10'          SourcedAttribs[i].InProgress:=true'
  +';     //prevent circular updates'#13#10#13#10'          if SourcedAttribs[i'
  +'].SourceNode<>nil then'#13#10'          begin'#13#10'            SourceNode'
