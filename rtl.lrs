  ,' vR: Integer;'#13#10#13#10'begin'#13#10'  //if ExchangeItems is override ca'
  +'ll that, else call (faster) ExchangeItemsInt'#13#10#13#10'  if R - L <= 1 t'
  +'hen begin // a little bit of time saver'#13#10'    if L < R then'#13#10'   '
  +'   if CompareFn(Self, L, R) > 0 then'#13#10'        ExchangeItems(L, R);'#13
  +#10#13#10'    Exit;'#13#10'  end;'#13#10#13#10'  vL := L;'#13#10'  vR := R;'
  +#13#10#13#10'  Pivot := L + Random(R - L); // they say random is best'#13#10
  +#13#10'  while vL < vR do begin'#13#10'    while (vL < Pivot) and (CompareFn'
  +'(Self, vL, Pivot) <= 0) do'#13#10'      Inc(vL);'#13#10#13#10'    while (vR'
  +' > Pivot) and (CompareFn(Self, vR, Pivot) > 0) do'#13#10'      Dec(vR);'#13
  +#10#13#10'    ExchangeItems(vL, vR);'#13#10#13#10'    if Pivot = vL then // '
