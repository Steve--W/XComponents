  +#10'function Dec2Numb(N: Longint; Len, Base: Byte): string;'#13#10#13#10'var'
  +#13#10'  C: Integer;'#13#10'  Number: Longint;'#13#10#13#10'begin'#13#10'  i'
  +'f N=0 then'#13#10'    Result:=''0'''#13#10'  else'#13#10'    begin'#13#10' '
  +'   Number:=N;'#13#10'    Result:='''';'#13#10'    while Number>0 do'#13#10
  +'      begin'#13#10'      C:=Number mod Base;'#13#10'      if C>9 then'#13#10
  +'        C:=C+55'#13#10'      else'#13#10'        C:=C+48;'#13#10'      Resu'
  +'lt:=Chr(C)+Result;'#13#10'      Number:=Number div Base;'#13#10'      end;'
  +#13#10'    end;'#13#10'  if (Result<>'''') then'#13#10'    Result:=AddChar('
  +'''0'',Result,Len);'#13#10'end;'#13#10#13#10'function Numb2Dec(S: string; Ba'
  +'se: Byte): Longint;'#13#10#13#10'var'#13#10'  i, P: sizeint;'#13#10#13#10'b'
  +'egin'#13#10'  i:=Length(S);'#13#10'  Result:=0;'#13#10'  S:=UpperCase(S);'
  +#13#10'  P:=1;'#13#10'  while (i>=1) do'#13#10'    begin'#13#10'    if (S[i]'
  +'>''@'') then'#13#10'      Result:=Result+(Ord(S[i])-55)*P'#13#10'    else'
  +#13#10'      Result:=Result+(Ord(S[i])-48)*P;'#13#10'    Dec(i);'#13#10'    '
  +'P:=P*Base;'#13#10'    end;'#13#10'end;'#13#10#13#10'Function RomanValues(C '
  +': Char) : Word;'#13#10#13#10'begin'#13#10'  Case c of'#13#10'    ''C'' : Re'
  +'sult:=100;'#13#10'    ''D'' : Result:=500;'#13#10'    ''I'' : Result:=1;'#13
  +#10'    ''L'' : Result:=50;'#13#10'    ''M'' : Result:=1000;'#13#10'    ''V'
  +''' : Result:=5;'#13#10'    ''X'' : Result:=10;'#13#10'  else'#13#10'    Res'
  +'ult:=0;'#13#10'  end;'#13#10'end;'#13#10#13#10'function RomanToIntDontCare('
  +'const S: String): Longint;'#13#10'{This was the original implementation of '
  ,'RomanToInt,'#13#10' it is internally used in TryRomanToInt when Strictness '
  +'= rcsDontCare}'#13#10'const'#13#10'  RomanChars  = [''C'',''D'',''I'',''L'''
  +',''M'',''V'',''X''];'#13#10#13#10'var'#13#10'  index, Next: Char;'#13#10'  '
  +'i,l: SizeInt;'#13#10'  Negative: Boolean;'#13#10#13#10'begin'#13#10'  Resul'
  +'t:=0;'#13#10'  i:=0;'#13#10'  Negative:=(Length(S)>0) and (S[1]=''-'');'#13
  +#10'  if Negative then'#13#10'    inc(i);'#13#10'  l:=Length(S);'#13#10'  wh'
  +'ile (i<l) do'#13#10'    begin'#13#10'    inc(i);'#13#10'    index:=UpCase(S'
  +'[i]);'#13#10'    if index in RomanChars then'#13#10'      begin'#13#10'    '
  +'  if (i+1)<=l then'#13#10'        Next:=UpCase(S[i+1])'#13#10'      else'#13
  +#10'        Next:=#0;'#13#10'      if (Next in RomanChars) and (RomanValues('
  +'index)<RomanValues(Next)) then'#13#10'        begin'#13#10'        inc(Resu'
  +'lt, RomanValues(Next));'#13#10'        Dec(Result, RomanValues(index));'#13
  +#10'        inc(i);'#13#10'        end'#13#10'      else'#13#10'        inc('
  +'Result, RomanValues(index));'#13#10'      end'#13#10'    else'#13#10'      '
  +'begin'#13#10'      Result:=0;'#13#10'      Exit;'#13#10'      end;'#13#10' '
  +'   end;'#13#10'  if Negative then'#13#10'    Result:=-Result;'#13#10'end;'
  +#13#10#13#10#13#10'{ TryRomanToInt: try to convert a roman numeral to an int'
  +'eger'#13#10'  Parameters:'#13#10'  S: Roman numeral (like: ''MCMXXII'')'#13
  +#10'  N: Integer value of S (only meaningfull if the function succeeds)'#13
  +#10'  Stricness: controls how strict the parsing of S is'#13#10'    - rcsStr'
  +'ict:'#13#10'      * Follow common subtraction rules'#13#10'         - only '
  +'1 preceding subtraction character allowed: IX = 9, but IIX <> 8'#13#10'    '
  +'     - from M you can only subtract C'#13#10'         - from D you can only'
  +' subtract C'#13#10'         - from C you can only subtract X'#13#10'       '
  +'  - from L you can only subtract X'#13#10'         - from X you can only su'
  +'btract I'#13#10'         - from V you can only subtract I'#13#10'      *  T'
  +'he numeral is parsed in "groups" (first M''s, then D''s etc.), the next gro'
  +'up to be parsed'#13#10'         must always be of a lower denomination than'
  +' the previous one.'#13#10'         Example: ''MMDCCXX'' is allowed but ''MM'
  +'CCXXDD'' is not'#13#10'      * There can only ever be 3 consecutive M''s, C'
  +'''s, X''s or I''s'#13#10'      * There can only ever be 1 D, 1 L and 1 V'#13
  +#10'      * After IX or IV there can be no more characters'#13#10'      * Ne'
  +'gative numbers are not supported'#13#10'      // As a consequence the maxim'
  +'um allowed Roman numeral is MMMCMXCIX = 3999, also N can never become 0 (ze'
  +'ro)'#13#10#13#10'    - rcsRelaxed: Like rcsStrict but with the following ex'
  +'ceptions:'#13#10'      * An infinite number of (leading) M''s is allowed'#13
  +#10'      * Up to 4 consecutive M''s, C''s, X''s and I''s are allowed'#13#10
  +'      // So this is allowed: ''MMMMMMCXIIII''  = 6124'#13#10#13#10'    - rc'
  +'sDontCare:'#13#10'      * no checking on the order of "groups" is done'#13
  +#10'      * there are no restrictions on the number of consecutive chars'#13
  +#10'      * negative numbers are supported'#13#10'      * an empty string as'
  +' input will return True and N will be 0'#13#10'      * invalid input will r'
  +'eturn false'#13#10'      // for backwards comatibility: it supports rather '
  +'ludicrous input like ''-IIIMIII'' -> -(2+(1000-1)+3)=-1004'#13#10'}'#13#10
  +#13#10'function TryRomanToInt(S: String; out N: LongInt; Strictness: TRomanC'
  +'onversionStrictness = rcsRelaxed): Boolean;'#13#10#13#10'var'#13#10'  i, Le'
  +'n: SizeInt;'#13#10'  Terminated: Boolean;'#13#10#13#10'begin'#13#10'  Resul'
  +'t := (False);'#13#10'  S := UpperCase(S);  //don''t use AnsiUpperCase pleas'
  +'e'#13#10'  Len := Length(S);'#13#10'  if (Strictness = rcsDontCare) then'#13
  +#10'  begin'#13#10'    N := RomanToIntDontCare(S);'#13#10'    if (N = 0) the'
  +'n'#13#10'    begin'#13#10'      Result := (Len = 0);'#13#10'    end'#13#10
  +'    else'#13#10'      Result := True;'#13#10'    Exit;'#13#10'  end;'#13#10
  +'  if (Len = 0) then Exit;'#13#10'  i := 1;'#13#10'  N := 0;'#13#10'  Termin'
  +'ated := False;'#13#10'  //leading M''s'#13#10'  while (i <= Len) and ((Stri'
  +'ctness <> rcsStrict) or (i < 4)) and (S[i] = ''M'') do'#13#10'  begin'#13#10
  +'    //writeln(''TryRomanToInt: Found 1000'');'#13#10'    Inc(i);'#13#10'   '
  +' N := N + 1000;'#13#10'  end;'#13#10'  //then CM or or CD or D or (C, CC, C'
  +'CC, CCCC)'#13#10'  if (i <= Len) and (S[i] = ''D'') then'#13#10'  begin'#13
  +#10'    //writeln(''TryRomanToInt: Found 500'');'#13#10'    Inc(i);'#13#10' '
  +'   N := N + 500;'#13#10'  end'#13#10'  else if (i + 1 <= Len) and (S[i] = '
  +'''C'') then'#13#10'  begin'#13#10'    if (S[i+1] = ''M'') then'#13#10'    b'
  +'egin'#13#10'      //writeln(''TryRomanToInt: Found 900'');'#13#10'      Inc'
  +'(i,2);'#13#10'      N := N + 900;'#13#10'    end'#13#10'    else if (S[i+1]'
  +' = ''D'') then'#13#10'    begin'#13#10'      //writeln(''TryRomanToInt: Fou'
  ,'nd 400'');'#13#10'      Inc(i,2);'#13#10'      N := N + 400;'#13#10'    end'
  +';'#13#10'  end ;'#13#10'  //next max 4 or 3 C''s, depending on Strictness'
  +#13#10'  if (i <= Len) and (S[i] = ''C'') then'#13#10'  begin'#13#10'    //f'
  +'ind max 4 C''s'#13#10'    //writeln(''TryRomanToInt: Found 100'');'#13#10' '
  +'   Inc(i);'#13#10'    N := N + 100;'#13#10'    if (i <= Len) and (S[i] = '''
  +'C'') then'#13#10'    begin'#13#10'      //writeln(''TryRomanToInt: Found 10'
  +'0'');'#13#10'      Inc(i);'#13#10'      N := N + 100;'#13#10'    end;'#13#10
  +'    if (i <= Len) and (S[i] = ''C'') then'#13#10'    begin'#13#10'      //w'
  +'riteln(''TryRomanToInt: Found 100'');'#13#10'      Inc(i);'#13#10'      N :'
  +'= N + 100;'#13#10'    end;'#13#10'    if (Strictness <> rcsStrict) and (i <'
  +'= Len) and (S[i] = ''C'') then'#13#10'    begin'#13#10'      //writeln(''Tr'
  +'yRomanToInt: Found 100'');'#13#10'      Inc(i);'#13#10'      N := N + 100;'
  +#13#10'    end;'#13#10'  end;'#13#10#13#10'  //then XC or XL'#13#10'  if (i '
  +'+ 1 <= Len) and (S[i] = ''X'') then'#13#10'  begin'#13#10'    if (S[i+1] = '
  +'''C'') then'#13#10'    begin'#13#10'      //writeln(''TryRomanToInt: Found '
  +'90'');'#13#10'      Inc(i,2);'#13#10'      N := N + 90;'#13#10'    end'#13
  +#10'    else if  (S[i+1] = ''L'') then'#13#10'    begin'#13#10'      //write'
  +'ln(''TryRomanToInt: Found 40'');'#13#10'      Inc(i,2);'#13#10'      N := N'
  +' + 40;'#13#10'    end;'#13#10'  end;'#13#10#13#10'  //then L'#13#10'  if (i'
  +' <= Len) and (S[i] = ''L'') then'#13#10'  begin'#13#10'    //writeln(''TryR'
  +'omanToInt: Found 50'');'#13#10'    Inc(i);'#13#10'    N := N + 50;'#13#10' '
  +' end;'#13#10#13#10'  //then (X, xx, xxx, xxxx)'#13#10'  if (i <= Len) and ('
  +'S[i] = ''X'') then'#13#10'  begin'#13#10'    //find max 3 or 4 X''s, depend'
  +'ing on Strictness'#13#10'    //writeln(''TryRomanToInt: Found 10'');'#13#10
  +'    Inc(i);'#13#10'    N := N + 10;'#13#10'    if (i <= Len) and (S[i] = '''
  +'X'') then'#13#10'    begin'#13#10'      //writeln(''TryRomanToInt: Found 10'
  +''');'#13#10'      Inc(i);'#13#10'      N := N + 10;'#13#10'    end;'#13#10
  +'    if (i <= Len) and (S[i] = ''X'') then'#13#10'    begin'#13#10'      //w'
  +'riteln(''TryRomanToInt: Found 10'');'#13#10'      Inc(i);'#13#10'      N :='
  +' N + 10;'#13#10'    end;'#13#10'    if (Strictness <> rcsStrict) and (i <= '
  +'Len) and (S[i] = ''X'') then'#13#10'    begin'#13#10'      //writeln(''TryR'
  +'omanToInt: Found 10'');'#13#10'      Inc(i);'#13#10'      N := N + 10;'#13
  +#10'    end;'#13#10'  end;'#13#10#13#10'  //then IX or IV'#13#10'  if (i + 1'
  +' <= Len) and (S[i] = ''I'') then'#13#10'  begin'#13#10'    if (S[i+1] = ''X'
  +''') then'#13#10'    begin'#13#10'      Terminated := (True);'#13#10'      /'
  +'/writeln(''TryRomanToInt: Found 9'');'#13#10'      Inc(i,2);'#13#10'      N'
  +' := N + 9;'#13#10'    end'#13#10'    else if (S[i+1] = ''V'') then'#13#10' '
  +'   begin'#13#10'      Terminated := (True);'#13#10'      //writeln(''TryRom'
  +'anToInt: Found 4'');'#13#10'      Inc(i,2);'#13#10'      N := N + 4;'#13#10
  +'    end;'#13#10'  end;'#13#10#13#10'  //then V'#13#10'  if (not Terminated)'
  +' and (i <= Len) and (S[i] = ''V'') then'#13#10'  begin'#13#10'    //writeln'
  +'(''TryRomanToInt: Found 5'');'#13#10'    Inc(i);'#13#10'    N := N + 5;'#13
  +#10'  end;'#13#10#13#10#13#10'  //then I'#13#10'  if (not Terminated) and (i'
  +' <= Len) and (S[i] = ''I'') then'#13#10'  begin'#13#10'    Terminated := (T'
  +'rue);'#13#10'    //writeln(''TryRomanToInt: Found 1'');'#13#10'    Inc(i);'
  +#13#10'    N := N + 1;'#13#10'    //Find max 2 or 3 closing I''s, depending '
  +'on strictness'#13#10'    if (i <= Len) and (S[i] = ''I'') then'#13#10'    b'
