  +#10'    Done:=false;'#13#10'    iteration:=iteration+1;'#13#10'    if iterat'
  +'ion<50 then          // fail-safe?'#13#10'    while Done=false do'#13#10'  '
  +'  begin'#13#10'      Done:=true;'#13#10'      for i:=0 to length(SourcedAtt'
  +'ribs)-1 do'#13#10'      begin'#13#10'        begin'#13#10'          //Sourc'
  +'edAttribs[i] is the attribute which contains a source reference'#13#10'    '
