  +'hen'#13#10'    if (abs(X)<0.5) then'#13#10'      repeat'#13#10'        X:=X'
  +'*2;'#13#10'        Dec(Exponent);'#13#10'      until (abs(X)>=0.5)'#13#10' '
  +'   else'#13#10'      while (abs(X)>=1) do'#13#10'        begin'#13#10'     '
  +'   X:=X/2;'#13#10'        Inc(Exponent);'#13#10'        end;'#13#10'  Manti'
  +'ssa:=X;'#13#10'end;'#13#10#13#10'function LogN(const A, Base: Double): Doub'
  +'le; '#13#10#13#10'begin'#13#10'  Result:=Ln(A)/Ln(Base);'#13#10'end;'#13#10
  +#13#10'function lnxp1(x: double): double;'#13#10#13#10'var'#13#10'  y: float'
  +';'#13#10#13#10'begin'#13#10'  if (x>=4.0) then'#13#10'    result:=ln(1.0+x)'
  +#13#10'  else'#13#10'    begin'#13#10'    y:=1.0+x;'#13#10'    if (y=1.0) th'
  +'en'#13#10'      result:=x'#13#10'    else'#13#10'      begin'#13#10'      r'
  +'esult:=ln(y);     { lnxp1(-1) = ln(0) = -Inf }'#13#10'      if y>0.0 then'
  +#13#10'        result:=result+(x-(y-1.0))/y;'#13#10'      end;'#13#10'    en'
  +'d;'#13#10'end;'#13#10#13#10'function ldexp(x : double;const p : Integer) : '
  +'double;'#13#10#13#10'begin'#13#10'   result:=x*intpower(2.0,p);'#13#10'end;'
  +#13#10#13#10#13#10'function IntPower(base: float; const exponent: Integer): '
  +'double;'#13#10#13#10'var'#13#10'  i : longint;'#13#10#13#10'begin'#13#10'  '
  ,'if (base = 0.0) and (exponent = 0) then'#13#10'    result:=1'#13#10'  else'
  +#13#10'    begin'#13#10'    i:=abs(exponent);'#13#10'    Result:=1.0;'#13#10
  +'    while i>0 do'#13#10'      begin'#13#10'      while (i and 1)=0 do'#13#10
  +'        begin'#13#10'        i:=i shr 1;'#13#10'        base:=sqr(base);'#13
  +#10'        end;'#13#10'      i:=i-1;'#13#10'      Result:=Result*base;'#13
  +#10'      end;'#13#10'    if exponent<0 then'#13#10'      Result:=1.0/Result'
  +';'#13#10'    end;'#13#10'end;'#13#10#13#10'procedure DivMod(Dividend: LongI'
  +'nt; Divisor: Word; out Result, Remainder: Word);'#13#10'begin'#13#10'  if D'
  +'ividend < 0 then'#13#10'    begin'#13#10'    Dividend:=-Dividend;'#13#10'  '
  +'  Result:=-(Dividend Div Divisor);'#13#10'    Remainder:=-(Dividend+(Result'
  +'*Divisor));'#13#10'    end'#13#10'  else'#13#10'    begin'#13#10'    Result'
  +':=Dividend Div Divisor;'#13#10'    Remainder:=Dividend-(Result*Divisor);'#13
  +#10'    end;'#13#10'end;'#13#10#13#10#13#10'procedure DivMod(Dividend: LongI'
  +'nt; Divisor: Word; out Result,'#13#10'  Remainder: SmallInt);'#13#10'begin'
  +#13#10'  if Dividend < 0 then'#13#10'    begin'#13#10'    Dividend:=-Dividen'
  +'d;'#13#10'    Result:=-(Dividend Div Divisor);'#13#10'    Remainder:=-(Divi'
  +'dend+(Result*Divisor));'#13#10'    end'#13#10'  else'#13#10'    begin'#13#10
  +'    Result:=Dividend Div Divisor;'#13#10'    Remainder:=Dividend-(Result*Di'
  +'visor);'#13#10'    end;'#13#10'end;'#13#10#13#10#13#10'procedure DivMod(Div'
  +'idend: DWord; Divisor: DWord; out Result, Remainder: DWord);'#13#10'begin'
  +#13#10'  Result:=Dividend Div Divisor;'#13#10'  Remainder:=Dividend-(Result*'
  +'Divisor);'#13#10'end;'#13#10#13#10#13#10'procedure DivMod(Dividend: LongInt'
  +'; Divisor: LongInt; out Result,'#13#10'  Remainder: LongInt);'#13#10#13#10
  +'begin'#13#10'  if Dividend < 0 then'#13#10'    begin'#13#10'    Dividend:=-'
  +'Dividend;'#13#10'    Result:=-(Dividend Div Divisor);'#13#10'    Remainder:'
  +'=-(Dividend+(Result*Divisor));'#13#10'    end'#13#10'  else'#13#10'    begi'
  +'n'#13#10'    Result:=Dividend Div Divisor;'#13#10'    Remainder:=Dividend-('
  +'Result*Divisor);'#13#10'    end;'#13#10'end;'#13#10#13#10'{ ---------------'
  +'------------------------------------------------------'#13#10'  Angle conve'
  +'rsion'#13#10'  ------------------------------------------------------------'
  +'---------}'#13#10'function DegToRad(deg: double): double;'#13#10#13#10'begi'
  +'n'#13#10'  Result:=deg*(pi/180.0);'#13#10'end;'#13#10#13#10#13#10'function '
  +'RadToDeg(rad: double): double;'#13#10#13#10'begin'#13#10'  Result:=rad*(180'
  +'.0/pi);'#13#10'end;'#13#10#13#10#13#10'function GradToRad(grad: double): do'
  +'uble;'#13#10#13#10'begin'#13#10'  Result:=grad*(pi/200.0);'#13#10'end;'#13
  +#10#13#10#13#10'function RadToGrad(rad: double): double;'#13#10#13#10'begin'
  +#13#10'  Result:=rad*(200.0/pi);'#13#10'end;'#13#10#13#10#13#10'function Deg'
  +'ToGrad(deg: double): double;'#13#10#13#10'begin'#13#10'  Result:=deg*(200.0'
  +'/180.0);'#13#10'end;'#13#10#13#10#13#10'function GradToDeg(grad: double): d'
  +'ouble;'#13#10#13#10'begin'#13#10'  Result:=grad*(180.0/200.0);'#13#10'end;'
  +#13#10#13#10#13#10'function CycleToRad(cycle: double): double;'#13#10#13#10
  +'begin'#13#10'  Result:=(2*pi)*cycle;'#13#10'end;'#13#10#13#10#13#10'functio'
  +'n RadToCycle(rad: double): double;'#13#10#13#10'begin'#13#10'  Result:=rad*'
  +'(1/(2*pi));'#13#10'end;'#13#10#13#10#13#10'function DegNormalize(deg: doubl'
  +'e): double;'#13#10#13#10'begin'#13#10'  Result:=Deg-Int(Deg/360)*360;'#13#10
  +'  If (Result<0) then Result:=Result+360;'#13#10'end;'#13#10#13#10'function '
  +'sumofsquares(const data : array of double) : double;'#13#10'var'#13#10'  i,'
  +'N : longint;'#13#10#13#10'begin'#13#10'  N:=Length(Data);'#13#10'  Result:='
  +'0.0;'#13#10'  for i:=0 to N-1 do'#13#10'    Result:=Result+sqr(data[i]);'#13
  +#10'end;'#13#10#13#10'function Norm(const data: array of double): double;'#13
  +#10'begin'#13#10'  Result:=sqrt(sumofsquares(data));'#13#10'end;'#13#10#13#10
  +'{ ---------------------------------------------------------------------'#13
  +#10'  Statistical functions'#13#10'  ---------------------------------------'
  +'------------------------------}'#13#10#13#10'function Sum(const data: array'
  +' of double): double;'#13#10#13#10'var'#13#10'  i,N : longint;'#13#10#13#10
  +'begin'#13#10'  N:=Length(Data);'#13#10'  Result:=0.0;'#13#10'  for i:=0 to '
  +'N-1 do'#13#10'    Result:=Result+data[i];'#13#10'end;'#13#10#13#10'function'
  +' Mean(const data: array of double): double;'#13#10#13#10'Var'#13#10'  N : i'
  +'nteger;'#13#10#13#10'begin'#13#10'  N:=Length(Data);'#13#10'  if N=0 then'
  +#13#10'    Result:=0'#13#10'  else'#13#10'    Result:=Sum(Data)/N;'#13#10'en'
  +'d;'#13#10'procedure SumsAndSquares(const data: array of Double; out Sum,'#13
  +#10'  SumOfSquares: double);'#13#10#13#10'var'#13#10'  i,n : Integer;'#13#10
  +'  t,s,ss: double;'#13#10#13#10'begin'#13#10'  n:=length(Data);'#13#10'  ss:'
  +'=0.0; // Use local vars, var is very inefficient in js'#13#10'  s:=0.0;'#13
  ,#10'  for i:=0 to N-1 do'#13#10'    begin'#13#10'    t:=data[i];'#13#10'    '
  +'ss:=ss+sqr(t);'#13#10'    s:=s+t;'#13#10'    end;'#13#10'  Sum:=s;'#13#10' '
  +' SumOfSquares:=ss;'#13#10'end;'#13#10#13#10'function StdDev(const data: arr'
  +'ay of Double): float;'#13#10#13#10'begin'#13#10'  Result:=Sqrt(Variance(Dat'
  +'a));'#13#10'end;'#13#10#13#10'function Variance(const data: array of Double'
  +'): double;'#13#10#13#10'var'#13#10'  n : integer;'#13#10#13#10'begin'#13#10
  +'  N:=Length(Data);'#13#10'  If N=1 then'#13#10'    Result:=0'#13#10'  else'
  +#13#10'    Result:=TotalVariance(Data)/(N-1);'#13#10'end;'#13#10#13#10'funct'
  +'ion TotalVariance(const data: array of Double): double;'#13#10#13#10'var'#13
  +#10'  S,SS : Float;'#13#10'  N : integer;'#13#10'begin'#13#10'  N:=Length(Da'
  +'ta);'#13#10'  If Length(Data)=1 then'#13#10'    Result:=0'#13#10'  else'#13
  +#10'    begin'#13#10'    SumsAndSquares(Data,S,SS);'#13#10'    Result := SS-'
  +'Sqr(S)/N;'#13#10'    end;'#13#10'end;'#13#10#13#10'procedure MeanAndStdDev('
  +'const data: array of Double; out Mean, StdDev: double);'#13#10#13#10'Var'#13
  +#10'  I,N : longint;'#13#10'  M,S : Double;'#13#10#13#10'begin'#13#10'  N:=L'
  +'ength(Data);'#13#10'  M:=0;'#13#10'  S:=0;'#13#10'  For I:=0 to N-1 do'#13
  +#10'    begin'#13#10'    M:=M+Data[i];'#13#10'    S:=S+Sqr(Data[i]);'#13#10
  +'    end;'#13#10'  M:=M/N;'#13#10'  S:=(S-N*Sqr(M));'#13#10'  If N>1 then'#13
  +#10'    S:=Sqrt(S/(N-1))'#13#10'  else'#13#10'    S:=0;'#13#10'  Mean:=M;'#13
  +#10'  StdDev:=S;'#13#10'end;'#13#10#13#10'function PopNStdDev(const data : a'
  +'rray of Double) : double;'#13#10#13#10'begin'#13#10'  Result:=Sqrt(PopnVari'
  +'ance(Data));'#13#10'end;'#13#10#13#10'function PopNVariance(const data : ar'
  +'ray of Double) : double;'#13#10#13#10'Var'#13#10'  N : integer;'#13#10#13#10
  +'begin'#13#10'  N:=Length(Data);'#13#10'  if N=0 then'#13#10'    Result:=0'
  +#13#10'  else'#13#10'    Result:=TotalVariance(Data)/N;'#13#10'end;'#13#10#13
  +#10'procedure MomentSkewKurtosis(const data: array of Double; out m1, m2, m3'
  +', m4, skew, kurtosis: double);'#13#10#13#10'var'#13#10'  i,N: integer;'#13
  +#10'  deviation, deviation2: double;'#13#10'  reciprocalN: float;'#13#10'  /'
  +'/ Use local vars for all calculations, var is very slow'#13#10'  lm1, lm2, '
  +'lm3, lm4, lskew, lkurtosis: double;'#13#10#13#10'begin'#13#10'  N:=length(D'
  +'ata);'#13#10'  lm1 := 0;'#13#10'  reciprocalN := 1/N;'#13#10'  for i := 0 t'
  +'o N-1 do'#13#10'    lm1 := lm1 + data[i];'#13#10'  lm1 := reciprocalN * lm1'
  +';'#13#10#13#10'  lm2 := 0;'#13#10'  lm3 := 0;'#13#10'  lm4 := 0;'#13#10'  f'
  +'or i := 0 to N-1 do'#13#10'    begin'#13#10'    deviation := (data[i]-lm1);'
  +#13#10'    deviation2 := deviation * deviation;'#13#10'    lm2 := lm2 + devi'
  +'ation2;'#13#10'    lm3 := lm3 + deviation2 * deviation;'#13#10'    lm4 := l'
  +'m4 + deviation2 * deviation2;'#13#10'    end;'#13#10'  lm2 := reciprocalN *'
  +' lm2;'#13#10'  lm3 := reciprocalN * lm3;'#13#10'  lm4 := reciprocalN * lm4;'
  +#13#10#13#10'  lskew := lm3 / (sqrt(lm2)*lm2);'#13#10'  lkurtosis := lm4 / ('
  +'lm2 * lm2);'#13#10#13#10'  m1:=lm1;'#13#10'  m2:=lm2;'#13#10'  m3:=lm3;'#13
  +#10'  m4:=lm4;'#13#10'  skew:=lskew;'#13#10'  kurtosis:=lkurtosis;'#13#10'en'
  +'d;'#13#10#13#10'{ ---------------------------------------------------------'
  +'------------'#13#10'  Financial functions'#13#10'  ------------------------'
  +'---------------------------------------------}'#13#10#13#10'function Future'
  +'Value(ARate: double; NPeriods: Integer;'#13#10'  APayment, APresentValue: d'
  +'ouble; APaymentTime: TPaymentTime): double;'#13#10'var'#13#10'  q, qn, fact'
  +'or: double;'#13#10'begin'#13#10'  if ARate = 0 then'#13#10'    Result := -A'
  +'PresentValue - APayment * NPeriods'#13#10'  else begin'#13#10'    q := 1.0 '
  +'+ ARate;'#13#10'    qn := power(q, NPeriods);'#13#10'    factor := (qn - 1)'
  +' / (q - 1);'#13#10'    if APaymentTime = ptStartOfPeriod then'#13#10'      '
  +'factor := factor * q;'#13#10'    Result := -(APresentValue * qn + APayment*'
  +'factor);'#13#10'  end;'#13#10'end;'#13#10#13#10'function InterestRate(NPeri'
  +'ods: Integer; APayment, APresentValue, AFutureValue: double;'#13#10'  APaym'
  +'entTime: TPaymentTime): double;'#13#10'{ The interest rate cannot be calcul'
  +'ated analytically. We solve the equation'#13#10'  numerically by means of t'
  +'he Newton method:'#13#10'  - guess value for the interest reate'#13#10'  - '
  +'calculate at which interest rate the tangent of the curve fv(rate)'#13#10' '
  +'   (straight line!) has the requested future vale.'#13#10'  - use this rate'
  +' for the next iteration. }'#13#10'const'#13#10'  DELTA = 0.001;'#13#10'  EP'
  +'S = 1E-9;   // required precision of interest rate (after typ. 6 iterations'
  +')'#13#10'  MAXIT = 20;   // max iteration count to protect agains non-conve'
  +'rgence'#13#10'var'#13#10'  r1, r2, dr: double;'#13#10'  fv1, fv2: double;'
  +#13#10'  iteration: Integer;'#13#10'begin'#13#10'  iteration := 0;'#13#10'  '
  +'r1 := 0.05;  // inital guess'#13#10'  repeat'#13#10'    r2 := r1 + DELTA;'
  ,#13#10'    fv1 := FutureValue(r1, NPeriods, APayment, APresentValue, APaymen'
  +'tTime);'#13#10'    fv2 := FutureValue(r2, NPeriods, APayment, APresentValue'
  +', APaymentTime);'#13#10'    dr := (AFutureValue - fv1) / (fv2 - fv1) * delt'
  +'a;  // tangent at fv(r)'#13#10'    r1 := r1 + dr;      // next guess'#13#10
  +'    inc(iteration);'#13#10'  until (abs(dr) < EPS) or (iteration >= MAXIT);'
  +#13#10'  Result := r1;'#13#10'end;'#13#10#13#10'function NumberOfPeriods(ARa'
  +'te, APayment, APresentValue, AFutureValue: double;'#13#10'  APaymentTime: T'
  +'PaymentTime): double;'#13#10'{ Solve the cash flow equation (1) for q^n and'
  +' take the logarithm }'#13#10'var'#13#10'  q, x1, x2: double;'#13#10'begin'
  +#13#10'  if ARate = 0 then'#13#10'    Result := -(APresentValue + AFutureVal'
  +'ue) / APayment'#13#10'  else begin'#13#10'    q := 1.0 + ARate;'#13#10'    '
  +'if APaymentTime = ptStartOfPeriod then'#13#10'      APayment := APayment * '
  +'q;'#13#10'    x1 := APayment - AFutureValue * ARate;'#13#10'    x2 := APaym'
  +'ent + APresentValue * ARate;'#13#10'    if   (x2 = 0)                    //'
  +' we have to divide by x2'#13#10'      or (sign(x1) * sign(x2) < 0)   // the'
  +' argument of the log is negative'#13#10'    then'#13#10'      Result := Inf'
  +'inity'#13#10'    else begin'#13#10'      Result := ln(x1/x2) / ln(q);'#13#10
  +'    end;'#13#10'  end;'#13#10'end;'#13#10#13#10'function Payment(ARate: dou'
  +'ble; NPeriods: Integer;'#13#10'  APresentValue, AFutureValue: double; APaym'
  +'entTime: TPaymentTime): double;'#13#10'var'#13#10'  q, qn, factor: double;'
  +#13#10'begin'#13#10'  if ARate = 0 then'#13#10'    Result := -(AFutureValue '
  +'+ APresentValue) / NPeriods'#13#10'  else begin'#13#10'    q := 1.0 + ARate'
  +';'#13#10'    qn := power(q, NPeriods);'#13#10'    factor := (qn - 1) / (q -'
  +' 1);'#13#10'    if APaymentTime = ptStartOfPeriod then'#13#10'      factor '
  +':= factor * q;'#13#10'    Result := -(AFutureValue + APresentValue * qn) / '
  +'factor;'#13#10'  end;'#13#10'end;'#13#10#13#10'function PresentValue(ARate:'
  +' double; NPeriods: Integer;'#13#10'  APayment, AFutureValue: double; APayme'
  +'ntTime: TPaymentTime): double;'#13#10'var'#13#10'  q, qn, factor: double;'
  +#13#10'begin'#13#10'  if ARate = 0.0 then'#13#10'    Result := -AFutureValue'
  +' - APayment * NPeriods'#13#10'  else begin'#13#10'    q := 1.0 + ARate;'#13
  +#10'    qn := power(q, NPeriods);'#13#10'    factor := (qn - 1) / (q - 1);'
  +#13#10'    if APaymentTime = ptStartOfPeriod then'#13#10'      factor := fac'
  +'tor * q;'#13#10'    Result := -(AFutureValue + APayment*factor) / qn;'#13#10
  +'  end;'#13#10'end;'#13#10#13#10'{ -----------------------------------------'
  +'----------------------------'#13#10'  Miscellaneous'#13#10'  --------------'
  +'-------------------------------------------------------}'#13#10#13#10'funct'
  +'ion IfThen(val: boolean; const ifTrue: integer; const ifFalse: integer): in'
  +'teger;'#13#10#13#10'begin'#13#10'  if val then result:=iftrue else result:='
  +'iffalse;'#13#10'end;'#13#10#13#10'function IfThen(val: boolean; const ifTru'
  +'e: double; const ifFalse: double): double;'#13#10#13#10'begin'#13#10'  if v'
  +'al then result:=iftrue else result:=iffalse;'#13#10'end;'#13#10#13#10'funct'
  +'ion CompareValue(const A, B  : Integer): TValueRelationship;'#13#10#13#10'b'
  +'egin'#13#10'  result:=GreaterThanValue;'#13#10'  if a=b then'#13#10'    res'
  +'ult:=EqualsValue'#13#10'  else'#13#10'   if a<b then'#13#10'     result:=Le'
  +'ssThanValue;'#13#10'end;'#13#10#13#10'function CompareValue(const A, B: Nat'
  +'iveLargeInt): TValueRelationship;'#13#10#13#10'begin'#13#10'  result:=Great'
  +'erThanValue;'#13#10'  if a=b then'#13#10'    result:=EqualsValue'#13#10'  e'
  +'lse'#13#10'   if a<b then'#13#10'     result:=LessThanValue;'#13#10'end;'#13
  +#10#13#10'function CompareValue(const A, B: NativeLargeUInt): TValueRelation'
  +'ship;'#13#10#13#10'begin'#13#10'  result:=GreaterThanValue;'#13#10'  if a=b'
  +' then'#13#10'    result:=EqualsValue'#13#10'  else'#13#10'   if a<b then'#13
  +#10'     result:=LessThanValue;'#13#10'end;'#13#10#13#10'function CompareVal'
  +'ue(const A, B: Double; delta: Double): TValueRelationship;'#13#10'begin'#13
  +#10'  result:=GreaterThanValue;'#13#10'  if abs(a-b)<=delta then'#13#10'    '
  +'result:=EqualsValue'#13#10'  else'#13#10'   if a<b then'#13#10'     result:'
  +'=LessThanValue;'#13#10'end;'#13#10#13#10'end.'#13#10#13#10
]);
