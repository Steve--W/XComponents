  +'tion: integer): string;'#13#10'var'#13#10'  StartPos: Integer;'#13#10'begin'
  +#13#10'  StartPos:=Position;'#13#10'  while (Position<=length(List)) and (Li'
  +'st[Position]<>Delimiter) do'#13#10'    inc(Position);'#13#10'  Result:=copy'
  +'(List,StartPos,Position-StartPos);'#13#10'  if Position<=length(List) then '
  +'inc(Position); // skip Delimiter'#13#10'end;'#13#10#13#10#13#10'procedure I'
  +'ncreaseChangeStamp(var Stamp: TChangeStamp);'#13#10'begin'#13#10'  if Stamp'
  +'<High(TChangeStamp) then'#13#10'    inc(Stamp)'#13#10'  else'#13#10'    Sta'
  +'mp:=InvalidChangeStamp+1;'#13#10'end;'#13#10#13#10'function IsNonUTF8System'
