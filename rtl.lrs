  +': Boolean;'#13#10'begin'#13#10'  Result := Pos(ASubText,AText)>0;'#13#10'en'
  +'d;'#13#10#13#10#13#10'Function AnsiStartsStr(const ASubText, AText: string)'
  +': Boolean;'#13#10'begin'#13#10'  if (Length(AText) >= Length(ASubText)) and'
  +' (ASubText <> '''') then'#13#10'    Result := (ASubText=Copy(aText,1,Length'
  +'(ASubtext)))'#13#10'  else'#13#10'    Result := False;'#13#10'end;'#13#10#13
  +#10#13#10'Function AnsiEndsStr(const ASubText, AText: string): Boolean;'#13
