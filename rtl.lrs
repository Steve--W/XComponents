  +'-----------------------------'#13#10'    Start/End of year functions.'#13#10
  +'  ---------------------------------------------------------------------}'#13
  +#10#13#10#13#10'Function StartOfTheYear(const AValue: TDateTime): TDateTime;'
  +#13#10'begin'#13#10'  Result:=EncodeDate(YearOf(AValue),1,1);'#13#10'end;'#13
  +#10#13#10#13#10'Function EndOfTheYear(const AValue: TDateTime): TDateTime;'
  +#13#10'begin'#13#10'  Result:=EncodeDateTime(YearOf(AValue),12,31,23,59,59,9'
  +'99);'#13#10'end;'#13#10#13#10#13#10'Function StartOfAYear(const AYear: Word'
  +'): TDateTime;'#13#10'begin'#13#10'  Result:=EncodeDate(AYear,1,1);'#13#10'e'
  +'nd;'#13#10#13#10#13#10'Function EndOfAYear(const AYear: Word): TDateTime;'
  +#13#10#13#10'begin'#13#10'  Result:=(EncodeDateTime(AYear,12,31,23,59,59,999'
  +'));'#13#10'end;'#13#10#13#10'{ --------------------------------------------'
  +'-------------------------'#13#10'    Start/End of month functions.'#13#10' '
  +' ---------------------------------------------------------------------}'#13
  +#10#13#10'Function StartOfTheMonth(const AValue: TDateTime): TDateTime;'#13
  +#10#13#10'Var'#13#10'  Y,M,D : Word;'#13#10#13#10'begin'#13#10'  DecodeDate('
