  +'ata as TPasProcedureScope;'#13#10'        case MsgType of'#13#10'        mt'
  +'Hint: if not (bsHints in ProcScope.BoolSwitches) then exit;'#13#10'        '
  ,'mtNote: if not (bsNotes in ProcScope.BoolSwitches) then exit;'#13#10'      '
