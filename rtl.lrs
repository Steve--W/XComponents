  +'e (XIDE project)'#13#10'  // record:  TSourcedAttrib'#13#10#13#10'  // look'
  +' for circular references...'#13#10'  for i:=0 to length(SourcedAttribs)-1 d'
  +'o'#13#10'  begin'#13#10'    if SelfRefFound(SourcedAttribs[i].TheAttribute)'
  +' then'#13#10'    begin'#13#10'      showmessage(''There is a circular refer'
  +'ence in sourced attributes'');'#13#10'      EXIT;'#13#10'    end;'#13#10'  '
  +'end;'#13#10#13#10'  iteration:=0;'#13#10'  if length(SourcedAttribs)>0 then'
