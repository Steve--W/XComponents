  +'        end;'#13#10'        break;'#13#10'        end'#13#10'      else if '
  +'El is TPasModule then'#13#10'        begin'#13#10'        ModScope:=TPasMod'
  +'ule(El).CustomData as TPasModuleScope;'#13#10'        case MsgType of'#13#10
  +'        mtHint: if not (bsHints in ModScope.BoolSwitches) then exit;'#13#10
  +'        mtNote: if not (bsNotes in ModScope.BoolSwitches) then exit;'#13#10
