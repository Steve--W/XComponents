  +'aNone,paiaRead]) then'#13#10'        // result was never used'#13#10'      '
  +'  EmitMessage(20170313214038,mtHint,nPAFunctionResultDoesNotSeemToBeSet,'#13
  +#10'          sPAFunctionResultDoesNotSeemToBeSet,[],PosEl)'#13#10'      els'
  +'e'#13#10'        begin'#13#10'        // result was used'#13#10'        end'
  +';'#13#10'      end;'#13#10'    end;'#13#10#13#10'  if El.Body<>nil then'#13
  +#10'    begin'#13#10'    // check declarations'#13#10'    EmitDeclarationsHi'
