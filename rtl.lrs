  +#10#13#10#13#10'Function AnsiMatchStr(const AText: string; const AValues: ar'
  +'ray of string): Boolean;'#13#10'begin'#13#10'  Result:=AnsiIndexStr(AText,A'
  +'values)<>-1;'#13#10'end;'#13#10#13#10#13#10'Function AnsiIndexStr(const ATe'
