  +'Defined(const aName: String): boolean;'#13#10'begin'#13#10'  Result:=(FDefi'
  +'nes.IndexOf(aName)>=0) or (FMacros.IndexOf(aName)>=0);'#13#10'end;'#13#10#13
  +#10'function TPascalScanner.IfOpt(Letter: Char): boolean;'#13#10'begin'#13#10
  +'  Letter:=upcase(Letter);'#13#10'  Result:=(Letter in [''A''..''Z'']) and ('
  +'LetterSwitchNames[Letter]<>'''')'#13#10'    and IsDefined(LetterSwitchNames'
  +'[Letter]);'#13#10'end;'#13#10#13#10'function TPascalScanner.AddMacro(const '
  +'aName, aValue: String; Quiet: boolean'#13#10'  ): boolean;'#13#10'var'#13#10
  +'  Index: Integer;'#13#10'begin'#13#10'  Index:=FMacros.IndexOf(aName);'#13
  +#10'  If (Index=-1) then'#13#10'    FMacros.AddObject(aName,TMacroDef.Create'
  +'(aName,aValue))'#13#10'  else'#13#10'    begin'#13#10'    if TMacroDef(FMac'
  +'ros.Objects[Index]).Value=aValue then exit(false);'#13#10'    TMacroDef(FMa'
  +'cros.Objects[Index]).Value:=aValue;'#13#10'    end;'#13#10'  Result:=true;'
  +#13#10'  if (not Quiet) and LogEvent(sleConditionals) then'#13#10'    DoLog('
  +'mtInfo,nLogMacroDefined,sLogMacroDefined,[aName])'#13#10'end;'#13#10#13#10
  +'function TPascalScanner.RemoveMacro(const aName: String; Quiet: boolean'#13
  +#10'  ): boolean;'#13#10'var'#13#10'  Index: Integer;'#13#10'begin'#13#10'  '
  +'Index:=FMacros.IndexOf(aName);'#13#10'  if Index<0 then exit(false);'#13#10
