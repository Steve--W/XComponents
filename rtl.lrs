  +'RV:=IntPower(10,Digits);'#13#10'  Result:=Round(AValue/RV)*RV;'#13#10'end;'
  +#13#10#13#10'function SimpleRoundTo(const AValue: Double; const Digits: TRou'
  +'ndToRange): Double;'#13#10'var'#13#10'  RV : Double;'#13#10#13#10'begin'#13
  +#10'  RV := IntPower(10, -Digits);'#13#10'  if AValue < 0 then'#13#10'    Re'
  +'sult := Int((AValue*RV) - 0.5)/RV'#13#10'  else'#13#10'    Result := Int((A'
  +'Value*RV) + 0.5)/RV;'#13#10'end;'#13#10#13#10'function randg(mean,stddev : '
  +'float) : float;'#13#10#13#10'Var'#13#10'  U1,S2 : Float;'#13#10#13#10'begin'
  +#13#10'  repeat'#13#10'    u1:= 2*random-1;'#13#10'    S2:=Sqr(U1)+sqr(2*ran'
  +'dom-1);'#13#10'  until s2<1;'#13#10'  Result:=Sqrt(-2*ln(S2)/S2)*u1*stddev+'
  +'Mean;'#13#10'end;'#13#10#13#10#13#10'function RandomRange(const aFrom, aTo:'
  +' Integer): Integer;'#13#10'begin'#13#10'  Result:=Random(Abs(aFrom-aTo))+Mi'
  +'n(aTo,AFrom);'#13#10'end;'#13#10#13#10#13#10'function RandomRange(const aFr'
  +'om, aTo: NativeLargeInt): NativeLargeInt;'#13#10#13#10'Var'#13#10'  m : Nat'
  +'iveLargeInt;'#13#10'begin'#13#10'  if aFrom<aTo then'#13#10'    M:=aFrom'#13
