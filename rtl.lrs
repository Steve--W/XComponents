  +'Century    = 100;'#13#10'  YearsPerMillennium = 1000;'#13#10#13#10'  // ISO'
  +' day numbers.'#13#10'  DayMonday    = 1;'#13#10'  DayTuesday   = 2;'#13#10
  +'  DayWednesday = 3;'#13#10'  DayThursday  = 4;'#13#10'  DayFriday    = 5;'
  +#13#10'  DaySaturday  = 6;'#13#10'  DaySunday    = 7;'#13#10#13#10'  // Frac'
  +'tion of a day'#13#10'  OneHour        = TDateTime(1)/HoursPerDay;'#13#10'  '
  +'OneMinute      = TDateTime(1)/MinsPerDay;'#13#10'  OneSecond      = TDateTi'
  +'me(1)/SecsPerDay;'#13#10'  OneMillisecond = TDateTime(1)/MSecsPerDay;'#13#10
  +#13#10'  { This is actual days per year but you need to know if it''s a leap'
  +' year}'#13#10'  DaysPerYear: array [Boolean] of Word = (365, 366);'#13#10#13
