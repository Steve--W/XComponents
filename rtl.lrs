  +#13#10'  // fpc hints: use same IDs as fpc'#13#10'  nPAUnitNotUsed = 5023;'
  +#13#10'  sPAUnitNotUsed = ''Unit "%s" not used in %s'';'#13#10'  nPAParamete'
  +'rNotUsed = 5024;'#13#10'  sPAParameterNotUsed = ''Parameter "%s" not used'''
  +';'#13#10'  nPALocalVariableNotUsed = 5025;'#13#10'  sPALocalVariableNotUsed'
