  +'end;'#13#10#13#10#13#10'Function MonthOf(const AValue: TDateTime): Word;'#13
  +#10#13#10'Var'#13#10'  Y,D : Word;'#13#10#13#10'begin'#13#10'  DecodeDate(AV'
  +'alue,Y,Result,D);'#13#10'end;'#13#10#13#10#13#10'Function WeekOf(const AVal'
  +'ue: TDateTime): Word;'#13#10'begin'#13#10'  Result:=WeekOfTheYear(AValue);'
  +#13#10'end;'#13#10#13#10#13#10'Function DayOf(const AValue: TDateTime): Word'
  +';'#13#10#13#10'Var'#13#10'  Y,M : Word;'#13#10#13#10'begin'#13#10'  DecodeD'
