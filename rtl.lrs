  +#13#10'{ For a given date these Functions tell you the which day of the week'
  +' of the'#13#10'  month (or year).  If its a Thursday, they will tell you if'
  +' its the first,'#13#10'  second, etc Thursday of the month (or year).  Reme'
  +'mber, even though its'#13#10'  the first Thursday of the year it doesn''t m'
  +'ean its the first week of the'#13#10'  year.  See ISO 8601 above for more i'
  +'nformation. }'#13#10#13#10'Function NthDayOfWeek(const AValue: TDateTime): '
  +'Word;'#13#10#13#10'Procedure DecodeDayOfWeekInMonth(const AValue: TDateTime'
  +'; out AYear, AMonth, ANthDayOfWeek, ADayOfWeek: Word);'#13#10#13#10'Functio'
  +'n EncodeDayOfWeekInMonth(const AYear, AMonth, ANthDayOfWeek,  ADayOfWeek: W'
  +'ord): TDateTime;'#13#10'Function TryEncodeDayOfWeekInMonth(const AYear, AMo'
  +'nth, ANthDayOfWeek,  ADayOfWeek: Word; out AValue: TDateTime): Boolean;'#13
  +#10#13#10'{ ----------------------------------------------------------------'
