  +'reeDbg(El: TPasElement; Indent: integer): string;'#13#10#13#10'  procedure '
  +'LineBreak(SubIndent: integer);'#13#10'  begin'#13#10'    Inc(Indent,SubInde'
  +'nt);'#13#10'    Result:=Result+LineEnding+StringOfChar('' '',Indent);'#13#10
  +'  end;'#13#10#13#10'var'#13#10'  i, l: Integer;'#13#10'begin'#13#10'  if El'
  +'=nil then exit(''nil'');'#13#10'  Result:=El.Name+'':''+El.ClassName+''='';'
  +#13#10'  if El is TPasExpr then'#13#10'    begin'#13#10'    if El.ClassType<'
  +'>TBinaryExpr then'#13#10'      Result:=Result+OpcodeStrings[TPasExpr(El).Op'
  +'Code];'#13#10'    if El.ClassType=TUnaryExpr then'#13#10'      Result:=Resu'
  +'lt+GetTreeDbg(TUnaryExpr(El).Operand,Indent)'#13#10'    else if El.ClassTyp'
  +'e=TBinaryExpr then'#13#10'      Result:=Result+''Left={''+GetTreeDbg(TBinar'
  +'yExpr(El).left,Indent)+''}'''#13#10'         +OpcodeStrings[TPasExpr(El).Op'
  +'Code]'#13#10'         +''Right={''+GetTreeDbg(TBinaryExpr(El).right,Indent)'
  +'+''}'''#13#10'    else if El.ClassType=TPrimitiveExpr then'#13#10'      Res'
  +'ult:=Result+TPrimitiveExpr(El).Value'#13#10'    else if El.ClassType=TBoolC'
  +'onstExpr then'#13#10'      Result:=Result+BoolToStr(TBoolConstExpr(El).Valu'
  +'e,''true'',''false'')'#13#10'    else if El.ClassType=TNilExpr then'#13#10
  +'      Result:=Result+''nil'''#13#10'    else if El.ClassType=TInheritedExpr'
  +' then'#13#10'      Result:=Result+''inherited'''#13#10'    else if El.Class'
  +'Type=TSelfExpr then'#13#10'      Result:=Result+''Self'''#13#10'    else if'
  +' El.ClassType=TParamsExpr then'#13#10'      begin'#13#10'      LineBreak(2)'
  ,';'#13#10'      Result:=Result+GetTreeDbg(TParamsExpr(El).Value,Indent)+''('
  +''';'#13#10'      l:=length(TParamsExpr(El).Params);'#13#10'      if l>0 the'
  +'n'#13#10'        begin'#13#10'        inc(Indent,2);'#13#10'        for i:='
  +'0 to l-1 do'#13#10'          begin'#13#10'          LineBreak(0);'#13#10'  '
  +'        Result:=Result+GetTreeDbg(TParamsExpr(El).Params[i],Indent);'#13#10
  +'          if i<l-1 then'#13#10'            Result:=Result+'','''#13#10'    '
  +'      end;'#13#10'        dec(Indent,2);'#13#10'        end;'#13#10'      R'
  +'esult:=Result+'')'';'#13#10'      end'#13#10'    else if El.ClassType=TReco'
  +'rdValues then'#13#10'      begin'#13#10'      Result:=Result+''('';'#13#10
  +'      l:=length(TRecordValues(El).Fields);'#13#10'      if l>0 then'#13#10
  +'        begin'#13#10'        inc(Indent,2);'#13#10'        for i:=0 to l-1 '
  +'do'#13#10'          begin'#13#10'          LineBreak(0);'#13#10'          R'
  +'esult:=Result+TRecordValues(El).Fields[i].Name+'':'''#13#10'            +Ge'
  +'tTreeDbg(TRecordValues(El).Fields[i].ValueExp,Indent);'#13#10'          if '
  +'i<l-1 then'#13#10'            Result:=Result+'','''#13#10'          end;'#13
  +#10'        dec(Indent,2);'#13#10'        end;'#13#10'      Result:=Result+'
  +''')'';'#13#10'      end'#13#10'    else if El.ClassType=TArrayValues then'
  +#13#10'      begin'#13#10'      Result:=Result+''['';'#13#10'      l:=length'
  +'(TArrayValues(El).Values);'#13#10'      if l>0 then'#13#10'        begin'#13
  +#10'        inc(Indent,2);'#13#10'        for i:=0 to l-1 do'#13#10'        '
  +'  begin'#13#10'          LineBreak(0);'#13#10'          Result:=Result+GetT'
  +'reeDbg(TArrayValues(El).Values[i],Indent);'#13#10'          if i<l-1 then'
  +#13#10'            Result:=Result+'','''#13#10'          end;'#13#10'       '
  +' dec(Indent,2);'#13#10'        end;'#13#10'      Result:=Result+'']'';'#13
  +#10'      end;'#13#10'    end'#13#10'  else if El is TPasProcedure then'#13
  +#10'    begin'#13#10'    Result:=Result+GetTreeDbg(TPasProcedure(El).ProcTyp'
  +'e,Indent);'#13#10'    end'#13#10'  else if El is TPasProcedureType then'#13
  +#10'    begin'#13#10'    if TPasProcedureType(El).IsReferenceTo then'#13#10
  +'      Result:=Result+'' ''+ProcTypeModifiers[ptmIsNested];'#13#10'    Resul'
  +'t:=Result+''('';'#13#10'    l:=TPasProcedureType(El).Args.Count;'#13#10'   '
  +' if l>0 then'#13#10'      begin'#13#10'      inc(Indent,2);'#13#10'      fo'
  +'r i:=0 to l-1 do'#13#10'        begin'#13#10'        LineBreak(0);'#13#10' '
  +'       Result:=Result+GetTreeDbg(TPasArgument(TPasProcedureType(El).Args[i]'
  +'),Indent);'#13#10'        if i<l-1 then'#13#10'          Result:=Result+'';'
  +''''#13#10'        end;'#13#10'      dec(Indent,2);'#13#10'      end;'#13#10
  +'    Result:=Result+'')'';'#13#10'    if El is TPasFunction then'#13#10'    '
  +'  Result:=Result+'':''+GetTreeDbg(TPasFunctionType(TPasFunction(El).ProcTyp'
  +'e).ResultEl,Indent);'#13#10'    if TPasProcedureType(El).IsOfObject then'#13
  +#10'      Result:=Result+'' ''+ProcTypeModifiers[ptmOfObject];'#13#10'    if'
  +' TPasProcedureType(El).IsNested then'#13#10'      Result:=Result+'' ''+Proc'
  +'TypeModifiers[ptmIsNested];'#13#10'    if cCallingConventions[TPasProcedure'
  +'Type(El).CallingConvention]<>'''' then'#13#10'      Result:=Result+''; ''+c'
  +'CallingConventions[TPasProcedureType(El).CallingConvention];'#13#10'    end'
  +#13#10'  else if El.ClassType=TPasResultElement then'#13#10'    Result:=Resu'
  +'lt+GetTreeDbg(TPasResultElement(El).ResultType,Indent)'#13#10'  else if El.'
  +'ClassType=TPasArgument then'#13#10'    begin'#13#10'    if AccessNames[TPas'
  +'Argument(El).Access]<>'''' then'#13#10'      Result:=Result+AccessNames[TPa'
  +'sArgument(El).Access];'#13#10'    if TPasArgument(El).ArgType=nil then'#13
  +#10'      Result:=Result+''untyped'''#13#10'    else'#13#10'      Result:=Re'
  +'sult+GetTreeDbg(TPasArgument(El).ArgType,Indent);'#13#10'    end'#13#10'  e'
  +'lse if El.ClassType=TPasUnresolvedSymbolRef then'#13#10'    begin'#13#10'  '
  +'  if El.CustomData is TResElDataBuiltInProc then'#13#10'      Result:=Resul'
  +'t+TResElDataBuiltInProc(TPasUnresolvedSymbolRef(El).CustomData).Signature;'
  +#13#10'    end;'#13#10'end;'#13#10#13#10'function GetResolverResultDbg(const'
  +' T: TPasResolverResult): string;'#13#10'var'#13#10'  HiTypeEl: TPasType;'#13
  +#10'begin'#13#10'  Result:=''[bt=''+ResBaseTypeNames[T.BaseType];'#13#10'  i'
  +'f T.SubType<>btNone then'#13#10'    Result:=Result+'' Sub=''+ResBaseTypeNam'
  +'es[T.SubType];'#13#10'  Result:=Result'#13#10'         +'' Ident=''+GetObjN'
  +'ame(T.IdentEl);'#13#10'  HiTypeEl:=ResolveSimpleAliasType(T.HiTypeEl);'#13
  +#10'  if HiTypeEl<>T.LoTypeEl then'#13#10'    Result:=Result+'' LoType=''+Ge'
  +'tObjName(T.LoTypeEl)+'' HiTypeEl=''+GetObjName(HiTypeEl)'#13#10'  else'#13
  +#10'    Result:=Result+'' Type=''+GetObjName(T.LoTypeEl);'#13#10'  Result:=R'
  +'esult'#13#10'         +'' Expr=''+GetObjName(T.ExprEl)'#13#10'         +'' '
  +'Flags=''+ResolverResultFlagsToStr(T.Flags)'#13#10'         +'']'';'#13#10'e'
  ,'nd;'#13#10#13#10'function GetClassAncestorsDbg(El: TPasClassType): string;'
  +#13#10#13#10'  function GetClassDesc(C: TPasClassType): string;'#13#10'  var'
  +#13#10'    Module: TPasModule;'#13#10'  begin'#13#10'    if C.IsExternal the'
