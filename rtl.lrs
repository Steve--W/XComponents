  +'erUsed,'#13#10'          sPAPrivateMethodIsNeverUsed,[El.FullName],El)'#13
  ,#10'      else'#13#10'        EmitMessage(20170312093418,mtHint,nPALocalXYNo'
  +'tUsed,'#13#10'          sPALocalXYNotUsed,[El.ElementTypeName,El.Name],El);'
  +#13#10'      end;'#13#10'    exit;'#13#10'    end;'#13#10#13#10'  // procedu'
  +'re was used'#13#10#13#10'  if [pmAbstract,pmAssembler,pmExternal]*DeclProc.'
  +'Modifiers<>[] then exit;'#13#10'  if [pmAssembler]*ImplProc.Modifiers<>[] t'
  +'hen exit;'#13#10'  if El.Parent is TPasClassType then'#13#10'    begin'#13
  +#10'    if TPasClassType(El.Parent).ObjKind=okInterface then exit;'#13#10'  '
  +'  end;'#13#10#13#10'  if ProcScope.DeclarationProc=nil then'#13#10'    begi'
  +'n'#13#10'    // check parameters'#13#10'    Args:=El.ProcType.Args;'#13#10
  +'    for i:=0 to Args.Count-1 do'#13#10'      begin'#13#10'      Arg:=TPasAr'
  +'gument(Args[i]);'#13#10'      Usage:=FindElement(Arg);'#13#10'      if (Usa'
  +'ge=nil) or (Usage.Access=paiaNone) then'#13#10'        begin'#13#10'       '
