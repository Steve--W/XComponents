  +#10'begin'#13#10'  {$IFDEF VerbosePasAnalyzer}'#13#10'  writeln(''TPasAnalyz'
  +'er.EmitProcedureHints '',GetElModName(El));'#13#10'  {$ENDIF}'#13#10'  Proc'
  +'Scope:=El.CustomData as TPasProcedureScope;'#13#10'  if ProcScope.Declarati'
