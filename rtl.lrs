  +#10'{$ENDIF}'#13#10'{$IFDEF NodeJS}'#13#10'  {$I pas2jsfileutilsnodejs.inc}'
  +#13#10'{$ENDIF}'#13#10#13#10'procedure InternalInit;'#13#10'begin'#13#10'  {'
  +'$IFDEF FPC_HAS_CPSTRING}'#13#10'  SetMultiByteConversionCodePage(CP_UTF8);'
  +#13#10'  // SetMultiByteFileSystemCodePage(CP_UTF8); not needed, this is the'
  +' default under Windows'#13#10'  SetMultiByteRTLFileSystemCodePage(CP_UTF8);'
  +#13#10#13#10'  GetDefaultTextEncoding;'#13#10'  {$IFDEF Windows}'#13#10'  No'
  +'nUTF8System:=true;'#13#10'  {$ELSE}'#13#10'  NonUTF8System:=SysUtils.Compar'
  +'eText(DefaultTextEncoding,''UTF8'')<>0;'#13#10'  {$ENDIF}'#13#10'  {$ENDIF}'
  +#13#10#13#10'  InitPlatform;'#13#10'end;'#13#10#13#10'initialization'#13#10
  +'  InternalInit;'#13#10'{$IFDEF FPC}'#13#10'finalization'#13#10'  FinalizePl'
  +'atform;'#13#10'{$ENDIF}'#13#10'end.'#13#10#13#10
