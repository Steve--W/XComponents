  +#13#10'        InLiteral:=C<>Q'#13#10'      else'#13#10'        begin'#13#10
  +'        inLiteral:=True;'#13#10'        Q:=C;'#13#10'        end;'#13#10'  '
  +'    end'#13#10'    else if InLiteral then'#13#10'      ToResult(C)'#13#10' '
  +'   else'#13#10'      case C of'#13#10'      ''0'', ''#'':'#13#10'        Co'
  +'pyDigit;'#13#10'      ''.'', '','':'#13#10'        ; // Do nothing, handled'
  +' by CopyDigit'#13#10'      ''e'', ''E'':'#13#10'        begin'#13#10'      '
  +'  ToResult(C); // Always needed'#13#10'        Inc(I);'#13#10'        if I<'
  +'=Length(Section) then'#13#10'          begin'#13#10'          C:=Section[I]'
  +';'#13#10'          if (C in [''+'',''-'']) then'#13#10'            begin'#13
  +#10'            AddToResult(FormatExponent(C,FV.Exponent-DecimalPos+1));'#13
  +#10'            // Skip rest'#13#10'            while (I<SectionLength) and '
  +'(Section[i+1]=''0'') do'#13#10'              Inc(I);'#13#10'            end'
  +';'#13#10'          end;'#13#10'        end;'#13#10'      else'#13#10'      '
  +'  ToResult(C);'#13#10'      end;'#13#10'    Inc(i);'#13#10'    end;'#13#10
  +'end;'#13#10#13#10'function StrToBool(const S: String): Boolean;'#13#10'begi'
  +'n'#13#10'  if not(TryStrToBool(S,Result)) then'#13#10'    raise EConvertErr'
  +'or.CreateFmt(SInvalidBoolean,[S]);'#13#10'end;'#13#10#13#10'procedure Check'
  +'BoolStrs;'#13#10'begin'#13#10'  if Length(TrueBoolStrs)=0 then'#13#10'  beg'
  +'in'#13#10'    SetLength(TrueBoolStrs,1);'#13#10'    TrueBoolStrs[0]:=''True'
  +''';'#13#10'  end;'#13#10'  if Length(FalseBoolStrs)=0 then'#13#10'  begin'
  +#13#10'    SetLength(FalseBoolStrs,1);'#13#10'    FalseBoolStrs[0]:=''False'
  +''';'#13#10'  end;'#13#10'end;'#13#10#13#10'function BoolToStr(B: Boolean; U'
  +'seBoolStrs: Boolean): string;'#13#10'begin'#13#10'  if UseBoolStrs Then'#13
  +#10'  begin'#13#10'    CheckBoolStrs;'#13#10'    if B then'#13#10'      Resu'
  +'lt:=TrueBoolStrs[0]'#13#10'    else'#13#10'      Result:=FalseBoolStrs[0];'
  +#13#10'  end else'#13#10'    if B then'#13#10'      Result:=''-1'''#13#10'  '
  +'  else'#13#10'      Result:=''0'';'#13#10'end;'#13#10#13#10'function BoolTo'
  +'Str(B: Boolean; const TrueS, FalseS: String): string;'#13#10'begin'#13#10' '
  +' if B then Result:=TrueS else Result:=FalseS;'#13#10'end;'#13#10#13#10'func'
  +'tion StrToBoolDef(const S: String; Default: Boolean): Boolean;'#13#10'begin'
  +#13#10'  if not TryStrToBool(S,Result) then'#13#10'    Result:=Default;'#13
  +#10'end;'#13#10#13#10'function TryStrToBool(const S: String; out Value: Bool'
  +'ean): Boolean;'#13#10'Var'#13#10'  Temp : String;'#13#10'  I    : Longint;'
  +#13#10'  D : Double;'#13#10'  Code: integer;'#13#10'begin'#13#10'  Temp:=upp'
  +'ercase(S);'#13#10'  Val(Temp,D,code);'#13#10'  Result:=true;'#13#10'  If Co'
  +'de=0 then'#13#10'    Value:=(D<>0.0)'#13#10'  else'#13#10'    begin'#13#10
  +'      CheckBoolStrs;'#13#10'      for I:=low(TrueBoolStrs) to High(TrueBool'
  +'Strs) do'#13#10'        if Temp=uppercase(TrueBoolStrs[I]) then'#13#10'    '
  +'      begin'#13#10'            Value:=true;'#13#10'            exit;'#13#10
  +'          end;'#13#10'      for I:=low(FalseBoolStrs) to High(FalseBoolStrs'
  +') do'#13#10'        if Temp=uppercase(FalseBoolStrs[I]) then'#13#10'       '
  +'   begin'#13#10'            Value:=false;'#13#10'            exit;'#13#10' '
  +'         end;'#13#10'      Result:=false;'#13#10'    end;'#13#10'end;'#13#10
  +#13#10'function UpperCase(const s: String): String; assembler;'#13#10'asm'#13
  +#10'  return s.toUpperCase();'#13#10'end;'#13#10#13#10'function LowerCase(co'
  +'nst s: String): String; assembler;'#13#10'asm'#13#10'  return s.toLowerCase'
  ,'();'#13#10'end;'#13#10#13#10'function CompareStr(const s1, s2: String): Int'
  +'eger; assembler;'#13#10'asm'#13#10'  var l1 = s1.length;'#13#10'  var l2 = '
  +'s2.length;'#13#10'  if (l1<=l2){'#13#10'    var s = s2.substr(0,l1);'#13#10
  +'    if (s1<s){ return -1;'#13#10'    } else if (s1>s){ return 1;'#13#10'   '
  +' } else { return l1<l2 ? -1 : 0; };'#13#10'  } else {'#13#10'    var s = s1'
  +'.substr(0,l2);'#13#10'    if (s<s2){ return -1;'#13#10'    } else { return '
  +'1; };'#13#10'  };'#13#10'end;'#13#10#13#10'function SameStr(const s1, s2: S'
  +'tring): Boolean; assembler;'#13#10'asm'#13#10'  return s1 == s2;'#13#10'end'
  +';'#13#10#13#10'function CompareText(const s1, s2: String): Integer; assembl'
  +'er;'#13#10'asm'#13#10'  var l1 = s1.toLowerCase();'#13#10'  var l2 = s2.toL'
  +'owerCase();'#13#10'  if (l1>l2){ return 1;'#13#10'  } else if (l1<l2){ retu'
  +'rn -1;'#13#10'  } else { return 0; }'#13#10'end;'#13#10#13#10'function Same'
  +'Text(const s1, s2: String): Boolean; assembler;'#13#10'asm'#13#10'  return '
  +'s1.toLowerCase() == s2.toLowerCase();'#13#10'end;'#13#10#13#10'function Ans'
  +'iCompareText(const s1, s2: String): Integer; assembler;'#13#10'asm'#13#10' '
  +' return s1.localeCompare(s2);'#13#10'end;'#13#10#13#10'function AnsiSameTex'
  +'t(const s1, s2: String): Boolean; assembler;'#13#10'asm'#13#10'  return s1.'
  +'localeCompare(s2) == 0;'#13#10'end;'#13#10#13#10'function AnsiCompareStr(co'
  +'nst s1, s2: String): Integer;'#13#10'begin'#13#10'  {$IFDEF ECMAScript6}'#13
  +#10'  Result:=CompareText(TJSString(s1).normalize(),TJSString(s1).normalize('
  +'));'#13#10'  {$ELSE}'#13#10'  Result:=CompareText(s1,s2);'#13#10'  {$ENDIF}'
  +#13#10'end;'#13#10#13#10'procedure AppendStr(var Dest: String; const S: stri'
  +'ng);'#13#10#13#10'begin'#13#10'  Dest:=Dest+S;'#13#10'end;'#13#10#13#10#13
  +#10'Const'#13#10'  feInvalidFormat   = 1;'#13#10'  feMissingArgument = 2;'#13
  +#10'  feInvalidArgIndex = 3;'#13#10#13#10'Procedure DoFormatError (ErrCode :'
  +' Longint;const fmt: String);'#13#10#13#10#13#10'begin'#13#10'  //!! must be'
  +' changed to contain format string...'#13#10'  Case ErrCode of'#13#10'   feI'
  +'nvalidFormat : raise EConvertError.Createfmt(SInvalidFormat,[Fmt]);'#13#10
  +'   feMissingArgument : raise EConvertError.Createfmt(SArgumentMissing,[Fmt]'
  +');'#13#10'   feInvalidArgIndex : raise EConvertError.Createfmt(SInvalidArgI'
  +'ndex,[Fmt]);'#13#10'  end;'#13#10'end;'#13#10#13#10'Const'#13#10'  maxdigit'
  +'s = 15;'#13#10#13#10'Function ReplaceDecimalSep(S: String; Const DS : strin'
  +'g) : string;'#13#10#13#10'Var'#13#10'  P : Integer;'#13#10#13#10'begin'#13
  +#10'  P:=Pos(''.'',S);'#13#10'  if P>0 then'#13#10'    Result:=Copy(S,1,P-1)'
  +'+DS+Copy(S,P+1,Length(S)-P)'#13#10'  else'#13#10'    Result:=S;'#13#10'end;'
  +#13#10#13#10'function FormatGeneralFloat(Value : double; Precision : Integer'
  +'; DS : String) : string;'#13#10#13#10'Var'#13#10'  P, PE, Q, Exponent: Inte'
  +'ger;'#13#10#13#10'Begin'#13#10'  If (Precision = -1) Or (Precision > maxdig'
  +'its) Then'#13#10'     Precision := maxdigits;'#13#10'  { First convert to s'
  +'cientific format, with correct precision }'#13#10'  Str(Value:precision+7, '
  +'Result);'#13#10'  { Delete leading spaces }'#13#10'  Result:=TrimLeft(Resul'
  +'t);'#13#10'  P:=Pos(''.'',Result);'#13#10'  if P=0 then'#13#10'    exit;'#13
  +#10'   { Consider removing exponent }'#13#10'  PE:=Pos(''E'',Result);'#13#10
  +'  if PE=0 then'#13#10'    begin'#13#10'    Result:=ReplaceDecimalSep(Result'
  +',DS);'#13#10'    exit;'#13#10'    end;'#13#10'  { Read exponent }'#13#10'  '
  +'Q:=PE+2;'#13#10'  Exponent := 0;'#13#10'  while (Q <= Length(Result)) do'#13
  +#10'    begin'#13#10'    Exponent := Exponent*10 + Ord(Result[Q])-Ord(''0'')'
  +';'#13#10'    Inc(Q);'#13#10'    end;'#13#10'  if Result[PE+1] = ''-'' then'
  +#13#10'    Exponent := -Exponent;'#13#10'  if (P+Exponent < PE) and (Exponen'
  +'t > -6) then'#13#10'    begin'#13#10'    { OK to remove exponent }'#13#10' '
  +'   SetLength(Result,PE-1); { Trim exponent }'#13#10'    if Exponent >= 0 th'
  +'en'#13#10'      begin'#13#10'        { Shift point to right }'#13#10'      '
  +'for Q := 0 to Exponent-1 do'#13#10'        begin'#13#10'        Result[P] :'
  +'= Result[P+1];'#13#10'        Inc(P);'#13#10'        end;'#13#10'      Resu'
  +'lt[P] := ''.'';'#13#10'      P := 1;'#13#10'      if Result[P] = ''-'' then'
  +#13#10'        Inc(P);'#13#10'      while (Result[P] = ''0'') and (P < Lengt'
  +'h(Result)) and (Copy(Result,P+1,Length(DS))<>DS) do'#13#10'          { Trim'
  +' leading zeros; conversion above should not give any, but occasionally does'
  +#13#10'            because of rounding }'#13#10'          System.Delete(Resu'
  +'lt,P,1);'#13#10'      end'#13#10'    else'#13#10'      begin'#13#10'      {'
  +' Add zeros at start }'#13#10'      Insert(Copy(''00000'',1,-Exponent),Resul'
  +'t,P-1);'#13#10'      Result[P-Exponent] := Result[P-Exponent-1]; { Copy lea'
  +'ding digit }'#13#10'      Result[P] := ''.'';'#13#10'      if Exponent <> -'
  +'1 then'#13#10'        Result[P-Exponent-1] := ''0'';'#13#10'      end;'#13
  ,#10'    { Remove trailing zeros }'#13#10'    Q := Length(Result);'#13#10'   '
  +' while (Q > 0) and (Result[Q] = ''0'') do'#13#10'      Dec(Q);'#13#10'    i'
  +'f Result[Q] = ''.'' then'#13#10'      Dec(Q); { Remove trailing decimal poi'
  +'nt }'#13#10'    if (Q = 0) or ((Q=1) and (Result[1] = ''-'')) then'#13#10' '
  +'     Result := ''0'''#13#10'    else'#13#10'      SetLength(Result,Q);'#13
  +#10'    end'#13#10'  else'#13#10'    begin'#13#10'    { Need exponent, but r'
  +'emove superfluous characters }'#13#10'    { Delete trailing zeros }'#13#10
  +'    while Result[PE-1] = ''0'' do'#13#10'      begin'#13#10'      System.De'
  +'lete(Result,PE-1,1);'#13#10'      Dec(PE);'#13#10'      end;'#13#10'    { I'
  +'f number ends in decimal point, remove it }'#13#10'    if Result[PE-1] = DS'
  +' then'#13#10'      begin'#13#10'      System.Delete(Result,PE-1,1);'#13#10
  +'      Dec(PE);'#13#10'      end;'#13#10'    { delete superfluous + in expon'
  +'ent }'#13#10'    if Result[PE+1]=''+'' then'#13#10'      System.Delete(Resu'
  +'lt,PE+1,1)'#13#10'    else'#13#10'      Inc(PE);'#13#10'    while Result[PE'
  +'+1] = ''0'' do'#13#10'      { Delete leading zeros in exponent }'#13#10'   '
  +'   System.Delete(Result,PE+1,1)'#13#10'    end;'#13#10'  Result:=ReplaceDec'
  +'imalSep(Result,DS)'#13#10'end;'#13#10#13#10'function FormatExponentFloat(Va'
  +'lue : double; Precision,Digits : Integer;DS : String) : string;'#13#10#13#10
  +'Var'#13#10'  P: Integer;'#13#10'Begin'#13#10'  DS:=DecimalSeparator;'#13#10
  +'  If (Precision = -1) Or (Precision > maxdigits) Then'#13#10'    Precision '
  +':= maxdigits;'#13#10'  Str(Value:Precision+7, Result);'#13#10'  { Delete le'
  +'ading spaces }'#13#10'  while Result[1] = '' '' do'#13#10'    System.Delete'
  +'(Result, 1, 1);'#13#10'  P:=Pos(''E'',Result);'#13#10'  if P=0 then'#13#10
  +'    begin'#13#10'    Result:=ReplaceDecimalSep(Result,DS);'#13#10'    exit;'
  +#13#10'    end;'#13#10'  Inc(P, 2);'#13#10'  if Digits > 4 then'#13#10'    D'
  +'igits:=4;'#13#10'  Digits:=Length(Result) - P - Digits + 1;'#13#10'  if Dig'
  +'its < 0 then'#13#10'    insert(copy(''0000'',1,-Digits),Result,P)'#13#10'  '
  +'else'#13#10'    while (Digits > 0) and (Result[P] = ''0'') do'#13#10'      '
  +'begin'#13#10'      System.Delete(Result, P, 1);'#13#10'      if P > Length('
  +'Result) then'#13#10'        begin'#13#10'        System.Delete(Result, P - '
  +'2, 2);'#13#10'        break;'#13#10'        end;'#13#10'      Dec(Digits);'
  +#13#10'      end;'#13#10'  Result:=ReplaceDecimalSep(Result,DS);'#13#10'End;'
  +#13#10#13#10'function FormatFixedFloat(Value : double; Digits : Integer; DS '
  +': String) : string;'#13#10#13#10'Begin'#13#10'  If Digits = -1 Then'#13#10
  +'    Digits := 2'#13#10'  Else If Digits > 18 Then'#13#10'    Digits := 18;'
  +#13#10'  Str(Value:0:Digits, Result);'#13#10'  if (Result<>'''') and (Result'
  +'[1]='' '') then'#13#10'    Delete(Result,1,1);'#13#10'  Result:=ReplaceDeci'
  +'malSep(Result,DS);'#13#10'end;'#13#10#13#10#13#10'function FormatNumberFloa'
  +'t(Value : double; Digits : Integer; DS,TS : String) : string;'#13#10#13#10
  +'Var'#13#10'  P : integer;'#13#10#13#10'Begin'#13#10'  If Digits = -1 Then'
  +#13#10'    Digits := 2'#13#10'  else If Digits > maxdigits Then'#13#10'    D'
  +'igits := maxdigits;'#13#10'  Str(Value:0:Digits, Result);'#13#10'  if (Resu'
  +'lt<>'''') and (Result[1]='' '') then'#13#10'    Delete(Result,1,1);'#13#10
  +'  P:=Pos(''.'',Result);'#13#10'  Result:=ReplaceDecimalSep(Result,DS);'#13
  +#10'  Dec(P,3);'#13#10'  if (TS<>'''') and (TS<>#0) then'#13#10'    While (P'
  +'>1) Do'#13#10'      Begin'#13#10'      If (Result[P-1] <> ''-'')  Then'#13
  +#10'        Insert(TS, Result, P);'#13#10'      Dec(P, 3);'#13#10'      End;'
  +#13#10'End;'#13#10#13#10'function RemoveLeadingNegativeSign(var AValue: Stri'
  +'ng; DS : String): Boolean;'#13#10#13#10'// removes negative sign in case wh'
  +'en result is zero eg. -0.00'#13#10#13#10'var'#13#10'  i: PtrInt;'#13#10'  T'
  +'S: String;'#13#10'  StartPos: PtrInt;'#13#10#13#10'begin'#13#10'  Result:=F'
  +'alse;'#13#10'  StartPos := 2;'#13#10'  TS := ThousandSeparator;'#13#10'  fo'
  +'r i :=StartPos to length(AValue) do'#13#10'    begin'#13#10'    Result := ('
  +'AValue[i] in [''0'', DS, ''E'', ''+'']) or (aValue[i]=TS);'#13#10'    if no'
  +'t Result then'#13#10'      break;'#13#10'    end;'#13#10'  if (Result) and '
  +'(AValue[1]=''-'') then'#13#10'    Delete(AValue, 1, 1);'#13#10'end;'#13#10
  +#13#10'Function FormatNumberCurrency(const Value : Currency; Digits : Intege'
  +'r; DS,TS : String) : string;'#13#10#13#10'Var'#13#10'  Negative: Boolean;'
  +#13#10'  P : Integer;'#13#10#13#10'Begin'#13#10'  //  Writeln(''Value '',D);'
  +#13#10'   If Digits = -1 Then'#13#10'     Digits := CurrencyDecimals'#13#10
  +'   Else If Digits > 18 Then'#13#10'     Digits := 18;'#13#10'   Str(Value:0'
  +':Digits, Result);'#13#10'   // Writeln(''1. Result '',Result,'' currencystr'
  +'ing : '',CurrencyString);'#13#10'   Negative:=Result[1] = ''-'';'#13#10'   '
  +'if Negative then'#13#10'     System.Delete(Result, 1, 1);'#13#10'   P := Po'
  ,'s(''.'', Result);'#13#10'   // Writeln(''2. Result '',Result,'' currencystr'
