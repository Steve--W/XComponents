  +'  // Found on'#13#10'  // https://weblog.rogueamoeba.com/2017/02/27/javascr'
  +'ipt-correctly-converting-a-byte-array-to-a-utf-8-string/'#13#10'function st'
  +'ringFromUTF8Array(data)'#13#10'  {'#13#10'    const extraByteMap = [ 1, 1, '
  +'1, 1, 2, 2, 3, 0 ];'#13#10'    var count = data.length;'#13#10'    var str '
  +'= "";'#13#10#13#10'    for (var index = 0;index < count;)'#13#10'    {'#13
  +#10'      var ch = data[index++];'#13#10'      if (ch & 0x80)'#13#10'      {'
  +#13#10'        var extra = extraByteMap[(ch >> 3) & 0x07];'#13#10'        if'
  +' (!(ch & 0x40) || !extra || ((index + extra) > count))'#13#10'          ret'
  ,'urn null;'#13#10#13#10'        ch = ch & (0x3F >> extra);'#13#10'        fo'
  +'r (;extra > 0;extra -= 1)'#13#10'        {'#13#10'          var chx = data['
  +'index++];'#13#10'          if ((chx & 0xC0) != 0x80)'#13#10'            ret'
  +'urn null;'#13#10#13#10'          ch = (ch << 6) | (chx & 0x3F);'#13#10'    '
  +'    }'#13#10'      }'#13#10#13#10'      str += String.fromCharCode(ch);'#13
  +#10'    }'#13#10#13#10'    return str;'#13#10'  }'#13#10'*)'#13#10'procedure'
  +' TPas2jsWebFS.SaveToFile(ms: TFPJSStream; Filename: string);'#13#10#13#10'V'
