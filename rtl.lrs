  +#13#10#13#10'function StrToDate(const S: String; separator : char): TDateTim'
  +'e;'#13#10'begin'#13#10'    result := StrToDate(S,ShortDateFormat,separator)'
  +#13#10'end;'#13#10#13#10'function StrToDate(const S: String): TDateTime;'#13
  +#10'begin'#13#10'  result := StrToDate(S,ShortDateFormat,#0);'#13#10'end;'#13
  +#10#13#10'{   StrToTime converts the string S to a TDateTime value'#13#10'  '
  +'  if S does not represent a valid time value an'#13#10'    EConvertError wi'
  +'ll be raised   }'#13#10#13#10#13#10'function IntStrToTime(Out ErrorMsg : St'
  +'ring; const S: String; Len : integer; separator : char): TDateTime;'#13#10
  +#13#10'const'#13#10'  AMPM_None = 0;'#13#10'  AMPM_AM = 1;'#13#10'  AMPM_PM '
  +'= 2;'#13#10'  tiHour = 0;'#13#10'  tiMin = 1;'#13#10'  tiSec = 2;'#13#10'  '
  +'tiMSec = 3;'#13#10#13#10'type'#13#10'  TTimeValues = array of Word;'#13#10
  +#13#10'var'#13#10'   AmPm: integer;'#13#10'   TimeValues: TTimeValues;'#13#10
  +#13#10#13#10'   function SplitElements(out TimeValues: TTimeValues; out AmPm'
  +': Integer): Boolean;'#13#10'   //Strict version. It does not allow #32 as S'
  +'eparator, it will treat it as whitespace always'#13#10'   const'#13#10'    '
  +' Digits = ''0123456789'';'#13#10'   var'#13#10'      Cur, Offset, ElemLen, '
  +'Err, TimeIndex, FirstSignificantDigit: Integer;'#13#10'      Value: Integer'
  +';'#13#10'      DigitPending, MSecPending: Boolean;'#13#10'      AmPmStr: St'
  +'ring;'#13#10'      CurChar: Char;'#13#10'      I : Integer;'#13#10'      al'
  +'lowedchars : string;'#13#10#13#10'   begin'#13#10'     Result := False;'#13
  +#10'     AmPm := AMPM_None; //No Am or PM in string found yet'#13#10'     MS'
  +'ecPending := False;'#13#10'     TimeIndex := 0; //indicating which TTimeVal'
  +'ue must be filled next'#13#10'     For I:=tiHour to tiMSec do'#13#10'      '
  +'TimeValues[i]:=0;'#13#10'     Cur := 1;'#13#10'     //skip leading blanks'
  +#13#10'     While (Cur < Len) and (S[Cur] =#32) do Inc(Cur);'#13#10'     Off'
  +'set := Cur;'#13#10'     //First non-blank cannot be Separator or DecimalSep'
  +'arator'#13#10'     if (Cur > Len - 1) or (S[Cur] = Separator) or (S[Cur] = '
  ,'Decimalseparator) then'#13#10'       begin'#13#10'       // Writeln(''Error'
  +' in sep S[Cur]'',S[Cur],'' '',separator,'' '',GetDecimalSeparator);'#13#10
  +'       Exit;'#13#10'       end;'#13#10'     DigitPending := (Pos(S[Cur],Dig'
  +'its)>0);'#13#10'     While (Cur <= Len) do'#13#10'     begin'#13#10'       '
  +'//writeln;'#13#10'       // writeln(''Main While loop:  Cur = '',Cur,'' S[C'
  +'ur] = "'',S[Cur],''" Len = '',Len,'' separator : '',Separator);'#13#10'    '
  +'   CurChar := S[Cur];'#13#10'       if Pos(CurChar,Digits)>0 then'#13#10'  '
  +'     begin//Digits'#13#10'         //HH, MM, SS, or Msec?'#13#10'         /'
  +'/ writeln(''Digit: '', CurChar);'#13#10'         //Digits are only allowed '
  +'after starting Am/PM or at beginning of string or after Separator'#13#10'  '
  +'       //and TimeIndex must be <= tiMSec'#13#10'         //Uncomment "or (#'
  +'32 = Separator)" and it will allllow #32 as separator'#13#10'         if (n'
  +'ot (DigitPending {or (#32 = Separator)})) or (TimeIndex > tiMSec) then'#13
  +#10'            begin'#13#10'            // Writeln(''DigitPending'',ElemLen'
  +');'#13#10'            Exit;'#13#10'            end;'#13#10'         OffSet '
  +':= Cur;'#13#10'         if (CurChar <> ''0'') then FirstSignificantDigit :='
  +' OffSet else FirstSignificantDigit := -1;'#13#10'         while (Cur < Len)'
  +' and (Pos(S[Cur + 1],Digits)>0) do'#13#10'         begin'#13#10'           '
  +'//Mark first Digit that is not ''0'''#13#10'           if (FirstSignificant'
  +'Digit = -1) and (S[Cur] <> ''0'') then FirstSignificantDigit := Cur;'#13#10
  +'           Inc(Cur);'#13#10'         end;'#13#10'         if (FirstSignific'
  +'antDigit = -1) then FirstSignificantDigit := Cur;'#13#10'         ElemLen :'
  +'= 1+ Cur - FirstSignificantDigit;'#13#10'         // writeln(''  S[FirstSig'
  +'nificantDigit] = '',S[FirstSignificantDigit], '' S[Cur] = '',S[Cur],'' Elem'
  +'Len = '',ElemLen,'' -> '', S[Offset], ElemLen);'#13#10'         // writeln('
  +'''  Cur = '',Cur);'#13#10'         //this way we know that Val() will never'
  +' overflow Value !'#13#10'         if (ElemLen <= 2) or ((ElemLen <= 3) and '
  +'(TimeIndex = tiMSec) ) then'#13#10'         begin'#13#10'           Val(Cop'
  +'y(S,FirstSignificantDigit, ElemLen), Value, Err);'#13#10'           // writ'
  +'eln(''  Value = '',Value,'' HH = '',TimeValues[0],'' MM = '',TimeValues[1],'
  +''' SS = '',TimeValues[2],'' MSec = '',Timevalues[3]);'#13#10'           //T'
  +'his is safe now, because we know Value < High(Word)'#13#10'           TimeV'
  +'alues[TimeIndex] := Value;'#13#10'           Inc(TimeIndex);'#13#10'       '
  +'    DigitPending := False;'#13#10'         end'#13#10'         else'#13#10
  +'           begin'#13#10'           // Writeln(''Wrong elemlen: '',ElemLen, '
  +''' timeIndex: '',timeindex);'#13#10'           Exit; //Value to big, so it '
  +'must be a wrong timestring'#13#10'           end;'#13#10'       end//Digits'
  +#13#10'       else if (CurChar = #32) then'#13#10'       begin'#13#10'      '
  +'   //writeln(''#32'');'#13#10'         //just skip, but we must adress this'
  +', or it will be parsed by either AM/PM or Separator'#13#10'       end'#13#10
  +'       else if (CurChar = Separator) then'#13#10'       begin'#13#10'      '
  +'   // writeln(''Separator '',Separator);'#13#10'         if DigitPending or'
  +' (TimeIndex > tiSec) then'#13#10'           begin'#13#10'           // Writ'
  +'eln (''DigitPending '',DigitPending,'' or (TimeIndex'',Timeindex,'' > tiSec'
  +','', tiSec,'')'');'#13#10'           Exit;'#13#10'           end;'#13#10'  '
  +'       DigitPending := True;'#13#10'         MSecPending := False;'#13#10' '
  +'      end'#13#10'       else if (CurChar = DecimalSeparator) then'#13#10'  '
  +'     begin'#13#10'         //writeln(''DecimalSeparator'');'#13#10'        '
  +' if DigitPending or MSecPending or (TimeIndex <> tiMSec) then'#13#10'      '
  +'      begin'#13#10'            // Writeln(''DigitPending '',DigitPending,'''
  +' or MSecPending '',MSecPending,'' ('',TimeIndex,'',Timeindex, >'', tiMSec,'
  +'''  tiSec)'');'#13#10'            Exit;'#13#10'            end;'#13#10'    '
  +'     DigitPending := True;'#13#10'         MSecPending := True;'#13#10'    '
  +'   end'#13#10'       else'#13#10'       begin//AM/PM?'#13#10'         //Non'
  +'e of the above, so this char _must_ be the start of AM/PM string'#13#10'   '
  +'      //If we already have found AM/PM or we expect a digit then then times'
  +'tring must be wrong at this point'#13#10'         //writeln(''AM/PM?'');'#13
  +#10'         if (AmPm <> AMPM_None) or DigitPending then'#13#10'           b'
  +'egin'#13#10'           // Writeln(''AmPm <> AMPM_None) or DigitPending'');'
  +#13#10'           Exit;'#13#10'           end;'#13#10'         OffSet := Cur'
  +';'#13#10'         allowedchars:=DecimalSeparator+'' '';'#13#10'         if '
  +'Separator<>#0 then'#13#10'           allowedchars:=allowedchars+Separator;'
  +#13#10'         while (Cur < Len -1) and (Pos(S[Cur + 1],AllowedChars)=0)'#13
  +#10'           and (Pos(S[Cur + 1],Digits)=0) do Inc(Cur);'#13#10'         E'
  ,'lemLen := 1 + Cur - OffSet;'#13#10'         // writeln(''  S[Offset] = '',S'
  +'[1+Offset], '' S[Cur] = '',S[Cur],'' ElemLen = '',ElemLen,'' -> '', S[1+Off'
  +'set], ElemLen);'#13#10'         // writeln(''  Cur = '',Cur, ''S ='',S);'#13
  +#10'         AmPmStr := Copy(S,1+OffSet, ElemLen);'#13#10#13#10'         // '
  +'writeln(''AmPmStr = '',ampmstr,'' ('',length(ampmstr),'')'');'#13#10'      '
  +'   //We must compare to TimeAMString before hardcoded ''AM'' for delphi com'
  +'patibility'#13#10'         //Also it is perfectly legal, though insane to h'
  +'ave TimeAMString = ''PM'' and vice versa'#13#10'         if (CompareText(Am'
  +'PmStr, TimeAMString) = 0) then AmPm := AMPM_AM'#13#10'         else if (Com'
  +'pareText(AmPmStr, TimePMString) = 0) then AmPm := AMPM_PM'#13#10'         e'
  +'lse if (CompareText(AmPmStr, ''AM'') = 0) then AmPm := AMPM_AM'#13#10'     '
  +'    else if (CompareText(AmPmStr, ''PM'') = 0) then AmPm := AMPM_PM'#13#10
  +'         else'#13#10'           begin'#13#10'           // Writeln(''No tim'
  +'estring '',AmPmStr);'#13#10'           Exit; //If text does not match any o'
  +'f these, timestring must be wrong;'#13#10'           end;'#13#10'         /'
  +'/if AM/PM is at beginning of string, then a digit is mandatory after it'#13
  +#10'         if (TimeIndex = tiHour) then'#13#10'         begin'#13#10'     '
  +'      DigitPending := True;'#13#10'         end'#13#10'         //otherwise'
  +', no more TimeValues allowed after this'#13#10'         else'#13#10'       '
  +'  begin'#13#10'           TimeIndex := tiMSec + 1;'#13#10'           DigitP'
  +'ending := False;'#13#10'         end;'#13#10'       end;//AM/PM'#13#10'    '
  +'   Inc(Cur)'#13#10'     end;//while'#13#10#13#10'     //If we arrive here, '
  +'parsing the elements has been successfull'#13#10'     //if not at least Hou'
  +'rs specified then input is not valid'#13#10'     //when am/pm is specified '
  +'Hour must be <= 12 and not 0'#13#10'     if (TimeIndex = tiHour) or ((AmPm '
  +'<> AMPM_None) and ((TimeValues[tiHour] > 12) or (TimeValues[tiHour] = 0))) '
  +'or DigitPending then'#13#10'       Exit;'#13#10'     Result := True;'#13#10
  +'   end;'#13#10#13#10'begin'#13#10'  setlength(timevalues,4);'#13#10'  if se'
  +'parator = #0 then'#13#10'     if (TimeSeparator<>#0) then'#13#10'       sep'
  +'arator := TimeSeparator'#13#10'      else'#13#10'       separator:='':'';'
  +#13#10'  AmPm := AMPM_None;'#13#10'  if not SplitElements(TimeValues, AmPm) '
  +'then'#13#10'  begin'#13#10'    ErrorMsg:=Format(SErrInvalidTimeFormat,[S]);'
  +#13#10'    Exit;'#13#10'  end;'#13#10'  if (AmPm=AMPM_PM) and (TimeValues[ti'
  +'Hour]<>12) then Inc(TimeValues[tiHour], 12)'#13#10'  else if (AmPm=AMPM_AM)'
  +' and (TimeValues[tiHour]=12) then TimeValues[tiHour]:=0;'#13#10'  // Writel'
  +'n(      TimeValues[tiHour], TimeValues[tiMin], TimeValues[tiSec], TimeValue'
  +'s[tiMSec]);'#13#10'  if not TryEncodeTime(TimeValues[tiHour], TimeValues[ti'
  +'Min], TimeValues[tiSec], TimeValues[tiMSec], result) Then'#13#10#13#10'    '
  +'ErrorMsg:=Format(SErrInvalidTimeFormat,[S]);'#13#10'end ;'#13#10#13#10'func'
  +'tion StrToTime(const s: String; separator : char): TDateTime;'#13#10#13#10
  +'Var'#13#10'  Msg : String;'#13#10#13#10'begin'#13#10'  Result:=IntStrToTime'
  +'(Msg,S,Length(S),Separator);'#13#10'  If (Msg<>'''') then'#13#10'    Raise '
  +'EConvertError.Create(Msg);'#13#10'end;'#13#10#13#10'function StrToTime(cons'
  +'t s: String): TDateTime;'#13#10'begin'#13#10'   result:= StrToTime(s, TimeS'
  +'eparator);'#13#10'end;'#13#10#13#10'{   StrToDateTime converts the string S'
  +' to a TDateTime value'#13#10'    if S does not represent a valid date and/o'
  +'r time value'#13#10'    an EConvertError will be raised   }'#13#10#13#10'fu'
  +'nction SplitDateTimeStr(DateTimeStr: String; out DateStr, TimeStr: String):'
  +' Integer;'#13#10#13#10'{ Helper function for StrToDateTime'#13#10'  Pre-con'
  +'dition'#13#10'    Date is before Time'#13#10'    If either Date or Time is '
  +'omitted then see what fits best, a time or a date (issue #0020522)'#13#10' '
  +'   Date and Time are separated by whitespace (space Tab, Linefeed or carria'
  +'ge return)'#13#10'    FS.DateSeparator can be the same as FS.TimeSeparator '
  +'(issue #0020522)'#13#10'    If they are both #32 and TrimWhite(DateTimeStr)'
  +' contains a #32 a date is assumed.'#13#10'  Post-condition'#13#10'    DateS'
  +'tr holds date as string or is empty'#13#10'    TimeStr holds time as string'
  +' or is empty'#13#10'    Result = number of strings returned, 0 = error'#13
  +#10'}'#13#10'const'#13#10'  WhiteSpace = #9#10#13#32;'#13#10#13#10'var'#13#10
  +'  p: Integer;'#13#10'  DummyDT: TDateTime;'#13#10'begin'#13#10'  Result := '
  +'0;'#13#10'  DateStr := '''';'#13#10'  TimeStr := '''';'#13#10'  DateTimeStr'
  +' := Trim(DateTimeStr);'#13#10'  if Length(DateTimeStr) = 0 then exit;'#13#10
  +'  if (DateSeparator = #32) and (TimeSeparator = #32) and (Pos(#32, DateTime'
  +'Str) > 0) then'#13#10'    begin'#13#10'    DateStr:=DateTimeStr;'#13#10'   '
  +' {'#13#10'      Assume a date: dd [mm [yy]].'#13#10'      Really fancy woul'
  ,'d be counting the number of whitespace occurrences and decide'#13#10'      '
  +'and split accordingly'#13#10'    }'#13#10'    Exit(1);'#13#10'    end;'#13
  +#10'  p:=1;'#13#10'  //find separator'#13#10'  if (DateSeparator<>#32) then'
  +#13#10'    begin'#13#10'    while (p<Length(DateTimeStr)) and (not (Pos(Date'
  +'TimeStr[p+1],WhiteSpace)>0)) do'#13#10'      Inc(p);'#13#10'    end'#13#10
  +'  else'#13#10'    begin'#13#10'    p:=Pos(TimeSeparator, DateTimeStr);'#13
  +#10'    if (p<>0) then'#13#10'      repeat'#13#10'        Dec(p);'#13#10'   '
  +'   until (p=0) or (Pos(DateTimeStr[p],WhiteSpace)>0);'#13#10'    end;'#13#10
  +'  //Always fill DateStr, it eases the algorithm later'#13#10'  if (p=0) the'
  +'n'#13#10'    p:=Length(DateTimeStr);'#13#10'  DateStr:=Copy(DateTimeStr,1,p'
  +');'#13#10'  TimeStr:=Trim(Copy(DateTimeStr,p+1,100));'#13#10'  if (Length(T'
  +'imeStr)<>0) then'#13#10'    Result:=2'#13#10'  else'#13#10'    begin'#13#10
  +'    Result:=1; //found 1 string'#13#10'    // 2 cases when DateTimeStr only'
  +' contains a time:'#13#10'    // Date/time separator differ, and string cont'
  +'ains a timeseparator'#13#10'    // Date/time separators are equal, but tran'
  +'sformation to date fails.'#13#10'    if ((DateSeparator<>TimeSeparator) and'
  +' (Pos(TimeSeparator,DateStr) > 0))'#13#10'       or ((DateSeparator=TimeSep'
  +'arator) and (not TryStrToDate(DateStr, DummyDT)))  then'#13#10'      begin'
  +#13#10'      TimeStr := DateStr;'#13#10'      DateStr := '''';'#13#10'      '
  +'end;'#13#10'    end;'#13#10'end;'#13#10#13#10'function StrToDateTime(const '
  +'s: String): TDateTime;'#13#10#13#10'var'#13#10'  TimeStr, DateStr: String;'
  +#13#10'  PartsFound: Integer;'#13#10'begin'#13#10'  PartsFound := SplitDateT'
  +'imeStr(S, DateStr, TimeStr);'#13#10'  case PartsFound of'#13#10'    0: Resu'
  +'lt:=StrToDate('''');'#13#10'    1: if (Length(DateStr) > 0) then'#13#10'   '
  +'      Result := StrToDate(DateStr,ShortDateFormat,DateSeparator)'#13#10'   '
  +'    else'#13#10'         Result := StrToTime(TimeStr);'#13#10'    2: Result'
  +' := ComposeDateTime(StrTodate(DateStr,ShortDateFormat,DateSeparator),'#13#10
  +'                                  StrToTime(TimeStr));'#13#10'  end;'#13#10
  +'end;'#13#10#13#10'Function FormatDateTime(const FormatStr: string; const Da'
