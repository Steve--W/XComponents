  +'x],Delimiters)<>0; // Note we don''t do MBCS yet'#13#10'end;'#13#10#13#10'f'
  +'unction AdjustLineBreaks(const S: string): string;'#13#10#13#10'begin'#13#10
  +'  Result:=AdjustLineBreaks(S,DefaultTextLineBreakStyle);'#13#10'end;'#13#10
  +#13#10'function AdjustLineBreaks(const S: string; Style: TTextLineBreakStyle'
  +'): string;'#13#10#13#10'var'#13#10'  I,L: Longint;'#13#10'  Res : String;'
  +#13#10#13#10'  Procedure Add(C  : Char);'#13#10'  begin'#13#10'    Res:=Res+'
  +'C;'#13#10'  end;'#13#10#13#10'begin'#13#10'  I:=0;'#13#10'  L:=Length(S);'
  +#13#10'  Result:='''';'#13#10'  While (I<=L) do'#13#10'    case S[I] of'#13
  +#10'      #10: begin'#13#10'          if Style in [tlbsCRLF,tlbsCR] then'#13
  +#10'            Add(#13);'#13#10'          if Style=tlbsCRLF then'#13#10'   '
  +'         Add(#10);'#13#10'          Inc(I);'#13#10'          end;'#13#10'  '
  +'   #13: begin'#13#10'          if Style=tlbsCRLF then'#13#10'            Ad'
  +'d(#13);'#13#10'          Add(#10);'#13#10'          Inc(I);'#13#10'        '
  +'  if S[I]=#10 then'#13#10'            Inc(I);'#13#10'          end;'#13#10
  +'    else'#13#10'      Add(S[i]);'#13#10'      Inc(I);'#13#10'    end;'#13#10
  +'  Result:=Res;'#13#10'end;'#13#10#13#10'function WrapText(const Line, Break'
  +'Str: string; const BreakChars: Array of char;  MaxCol: Integer): string;'#13
  +#10#13#10'const'#13#10'  Quotes = ['''''''', ''"''];'#13#10#13#10'Var'#13#10
  +'  L : String;'#13#10'  C,LQ,BC : Char;'#13#10'  P,BLen,Len : Integer;'#13#10
  +'  HB,IBC : Boolean;'#13#10#13#10'begin'#13#10'  Result:='''';'#13#10'  L:=L'
  +'ine;'#13#10'  Blen:=Length(BreakStr);'#13#10'  If (BLen>0) then'#13#10'    '
  +'BC:=BreakStr[1]'#13#10'  else'#13#10'    BC:=#0;'#13#10'  Len:=Length(L);'
  +#13#10'  While (Len>0) do'#13#10'    begin'#13#10'    P:=1;'#13#10'    LQ:=#'
  +'0;'#13#10'    HB:=False;'#13#10'    IBC:=False;'#13#10'    While ((P<=Len) '
  +'and ((P<=MaxCol) or not IBC)) and ((LQ<>#0) or Not HB) do'#13#10'      begi'
  +'n'#13#10'      C:=L[P];'#13#10'      If (C=LQ) then'#13#10'        LQ:=#0'
  +#13#10'      else If (C in Quotes) then'#13#10'        LQ:=C;'#13#10'      I'
  +'f (LQ<>#0) then'#13#10'        Inc(P)'#13#10'      else'#13#10'        begi'
  +'n'#13#10'        HB:=((C=BC) and (BreakStr=Copy(L,P,BLen)));'#13#10'       '
  ,' If HB then'#13#10'          Inc(P,Blen)'#13#10'        else'#13#10'       '
  +'   begin'#13#10'          If (P>=MaxCol) then'#13#10'            IBC:=CharI'
  +'nSet(C,BreakChars);'#13#10'          Inc(P);'#13#10'          end;'#13#10' '
  +'       end;'#13#10'//      Writeln(''"'',C,''" : IBC : '',IBC,'' HB  : '',H'
  +'B,'' LQ  : '',LQ,'' P>MaxCol : '',P>MaxCol);'#13#10'      end;'#13#10'    R'
  +'esult:=Result+Copy(L,1,P-1);'#13#10'    Delete(L,1,P-1);'#13#10'    Len:=Le'
  +'ngth(L);'#13#10'    If (Len>0) and Not HB then'#13#10'      Result:=Result+'
  +'BreakStr;'#13#10'    end;'#13#10'end;'#13#10#13#10'function WrapText(const '
  +'Line: string; MaxCol: Integer): string;'#13#10#13#10'begin'#13#10'  Result:'
  +'=WrapText(Line,sLineBreak, ['' '', ''-'', #9], MaxCol);'#13#10'end;'#13#10
  +#13#10#13#10'function GetEnvironmentVariable(const EnvVar: String): String;'
  +#13#10'begin'#13#10'  if Assigned(OnGetEnvironmentVariable) then'#13#10'    '
  +'Result:=OnGetEnvironmentVariable(EnvVar)'#13#10'  else'#13#10'    Result:='
  +''''';'#13#10'end;'#13#10#13#10'function GetEnvironmentVariableCount: Intege'
  +'r;'#13#10'begin'#13#10'  if Assigned(OnGetEnvironmentVariableCount) then'#13
  +#10'    Result:=OnGetEnvironmentVariableCount()'#13#10'  else'#13#10'    Res'
  +'ult:=0;'#13#10'end;'#13#10#13#10'function GetEnvironmentString(Index: Integ'
  +'er): String;'#13#10'begin'#13#10'  if Assigned(OnGetEnvironmentString) then'
  +#13#10'    Result:=OnGetEnvironmentString(Index)'#13#10'  else'#13#10'    Re'
  +'sult:='''';'#13#10'end;'#13#10#13#10'{ Date/Time routines}'#13#10#13#10'Fun'
  +'ction DoEncodeDate(Year, Month, Day: Word): longint;'#13#10#13#10'Var'#13#10
  +'  D : TDateTime;'#13#10#13#10'begin'#13#10'  If TryEncodeDate(Year,Month,Da'
  +'y,D) then'#13#10'    Result:=Trunc(D)'#13#10'  else'#13#10'    Result:=0;'
  +#13#10'end;'#13#10#13#10'function DoEncodeTime(Hour, Minute, Second, MilliSe'
  +'cond: word): TDateTime;'#13#10#13#10'begin'#13#10'  If not TryEncodeTime(Ho'
  +'ur,Minute,Second,MilliSecond,Result) then'#13#10'    Result:=0;'#13#10'end;'
  +#13#10#13#10'Function DateTimeToJSDate(aDateTime : TDateTime) : TJSDate;'#13
  +#10#13#10'Var'#13#10'  Y,M,D,h,n,s,z : Word;'#13#10#13#10'begin'#13#10'  Dec'
  +'odeDate(Trunc(aDateTime),Y,M,D);'#13#10'  DecodeTime(Frac(aDateTime),H,N,S,'
  +'Z);'#13#10'  Result:=TJSDate.New(Y,M,D,h,n,s,z);'#13#10'end;'#13#10#13#10'F'
  +'unction JSDatetoDateTime(ADate: TJSDate) : TDateTime;'#13#10#13#10'begin'#13
  +#10'  Result:=EncodeDate(ADate.FullYear,ADate.Month+1,ADate.Date) +'#13#10' '
  +'         EncodeTime(ADate.Hours,ADate.Minutes,ADate.Seconds,ADate.Milliseco'
  +'nds);'#13#10'end;'#13#10#13#10#13#10'{   ComposeDateTime converts a Date an'
  +'d a Time into one TDateTime   }'#13#10'function ComposeDateTime(Date,Time :'
  +' TDateTime) : TDateTime;'#13#10#13#10'begin'#13#10'  if Date < 0 then'#13#10
  +'    Result := trunc(Date) - Abs(frac(Time))'#13#10'  else'#13#10'    Result'
  +' := trunc(Date) + Abs(frac(Time));'#13#10'end;'#13#10#13#10'Function TryEnc'
  +'odeDate(Year,Month,Day : Word; Out Date : TDateTime) : Boolean;'#13#10#13#10
  +'var'#13#10'  c, ya: LongWord;'#13#10'begin'#13#10'  Result:=(Year>0) and (Y'
  +'ear<10000) and'#13#10'          (Month >= 1) and (Month<=12) and'#13#10'   '
  +'       (Day>0) and (Day<=MonthDays[IsleapYear(Year),Month]);'#13#10' If Res'
  +'ult then'#13#10'   begin'#13#10'     if month > 2 then'#13#10'      Dec(Mon'
  +'th,3)'#13#10'     else'#13#10'      begin'#13#10'        Inc(Month,9);'#13
  +#10'        Dec(Year);'#13#10'      end;'#13#10'     c:= Year DIV 100;'#13#10
  +'     ya:= Year - 100*c;'#13#10'     Date := (146097*c) SHR 2 + (1461*ya) SH'
  +'R 2 + (153*LongWord(Month)+2) DIV 5 + LongWord(Day);'#13#10'     // Note th'
  +'at this line can''t be part of the line above, since TDateTime is'#13#10'  '
  +'   // signed and c and ya are not'#13#10'     Date := Date - 693900;'#13#10
  +'   end'#13#10'end;'#13#10#13#10'function TryEncodeTime(Hour, Min, Sec, MSec'
  +':word; Out Time : TDateTime) : boolean;'#13#10#13#10'begin'#13#10'  Result:'
  +'=(Hour<24) and (Min<60) and (Sec<60) and (MSec<1000);'#13#10'  If Result th'
  +'en'#13#10'    Time:=TDateTime(LongWord(Hour)*3600000+LongWord(Min)*60000+Lo'
  +'ngWord(Sec)*1000+MSec)/MSecsPerDay;'#13#10'end;'#13#10#13#10'{   EncodeDate'
  +' packs three variables Year, Month and Day into a'#13#10'    TDateTime valu'
  +'e the result is the number of days since 12/30/1899   }'#13#10#13#10'functi'
  +'on EncodeDate(Year, Month, Day: word): TDateTime;'#13#10#13#10'begin'#13#10
  +'  If Not TryEncodeDate(Year,Month,Day,Result) then'#13#10'    Raise EConver'
  +'tError.CreateFmt(''%s-%s-%s is not a valid date specification'','#13#10'   '
  +'                           [IntToStr(Year),IntToStr(Month),IntToStr(Day)]);'
  +#13#10'end;'#13#10#13#10'{   EncodeTime packs four variables Hour, Minute, S'
  +'econd and MilliSecond into'#13#10'    a TDateTime value     }'#13#10#13#10
  +'function EncodeTime(Hour, Minute, Second, MilliSecond:word):TDateTime;'#13
  +#10#13#10'begin'#13#10'  If not TryEncodeTime(Hour,Minute,Second,MilliSecond'
  ,',Result) then'#13#10'    Raise EConvertError.CreateFmt(''%s:%s:%s.%s is not'
  +' a valid time specification'','#13#10'                              [IntToS'
  +'tr(Hour),IntToStr(Minute),IntToStr(Second),IntToStr(MilliSecond)]);'#13#10
  +'end;'#13#10#13#10#13#10'{   DecodeDate unpacks the value Date into three va'
  +'lues:'#13#10'    Year, Month and Day   }'#13#10#13#10'procedure DecodeDate('
  +'Date: TDateTime; out Year, Month, Day: word);'#13#10'var'#13#10'  ly,ld,lm,'
  +'j : LongWord;'#13#10'begin'#13#10'  if Date <= -datedelta then  // If Date '
  +'is before 1-1-1 then return 0-0-0'#13#10'    begin'#13#10'    Year := 0;'#13
  +#10'    Month := 0;'#13#10'    Day := 0;'#13#10'    end'#13#10'  else'#13#10
  +'    begin'#13#10'    if Date>0 then'#13#10'      Date:=(Date+(1/(msecsperda'
  +'y*2)))'#13#10'    else'#13#10'      Date:=Date-(1/(msecsperday*2));'#13#10
  +'    if Date>MaxDateTime then'#13#10'      Date:=MaxDateTime;'#13#10'//     '
  +'  Raise EConvertError.CreateFmt(''%f is not a valid TDatetime encoding, max'
  +'imum value is %f.'',[Date,MaxDateTime]);'#13#10'    j := ((Trunc(Date) + 69'
  +'3900) SHL 2)-1;'#13#10'    ly:= j DIV 146097;'#13#10'    j:= j - 146097 * L'
  +'ongWord(ly);'#13#10'    ld := j SHR 2;'#13#10'    j:=(ld SHL 2 + 3) DIV 146'
  +'1;'#13#10'    ld:= ((ld SHL 2) + 7 - 1461*j) SHR 2;'#13#10'    lm:=(5 * ld-'
  +'3) DIV 153;'#13#10'    ld:= (5 * ld +2 - 153*lm) DIV 5;'#13#10'    ly:= 100'
  +' * LongWord(ly) + j;'#13#10'    if lm < 10 then'#13#10'     inc(lm,3)'#13#10
  +'    else'#13#10'      begin'#13#10'        dec(lm,9);'#13#10'        inc(ly'
  +');'#13#10'      end;'#13#10'    year:=ly;'#13#10'    month:=lm;'#13#10'    '
  +'day:=ld;'#13#10'    end;'#13#10'end;'#13#10#13#10#13#10'function DecodeDate'
  +'Fully(const DateTime: TDateTime; out Year, Month, Day, DOW: Word): Boolean;'
  +#13#10'begin'#13#10'  DecodeDate(DateTime,Year,Month,Day);'#13#10'  DOW:=Day'
  +'OfWeek(DateTime);'#13#10'  Result:=IsLeapYear(Year);'#13#10'end;'#13#10'  {'
  +'   DateTimeToTimeStamp converts DateTime to a TTimeStamp   }'#13#10#13#10'f'
  +'unction DateTimeToTimeStamp(DateTime: TDateTime): TTimeStamp;'#13#10#13#10
  +'Var'#13#10'  D : Double;'#13#10'begin'#13#10'  D:=DateTime * Double(MSecsPe'
  +'rDay);'#13#10'  if D<0 then'#13#10'    D:=D-0.5'#13#10'  else'#13#10'    D:'
  +'=D+0.5;'#13#10'  result.Time := Trunc(Abs(Trunc(D)) Mod MSecsPerDay);'#13#10
  +'  result.Date := DateDelta + (Trunc(D) div MSecsPerDay);'#13#10'end;'#13#10
  +#13#10'{   TimeStampToDateTime converts TimeStamp to a TDateTime value   }'
  +#13#10#13#10'function TimeStampToDateTime(const TimeStamp: TTimeStamp): TDat'
  +'eTime;'#13#10'begin'#13#10'  Result := ComposeDateTime(TimeStamp.Date - Dat'
  +'eDelta,TimeStamp.Time/MSecsPerDay)'#13#10'end;'#13#10#13#10'{   MSecsToTime'
  +'Stamp   }'#13#10#13#10'function MSecsToTimeStamp(MSecs: NativeInt): TTimeSt'
  +'amp;'#13#10'begin'#13#10'  result.Date := Trunc(msecs/msecsperday);'#13#10
  +'  msecs:= msecs-NativeInt(result.date)*msecsperday;'#13#10'  result.Time :='
  +' Round(MSecs);'#13#10'end;'#13#10#13#10'function TimeStampToMSecs(const Tim'
  +'eStamp: TTimeStamp): NativeInt;'#13#10'begin'#13#10'  result := TimeStamp.T'
  +'ime + (timestamp.date*msecsperday);'#13#10'end ;'#13#10#13#10#13#10#13#10'{'
  +'   DecodeTime unpacks Time into four values:'#13#10'    Hour, Minute, Secon'
  +'d and MilliSecond    }'#13#10#13#10'procedure DecodeTime(Time: TDateTime; o'
  +'ut Hour, Minute, Second, MilliSecond: word);'#13#10'Var'#13#10'  l : LongWo'
  +'rd;'#13#10'begin'#13#10'  l := DateTimeToTimeStamp(Time).Time;'#13#10'  Hou'
  +'r   := l div 3600000;'#13#10'  l := l mod 3600000;'#13#10'  Minute := l div'
  +' 60000;'#13#10'  l := l mod 60000;'#13#10'  Second := l div 1000;'#13#10'  '
  +'l := l mod 1000;'#13#10'  MilliSecond := l;'#13#10'end;'#13#10#13#10'{   Da'
  +'teTimeToSystemTime converts DateTime value to SystemTime   }'#13#10#13#10'p'
  +'rocedure DateTimeToSystemTime(DateTime: TDateTime; out SystemTime: TSystemT'
  +'ime);'#13#10'begin'#13#10'  DecodeDateFully(DateTime, SystemTime.Year, Syst'
  +'emTime.Month, SystemTime.Day,SystemTime.DayOfWeek);'#13#10'  DecodeTime(Dat'
  +'eTime, SystemTime.Hour, SystemTime.Minute, SystemTime.Second, SystemTime.Mi'
  +'lliSecond);'#13#10'  Dec(SystemTime.DayOfWeek);'#13#10'end ;'#13#10#13#10'{'
  +'   SystemTimeToDateTime converts SystemTime to a TDateTime value   }'#13#10
  +#13#10'function SystemTimeToDateTime(const SystemTime: TSystemTime): TDateTi'
  +'me;'#13#10'begin'#13#10'  result := ComposeDateTime(DoEncodeDate(SystemTime'
  +'.Year, SystemTime.Month, SystemTime.Day),'#13#10'                          '
  +'  DoEncodeTime(SystemTime.Hour, SystemTime.Minute, SystemTime.Second, Syste'
  +'mTime.MilliSecond));'#13#10'end ;'#13#10#13#10'function DayOfWeek(DateTime:'
  +' TDateTime): integer;'#13#10'begin'#13#10'  Result := 1 + ((Trunc(DateTime)'
  +' - 1) mod 7);'#13#10'  If (Result<=0) then'#13#10'    Inc(Result,7);'#13#10
  +'end;'#13#10#13#10#13#10#13#10'function Now: TDateTime;'#13#10'begin'#13#10
  +'  Result:=JSDateToDateTime(TJSDate.New());'#13#10'end;'#13#10#13#10'functio'
  ,'n Date: TDateTime;'#13#10#13#10'begin'#13#10'  Result:=Trunc(Now);'#13#10'e'
  +'nd;'#13#10#13#10'function Time: TDateTime;'#13#10'begin'#13#10'  Result:=No'
  +'w-Date;'#13#10'end ;'#13#10#13#10'{   IncMonth increments DateTime with Num'
  +'berOfMonths months,'#13#10'    NumberOfMonths can be less than zero   }'#13
  +#10#13#10'function IncMonth(const DateTime: TDateTime; NumberOfMonths: integ'
  +'er = 1 ): TDateTime;'#13#10'var'#13#10'  Year, Month, Day : word;'#13#10'be'
  +'gin'#13#10'  DecodeDate(DateTime, Year, Month, Day);'#13#10'  IncAMonth(Yea'
  +'r, Month, Day, NumberOfMonths);'#13#10'  result := ComposeDateTime(DoEncode'
  +'Date(Year, Month, Day), DateTime);'#13#10'end ;'#13#10#13#10'{   IncAMonth '
  +'is the same as IncMonth, but operates on decoded date  }'#13#10#13#10'proce'
  +'dure IncAMonth(var Year, Month, Day: Word; NumberOfMonths: Integer = 1);'#13
  +#10'var'#13#10'  TempMonth, S: Integer;'#13#10'begin'#13#10'  If NumberOfMon'
  +'ths>=0 then'#13#10'    s:=1'#13#10'  else'#13#10'    s:=-1;'#13#10'  inc(Ye'
  +'ar,(NumberOfMonths div 12));'#13#10'  TempMonth:=Month+(NumberOfMonths mod '
  +'12)-1;'#13#10'  if (TempMonth>11) or'#13#10'     (TempMonth<0) then'#13#10
  +'   begin'#13#10'     Dec(TempMonth, S*12);'#13#10'     Inc(Year, S);'#13#10
  +'   end;'#13#10'  Month:=TempMonth+1;          {   Months from 1 to 12   }'
  +#13#10'  If (Day>MonthDays[IsLeapYear(Year)][Month]) then'#13#10'    Day:=Mo'
  +'nthDays[IsLeapYear(Year)][Month];'#13#10'end;'#13#10#13#10'{  IsLeapYear re'
  +'turns true if Year is a leap year   }'#13#10#13#10'function IsLeapYear(Year'
  +': Word): boolean;'#13#10'begin'#13#10'  Result := (Year mod 4 = 0) and ((Ye'
  +'ar mod 100 <> 0) or (Year mod 400 = 0));'#13#10'end;'#13#10#13#10'{  DateTo'
  +'Str returns a string representation of Date using ShortDateFormat   }'#13#10
  +#13#10'function DateToStr(Date: TDateTime): string;'#13#10'begin'#13#10'  Re'
  +'sult:=FormatDateTime(''ddddd'', Date);'#13#10'end ;'#13#10#13#10'{  TimeToS'
  +'tr returns a string representation of Time using LongTimeFormat   }'#13#10
  +#13#10'function TimeToStr(Time: TDateTime): string;'#13#10'begin'#13#10'  Re'
  +'sult:=FormatDateTime(''tt'',Time);'#13#10'end ;'#13#10#13#10'{   DateTimeTo'
  +'Str returns a string representation of DateTime using LongDateTimeFormat   '
  +'}'#13#10#13#10'Var'#13#10'  DateTimeToStrFormat : Array[Boolean] of string '
  +'= (''c'',''f'');'#13#10#13#10'function DateTimeToStr(DateTime: TDateTime; F'
  +'orceTimeIfZero : Boolean = False): string;'#13#10'begin'#13#10'  Result:=Fo'
  +'rmatDateTime(DateTimeToStrFormat[ForceTimeIfZero], DateTime)'#13#10'end ;'
  +#13#10#13#10#13#10'{   StrToDate converts the string S to a TDateTime value'
  +#13#10'    if S does not represent a valid date value'#13#10'    an EConvert'
  +'Error will be raised   }'#13#10#13#10'function IntStrToDate(Out ErrorMsg : '
  +'String; const S: String; const useformat : string; separator : char): TDate'
  +'Time;'#13#10#13#10'Const'#13#10'  WhiteSpace = '' ''#8#9#10#12#13;'#13#10' '
  +' Digits = ''0123456789'';'#13#10#13#10'  procedure FixErrorMsg(const errmar'
  +'g : String);'#13#10#13#10'  begin'#13#10'    ErrorMsg:=Format(SInvalidDateF'
  +'ormat,[errmarg]);'#13#10'  end;'#13#10#13#10'var'#13#10'   df:string;'#13#10
  +'   d,m,y,ly,ld,lm:word;'#13#10'   n,i,len:longint;'#13#10'   c: integer;'#13
  +#10'   dp,mp,yp,which : Byte;'#13#10'   s1:string;'#13#10'   values: array o'
  +'f integer;'#13#10'   YearMoreThenTwoDigits : boolean;'#13#10#13#10'begin'#13
  +#10'  SetLength(values,4);'#13#10'  Result:=0;'#13#10'  Len:=Length(S);'#13
  +#10'  ErrorMsg:='''';'#13#10'  While (Len>0) and (Pos(S[Len],WhiteSpace)>0) '
  +'do'#13#10'    Dec(len);'#13#10'  if (Len=0) then'#13#10'    begin'#13#10'  '
  +'  FixErrorMsg(S);'#13#10'    exit;'#13#10'    end;'#13#10'  YearMoreThenTwo'
  +'Digits := False;'#13#10'  if separator = #0 then'#13#10'    if (DateSeparat'
  +'or<>#0) then'#13#10'      separator := DateSeparator'#13#10'    else'#13#10
  +'      separator:=''-'';'#13#10'  // Writeln(''Separator: '',Separator);'#13
  +#10'  df := UpperCase(useFormat);'#13#10'  { Determine order of D,M,Y }'#13
  +#10'  yp:=0;'#13#10'  mp:=0;'#13#10'  dp:=0;'#13#10'  Which:=0;'#13#10'  i:='
  +'0;'#13#10'  while (i<Length(df)) and (Which<3) do'#13#10'   begin'#13#10'  '
  +'   inc(i);'#13#10'     Case df[i] of'#13#10'       ''Y'' :'#13#10'         '
  +'if yp=0 then'#13#10'          begin'#13#10'            Inc(Which);'#13#10' '
