  +#10'  end;'#13#10'end;'#13#10#13#10'procedure PushNodeSourcesToAttributes(Fr'
  +'omNode:TDataNode);'#13#10'var'#13#10'  i:integer;'#13#10'  TargetAttrib,Sou'
