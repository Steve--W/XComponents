  +'File(F);'#13#10'  end;'#13#10#13#10'  result:=fulltext;'#13#10'end;'#13#10
  +#13#10'procedure WriteToLocalStore(KeyName,TheData:String);'#13#10'begin'#13
  +#10'  if KeyName<>'''' then'#13#10'    WriteToFile(KeyName,TheData);'#13#10
  ,'end;'#13#10#13#10'function ReadFromLocalStore(KeyName:String):String;'#13#10
  +'var'#13#10'    TheData:String;'#13#10'begin'#13#10'   if KeyName<>'''' then'
  +#13#10'     TheData:=ReadFile(KeyName);'#13#10'   result:=TheData;'#13#10'en'
  +'d;'#13#10#13#10'procedure ClearLocalStore(KeyName:String);'#13#10'begin'#13
  +#10'  if KeyName<>'''' then'#13#10'    DeleteFile(KeyName);'#13#10'end;'#13
  +#10#13#10'function ResourceToString(resName:string):String;'#13#10'var'#13#10
  +'  Stream: TLazarusResourceStream;'#13#10'  Lines:TStringList;'#13#10'begin'
  +#13#10'  Stream := nil;'#13#10'  try'#13#10'    Lines:=TStringList.Create;'
  +#13#10'    //find the lazarus resource'#13#10'    Stream := TLazarusResource'
  +'Stream.Create(resName, nil);'#13#10#13#10'    //save to a stringlist'#13#10
  +'    Lines.LoadFromStream(Stream);'#13#10'    result:=Lines.Text;'#13#10'   '
  +'finally'#13#10'     Stream.Free;'#13#10'     Lines.Free;'#13#10'   end;'#13
  +#10'end;'#13#10#13#10'procedure ResourceToFile(resName,fileName:string);'#13
  +#10'var'#13#10'  str:String;'#13#10'begin'#13#10'  str:=ResourceToString(res'
  +'Name);'#13#10'  WriteToFile(fileName,str);'#13#10'end;'#13#10#13#10'procedu'
  +'re WinLaunchBrowser(FileName:String);'#13#10'var'#13#10'  v: THTMLBrowserHe'
  +'lpViewer;'#13#10'  BrowserPath, BrowserParams: string;'#13#10'  p: LongInt;'
  +#13#10'  BrowserProcess: TProcessUTF8;'#13#10'begin'#13#10'  // procedure to'
  +' open a fresh browser instance on the desktop, and load the URL'#13#10'  //'
  +'!! if 2 of these in quick succession, we still get one browser instance wit'
  +'h 2 tabs...'#13#10'  {$if defined ( windows)}'#13#10'  v:=THTMLBrowserHelpV'
  +'iewer.Create(nil);'#13#10'  try'#13#10'    v.FindDefaultBrowser(BrowserPath'
  +',BrowserParams);'#13#10#13#10'//    URL:=''http://www.lazarus.freepascal.or'
  +'g'';'#13#10'    p:=System.Pos(''%s'', BrowserParams);'#13#10'    System.Del'
  +'ete(BrowserParams,p,2);'#13#10'    System.Insert(FileName,BrowserParams,p);'
  +#13#10#13#10'    // start browser'#13#10'    BrowserParams:=''--new-window "'
  +'''+FileName+''"'';       //!! works for Chrome...'#13#10'    BrowserProcess'
  +':=TProcessUTF8.Create(nil);'#13#10'    try'#13#10'      BrowserProcess.Comm'
  +'andLine:=BrowserPath+BrowserParams;'#13#10'      BrowserProcess.Execute;'#13
  +#10'    finally'#13#10'      BrowserProcess.Free;'#13#10'    end;'#13#10'  f'
  +'inally'#13#10'    v.Free;'#13#10'  end;'#13#10'  {$endif}'#13#10'end;'#13#10
  +#13#10#13#10#13#10'initialization'#13#10#13#10'  myProjectEvents:=TMyProject'
  +'Events.Create;'#13#10#13#10'end.'#13#10'(*  ...... for reference, in case o'
  +'f need......'#13#10'{$IFDEF UNIX              }    // --UNIX--'#13#10'    {'
  +'$IFDEF BEOS          }    // BEOS'#13#10'    {$ENDIF}'#13#10'    {$IFDEF SU'
  +'NOS         }    // SUNOS'#13#10'    {$ENDIF}'#13#10'    {$IFDEF LINUX     '
  +'      }'#13#10'      {$IFDEF ANDROID       }  // ANDROID'#13#10'      {$ELS'
  +'E}               }  // LINUX'#13#10'      {$ENDIF}'#13#10'    {$ENDIF}// en'
  +'d Linux'#13#10'  {$IFDEF BSD             }    // --BSD--'#13#10'    {$IFDEF'
  +' FREEBSD       }    // FREEBSD'#13#10'    {$ENDIF}'#13#10'    {$IFDEF NETBS'
  +'D        }    // NETBSD'#13#10'    {$ENDIF}'#13#10'    {$IFDEF DARWIN      '
  +'  }    // Macintosh see also MAC below'#13#10'    {$ENDIF}'#13#10'  {$ENDIF'
  +'}// end Bsd'#13#10'{$ENDIF}// end Unix'#13#10#13#10'{$IFDEF WINDOWS       }'
  +'        // --WINDOWS--'#13#10'  {$IFDEF WIN32       }        // WIN32'#13#10
  +'  {$ENDIF}'#13#10'  {$IFDEF WIN64       }        // WIN64'#13#10'  {$ENDIF}'
  +#13#10'  {$IFDEF WINCE       }        // WINCE'#13#10'  {$ENDIF}'#13#10#13#10
  +'{$ENDIF}// end Windows'#13#10#13#10'{$IFDEF OS2         }          // --OS2'
  +'--'#13#10'  {$IFDEF EMX         }        // EMX'#13#10'  {$ELSE}           '
  +'           // OS2'#13#10'  {$ENDIF}'#13#10'{$ENDIF}// end os2'#13#10'      '
  +'                         // --OTHER--'#13#10'{$IFDEF GO32V2    }           '
  +' // GO32V2'#13#10'{$ENDIF}'#13#10'{$IFDEF AMIGA     }            // Classic'
  +' Amiga'#13#10'{$ENDIF}'#13#10'{$IFDEF ATARI     }            // Atari TOS'
  +#13#10'{$ENDIF}'#13#10'{$IFDEF MAC       }            // Classic Macintosh'
  +#13#10'{$ENDIF}'#13#10'{$IFDEF PALMOS    }            // PalmOS'#13#10'{$END'
  +'IF}'#13#10'*)'#13#10#13#10
]);
