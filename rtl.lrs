  +'        Result:=jvtObject;'#13#10'      end'#13#10'    else if (t=''number'
  +''') then'#13#10'      if isInteger(JS) then'#13#10'        result:=jvtInteg'
  +'er'#13#10'      else'#13#10'        result:=jvtFloat'#13#10'    end;'#13#10
  +'end;'#13#10#13#10'end.'#13#10#13#10
