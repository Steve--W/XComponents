  +'        if not AttributeValuesEquivalent(TargetAttrib.AttribValue,SourceAtt'
  +'rib.AttribValue,TargetAttrib.AttribType) then'#13#10'            begin'#13
  +#10'              Done:=false;'#13#10'              //showmessage(''PushAllS'
  +'ourcesToAttributes  src=''+SourceNode.NodeName+'' ''+SourceAttrib.AttribNam'
