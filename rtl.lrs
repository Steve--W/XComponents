  +'enameIsWinAbsolute(const aFilename: string): boolean;'#13#10'begin'#13#10' '
  +' Result:=((length(aFilename)>=3) and'#13#10'           (aFilename[1] in ['''
  +'A''..''Z'',''a''..''z'']) and (aFilename[2]='':'') and (aFilename[3]in Allo'
