  +'xit;'#13#10'          end;'#13#10'        wmsError:'#13#10'          MsgTyp'
  +'e:=mtError;'#13#10'        end;'#13#10'        end;'#13#10'      end;'#13#10
  +'    end;'#13#10'  Msg:=TPAMessage.Create;'#13#10'  Msg.Id:=Id;'#13#10'  Msg'
  +'.MsgType:=MsgType;'#13#10'  Msg.MsgNumber:=MsgNumber;'#13#10'  Msg.MsgPatte'
  +'rn:=Fmt;'#13#10'  Msg.MsgText:=SafeFormat(Fmt,Args);'#13#10'  CreateMsgArgs'
  +'(Msg.Args,Args);'#13#10'  Msg.PosEl:=PosEl;'#13#10'  Msg.Filename:=PosEl.So'
  +'urceFilename;'#13#10'  Resolver.UnmangleSourceLineNumber(PosEl.SourceLinenu'
  +'mber,Msg.Row,Msg.Col);'#13#10'  EmitMessage(Msg);'#13#10'end;'#13#10#13#10
  +'procedure TPasAnalyzer.EmitMessage(Msg: TPAMessage);'#13#10'begin'#13#10'  '
