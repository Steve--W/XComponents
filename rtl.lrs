  +'ntation'#13#10#13#10'const MyNodeType=''TXEditBox'';'#13#10'var'#13#10'  my'
  +'DefaultAttribs:TDefaultAttributesArray;'#13#10#13#10#13#10'procedure TXEdit'
  +'Box.SetMyEventTypes;'#13#10'begin'#13#10'  MyEventTypes.Add(''Click'');'#13
