  +#10'end;'#13#10#13#10'const'#13#10'  DZeroResolution = 1E-12;'#13#10#13#10'f'
  +'unction IsZero(const d: Double; Epsilon: Double): Boolean;'#13#10'begin'#13
  +#10'  if Epsilon=0 then'#13#10'    Epsilon:=DZeroResolution;'#13#10'  Result'
  +':=Abs(d)<=Epsilon;'#13#10'end;'#13#10#13#10'function IsZero(const d: Double'
  +'): Boolean;'#13#10'begin'#13#10'  Result:=Abs(d)<=DZeroResolution;'#13#10'e'
  +'nd;'#13#10#13#10'function IsInfinite(const d: JSValue): Boolean; assembler;'
  +#13#10'asm'#13#10'  return (d==Infinity) || (d==-Infinity);'#13#10'end;'#13
  +#10#13#10'function SameValue(const A, B: Double; Epsilon: Double): Boolean;'
  +#13#10'begin'#13#10'  if (Epsilon=0.0) then'#13#10'    Epsilon:=Max(Min(Abs('
  +'A),Abs(B))*DZeroResolution,DZeroResolution);'#13#10'  if (A>B) then'#13#10
  +'    Result:=((A-B)<=Epsilon)'#13#10'  else'#13#10'    Result:=((B-A)<=Epsil'
  +'on);'#13#10'end;'#13#10#13#10'function JSFloor(const A: Double): Double; ex'
