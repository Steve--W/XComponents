  +#10'  FSrcLine:=1;'#13#10'  FSrcColumn:=1;'#13#10'  l:=length(Src);'#13#10' '
  +' p:=1;'#13#10'  repeat'#13#10'    LineStart:=p;'#13#10'    while (p<=l) do'
  +#13#10'      case Src[p] of'#13#10'      #10,#13:'#13#10'        begin'#13#10
  +'        if (p<l) and (Src[p+1] in [#10,#13]) and (Src[p]<>Src[p+1]) then'#13
  +#10'          inc(p,2)'#13#10'        else'#13#10'          inc(p);'#13#10' '
  +'       break;'#13#10'        end;'#13#10'      else'#13#10'        inc(p);'
  +#13#10'      end;'#13#10'    FNeedMapping:=true;'#13#10'    Write(copy(Src,L'
  +'ineStart,p-LineStart));'#13#10'    inc(FSrcLine);'#13#10'  until p>l;'#13#10
  +'end;'#13#10#13#10'end.'#13#10#13#10
