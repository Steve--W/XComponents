  ,'(const AValue: TDateTime): longint;'#13#10'Function DosDateTimeToDateTime( '
  +'AValue: longint): TDateTime;'#13#10#13#10'{ UTC <-> Local time }'#13#10#13
  +#10'Function UniversalTimeToLocal(UT: TDateTime): TDateTime;'#13#10'Function'
  +' UniversalTimeToLocal(UT: TDateTime; TZOffset : Integer): TDateTime;'#13#10
  +'Function LocalTimeToUniversal(LT: TDateTime): TDateTime;'#13#10'Function Lo'
  +'calTimeToUniversal(LT: TDateTime; TZOffset: Integer): TDateTime;'#13#10#13
  +#10'{ RFC 3339 support }'#13#10#13#10'Function DateTimeToRFC3339(ADate :TDat'
  +'eTime):string;'#13#10'Function DateToRFC3339(ADate :TDateTime):string;'#13
  +#10'Function TimeToRFC3339(ADate :TDateTime):string;'#13#10'Function TryRFC3'
  +'339ToDateTime(const Avalue: String; out ADateTime: TDateTime): Boolean;'#13
  +#10'Function RFC3339ToDateTime(const Avalue: String): TDateTime;'#13#10#13#10
  +'Type'#13#10'  {'#13#10'    Inverse of formatdatetime, destined for the date'
  +'utils unit of FPC.'#13#10#13#10'    Limitations/implementation details:'#13
  +#10'    - An inverse of FormatDateTime is not 100% an inverse, simply becaus'
  +'e one can put e.g. time tokens twice in the format string,'#13#10'         '
  +'and scandatetime wouldn''t know which time to pick.'#13#10'    - Strings li'
  +'ke hn can''t be reversed safely. E.g. 1:2 (2 minutes after 1) delivers 12 w'
  +'hich is parsed as 12:00 and then'#13#10'         misses chars for the "n" p'
  +'art.'#13#10'    - trailing characters are ignored.'#13#10'    - no support '
  +'for Eastern Asian formatting characters since they are windows only.'#13#10
  +'    - no MBCS support.'#13#10#13#10'    Extensions'#13#10'    - #9 eats whi'
  +'tespace.'#13#10'    - whitespace at the end of a pattern is optional.'#13#10
  +'    - ? matches any char.'#13#10'    - Quote the above chars to really matc'
  +'h the char.'#13#10'  }'#13#10#13#10'  { TDateTimeScanner }'#13#10#13#10'  T'
  +'DateTimeScanner = Class'#13#10'  Private'#13#10'    FPattern: String;'#13#10
  +'    FText: String;'#13#10'    FPatternOffset,'#13#10'    FLen,FPatternLen: '
  +'Integer;'#13#10'    FPatternPos,FPos : Integer;'#13#10'    FY,FM,FD : Word;'
  +#13#10'    FTimeval : TDateTime;'#13#10'    procedure ArrayMatchError;'#13#10
  +'    procedure DoDateTime;'#13#10'    procedure SetPattern(AValue: String);'
  +#13#10'    procedure SetText(AValue: String);'#13#10'    function ScanFixedI'
  +'nt(maxv:integer):integer;'#13#10'    function ScanPatternLength :integer;'
  +#13#10'    procedure MatchChar(c:char);'#13#10'    function FindIMatch(const'
  +' values :array of string; aTerm : string):integer;'#13#10'    function Find'
  +'Match(const Values : array of string):integer;'#13#10'    Procedure MatchPa'
  +'ttern(const aPattern : String);'#13#10'    Procedure DoYear;'#13#10'    Pro'
  +'cedure DoMonth;'#13#10'    Procedure DoDay;'#13#10'    Procedure DoTime;'#13
  +#10'    Procedure DoAMPM;'#13#10'  Public'#13#10'    Function Scan(StartPos:'
  +' integer = -1) : TDateTime;'#13#10'    property Pattern : String Read FPatt'
  +'ern Write SetPattern;'#13#10'    Property Text : String Read FText Write Se'
  +'tText;'#13#10'    Property PatternOffset : Integer Read FPatternOffset;'#13
  +#10'    Property Position: Integer read FPos;'#13#10'  end;'#13#10#13#10'  /'
  +'/ Easy access function'#13#10'Function ScanDateTime(APattern,AValue: String'
  +'; APos : integer = 1) : TDateTime;'#13#10#13#10'implementation'#13#10#13#10
  +'uses js, rtlconsts;'#13#10#13#10'const'#13#10'  TDateTimeEpsilon = 2.220446'
  +'0493e-16;'#13#10'  HalfMilliSecond = OneMillisecond /2 ;'#13#10#13#10'{ ---'
  +'------------------------------------------------------------------'#13#10' '
  +'   Simple trimming functions.'#13#10'  ------------------------------------'
  +'---------------------------------}'#13#10#13#10'Function DateOf(const AValu'
  +'e: TDateTime): TDateTime;'#13#10'begin'#13#10'  Result:=Trunc(AValue);'#13
  +#10'end;'#13#10#13#10#13#10'Function TimeOf(const AValue: TDateTime): TDateT'
  +'ime;'#13#10'begin'#13#10'  Result:=Frac(Avalue);'#13#10'end;'#13#10#13#10#13
  +#10'{ ---------------------------------------------------------------------'
  +#13#10'    Identification functions.'#13#10'  ------------------------------'
  +'---------------------------------------}'#13#10#13#10#13#10'Function IsInLe'
  +'apYear(const AValue: TDateTime): Boolean;'#13#10'begin'#13#10'  Result:=IsL'
  +'eapYear(YearOf(AValue));'#13#10'end;'#13#10#13#10#13#10'Function IsPM(const'
  +' AValue: TDateTime): Boolean;'#13#10'begin'#13#10'  Result:=(HourOf(AValue)'
  +'>=12);'#13#10'end;'#13#10#13#10#13#10'Function IsValidMonth(AMonth : Word) '
  +': Boolean;'#13#10#13#10'begin'#13#10'  Result:=(AMonth>=1) and (AMonth<=12)'
  +';'#13#10'end;'#13#10#13#10'Function IsValidDayOfWeek(ADayOfWeek : Word) : B'
  +'oolean;'#13#10#13#10'begin'#13#10'  Result:=(ADayOfWeek>=1) and (ADayOfWeek'
  +'<=7);'#13#10'end;'#13#10#13#10'Function IsValidWeekOfMonth(AWeekOfMonth : W'
  +'ord) : Boolean;'#13#10#13#10'begin'#13#10'  Result:=(AWeekOfMonth>=1) and ('
  +'AWeekOfMonth<=5);'#13#10'end;'#13#10#13#10'Function IsValidDate(const AYear'
  ,', AMonth, ADay: Word): Boolean;'#13#10'begin'#13#10'  Result:=(AYear<>0) an'
  +'d (AYear<10000)'#13#10'          and IsValidMonth(AMonth)'#13#10'          '
  +'and (ADay<>0) and (ADay<=MonthDays[IsleapYear(AYear),AMonth]);'#13#10'end;'
  +#13#10#13#10#13#10'Function IsValidTime(const AHour, AMinute, ASecond, AMill'
  +'iSecond: Word): Boolean;'#13#10'begin'#13#10'  Result:=(AHour=HoursPerDay) '
  +'and (AMinute=0) and (ASecond=0) and (AMillisecond=0);'#13#10'  Result:=Resu'
  +'lt or'#13#10'          ((AHour<HoursPerDay) and (AMinute<MinsPerHour) and ('
  +'ASecond<SecsPerMin) and'#13#10'           (AMillisecond<MSecsPerSec));'#13
  +#10'end;'#13#10#13#10#13#10'Function IsValidDateTime(const AYear, AMonth, AD'
  +'ay, AHour, AMinute, ASecond, AMilliSecond: Word): Boolean;'#13#10'begin'#13
  +#10'  Result:=IsValidDate(AYear,AMonth,ADay) and'#13#10'          IsValidTim'
  +'e(AHour,AMinute,ASecond,AMillisecond)'#13#10'end;'#13#10#13#10#13#10'Functi'
  +'on IsValidDateDay(const AYear, ADayOfYear: Word): Boolean;'#13#10'begin'#13
  +#10'  Result:=(AYear<>0) and (ADayOfYear<>0) and (AYear<10000) and'#13#10'  '
  +'        (ADayOfYear<=DaysPerYear[IsLeapYear(AYear)]);'#13#10'end;'#13#10#13
  +#10#13#10'Function IsValidDateWeek(const AYear, AWeekOfYear, ADayOfWeek: Wor'
  +'d): Boolean;'#13#10'begin'#13#10'  Result:=(AYear<>0) and (AYear<10000)'#13
  +#10'          and IsValidDayOfWeek(ADayOfWeek)'#13#10'          and (AWeekOf'
  +'Year<>0)'#13#10'          and (AWeekOfYear<=WeeksInaYear(AYear));'#13#10'  '
  +'{ should we not also check whether the day of the week is not'#13#10'    la'
  +'rger than the last day of the last week in the year 9999 ?? }'#13#10'end;'
  +#13#10#13#10#13#10'Function IsValidDateMonthWeek(const AYear, AMonth, AWeekO'
  +'fMonth, ADayOfWeek: Word): Boolean;'#13#10#13#10'begin'#13#10'  Result:=(AY'
  +'ear<>0) and (AYear<10000)'#13#10'          and IsValidMonth(AMonth)'#13#10
  +'          and IsValidWeekOfMonth(AWeekOfMonth)'#13#10'          and IsValid'
  +'DayOfWeek(ADayOfWeek);'#13#10'end;'#13#10#13#10'{ -------------------------'
  +'--------------------------------------------'#13#10'    Enumeration functio'
  +'ns.'#13#10'  --------------------------------------------------------------'
  +'-------}'#13#10#13#10'Function WeeksInYear(const AValue: TDateTime): Word;'
  +#13#10'begin'#13#10'  Result:=WeeksInAYear(YearOf(AValue));'#13#10'end;'#13
  +#10#13#10#13#10'Function WeeksInAYear(const AYear: Word): Word;'#13#10#13#10
  +'Var'#13#10'  DOW : Word;'#13#10#13#10'begin'#13#10'  Result:=52;'#13#10'  D'
  +'OW:=DayOfTheWeek(StartOfAYear(AYear));'#13#10'  If (DOW=4) or ((DOW=3) and '
  +'IsLeapYear(AYear)) then'#13#10'    Inc(Result);'#13#10'end;'#13#10#13#10#13
  +#10'Function DaysInYear(const AValue: TDateTime): Word;'#13#10'begin'#13#10
  +'  Result:=DaysPerYear[IsLeapYear(YearOf(AValue))];'#13#10'end;'#13#10#13#10
  +#13#10'Function DaysInAYear(const AYear: Word): Word;'#13#10'begin'#13#10'  '
  +'Result:=DaysPerYear[Isleapyear(AYear)];'#13#10'end;'#13#10#13#10#13#10'Func'
  +'tion DaysInMonth(const AValue: TDateTime): Word;'#13#10#13#10'Var'#13#10'  '
  +'Y,M,D : Word;'#13#10#13#10'begin'#13#10'  Decodedate(AValue,Y,M,D);'#13#10
  +'  Result:=MonthDays[IsLeapYear(Y),M];'#13#10'end;'#13#10#13#10#13#10'Functi'
  +'on DaysInAMonth(const AYear, AMonth: Word): Word;'#13#10'begin'#13#10'  Res'
  +'ult:=MonthDays[IsLeapYear(AYear),AMonth];'#13#10'end;'#13#10#13#10#13#10'{ '
  +'---------------------------------------------------------------------'#13#10
  +'    Variations on current date/time.'#13#10'  -----------------------------'
  +'----------------------------------------}'#13#10#13#10#13#10'Function Today'
  +': TDateTime;'#13#10'begin'#13#10'  Result:=Date();'#13#10'end;'#13#10#13#10
  +#13#10'Function Yesterday: TDateTime;'#13#10'begin'#13#10'  Result:=Date()-1'
  +';'#13#10'end;'#13#10#13#10#13#10'Function Tomorrow: TDateTime; '#13#10'begi'
  +'n'#13#10'  Result:=Date()+1;'#13#10'end;'#13#10#13#10#13#10'Function IsToda'
  +'y(const AValue: TDateTime): Boolean;'#13#10'begin'#13#10'  Result:=IsSameDa'
  +'y(AValue,Date());'#13#10'end;'#13#10#13#10#13#10'Function IsSameDay(const A'
  +'Value, ABasis: TDateTime): Boolean;'#13#10#13#10'Var'#13#10'  D : TDateTime'
  +';'#13#10#13#10'begin'#13#10'  D:=AValue-Trunc(ABasis);'#13#10'  Result:=(D>'
  +'=0) and (D<1);'#13#10'end;'#13#10#13#10'function IsSameMonth(const Avalue, '
  +'ABasis: TDateTime): Boolean;'#13#10'begin'#13#10'     result:=( YearOf(Aval'
  +'ue) = YearOf(Abasis) );'#13#10'     result:=result and ( MonthOf(AValue) = '
  +'MonthOf(ABasis) );'#13#10'end;'#13#10#13#10'const'#13#10'  DOWMap: array [1'
  +'..7] of Word = (7, 1, 2, 3, 4, 5, 6);'#13#10#13#10'Function PreviousDayOfWe'
  +'ek (DayOfWeek : Word) : Word;'#13#10#13#10'begin'#13#10'  If Not IsValidDay'
  +'OfWeek(DayOfWeek) then'#13#10'    Raise EConvertError.CreateFmt(SErrInvalid'
  +'DayOfWeek,[DayOfWeek]);'#13#10'  Result:=DOWMap[DayOfWeek];'#13#10'end;'#13
  +#10#13#10#13#10#13#10'{ ----------------------------------------------------'
