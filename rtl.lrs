  +#13#10'function GetDefaultTextEncoding: string;'#13#10'begin'#13#10'  if Enc'
  +'odingValid then'#13#10'  begin'#13#10'    Result:=DefaultTextEncoding;'#13
  +#10'    exit;'#13#10'  end;'#13#10#13#10'  {$IFDEF Pas2js}'#13#10'  Result:='
  +'EncodingUTF8;'#13#10'  {$ELSE}'#13#10'    {$IFDEF Windows}'#13#10'    Resul'
  +'t:=GetWindowsEncoding;'#13#10'    {$ELSE}'#13#10'      {$IFDEF Darwin}'#13
  +#10'      Result:=EncodingUTF8;'#13#10'      {$ELSE}'#13#10'      // unix'#13
  +#10'      Lang := GetEnvironmentVariable(''LC_ALL'');'#13#10'      if Lang='
  +''''' then'#13#10'      begin'#13#10'        Lang := GetEnvironmentVariable('
  +'''LC_MESSAGES'');'#13#10'        if Lang='''' then'#13#10'          Lang :='
  +' GetEnvironmentVariable(''LANG'');'#13#10'      end;'#13#10'      Result:=G'
  +'etUnixEncoding;'#13#10'      {$ENDIF}'#13#10'    {$ENDIF}'#13#10'  {$ENDIF}'
  +#13#10'  Result:=NormalizeEncoding(Result);'#13#10#13#10'  DefaultTextEncodi'
  +'ng:=Result;'#13#10'  EncodingValid:=true;'#13#10'end;'#13#10#13#10'function'
  +' NormalizeEncoding(const Encoding: string): string;'#13#10'var'#13#10'  i: '
  +'Integer;'#13#10'begin'#13#10'  Result:=LowerCase(Encoding);'#13#10'  for i:'
  +'=length(Result) downto 1 do'#13#10'    if Result[i]=''-'' then Delete(Resul'
  +'t,i,1);'#13#10'end;'#13#10#13#10'function IsASCII(const s: string): boolean'
  ,'; inline;'#13#10'{$IFDEF Pas2js}'#13#10'var'#13#10'  i: Integer;'#13#10'beg'
  +'in'#13#10'  for i:=1 to length(s) do'#13#10'    if s[i]>#127 then exit(fals'
  +'e);'#13#10'  Result:=true;'#13#10'end;'#13#10'{$ELSE}'#13#10'var'#13#10'  p'
  +': PChar;'#13#10'begin'#13#10'  if s='''' then exit(true);'#13#10'  p:=PChar'
  +'(s);'#13#10'  repeat'#13#10'    case p^ of'#13#10'    #0: if p-PChar(s)=len'
  +'gth(s) then exit(true);'#13#10'    #128..#255: exit(false);'#13#10'    end;'
  +#13#10'    inc(p);'#13#10'  until false;'#13#10'end;'#13#10'{$ENDIF}'#13#10
  +#13#10'{$IFDEF FPC_HAS_CPSTRING}'#13#10'function UTF8CharacterStrictLength(P'
  +': PChar): integer;'#13#10'begin'#13#10'  if p=nil then exit(0);'#13#10'  if'
  +' ord(p^)<%10000000 then'#13#10'  begin'#13#10'    // regular single byte ch'
  +'aracter'#13#10'    exit(1);'#13#10'  end'#13#10'  else if ord(p^)<%11000000'
  +' then'#13#10'  begin'#13#10'    // invalid single byte character'#13#10'   '
  +' exit(0);'#13#10'  end'#13#10'  else if ((ord(p^) and %11100000) = %1100000'
  +'0) then'#13#10'  begin'#13#10'    // should be 2 byte character'#13#10'    '
  +'if (ord(p[1]) and %11000000) = %10000000 then'#13#10'      exit(2)'#13#10' '
  +'   else'#13#10'      exit(0);'#13#10'  end'#13#10'  else if ((ord(p^) and %'
  +'11110000) = %11100000) then'#13#10'  begin'#13#10'    // should be 3 byte c'
  +'haracter'#13#10'    if ((ord(p[1]) and %11000000) = %10000000)'#13#10'    a'
  +'nd ((ord(p[2]) and %11000000) = %10000000) then'#13#10'      exit(3)'#13#10
  +'    else'#13#10'      exit(0);'#13#10'  end'#13#10'  else if ((ord(p^) and '
  +'%11111000) = %11110000) then'#13#10'  begin'#13#10'    // should be 4 byte '
  +'character'#13#10'    if ((ord(p[1]) and %11000000) = %10000000)'#13#10'    '
  +'and ((ord(p[2]) and %11000000) = %10000000)'#13#10'    and ((ord(p[3]) and '
  +'%11000000) = %10000000) then'#13#10'      exit(4)'#13#10'    else'#13#10'  '
  +'    exit(0);'#13#10'  end else'#13#10'    exit(0);'#13#10'end;'#13#10#13#10
  +'function UTF8ToUTF16(const s: string): UnicodeString;'#13#10'begin'#13#10' '
  +' Result:=UTF8Decode(s);'#13#10'end;'#13#10#13#10'function UTF16ToUTF8(const'
  +' s: UnicodeString): string;'#13#10'begin'#13#10'  if s='''' then exit('''')'
  +';'#13#10'  Result:=UTF8Encode(s);'#13#10'  // prevent UTF8 codepage appear '
  +'in the strings - we don''t need codepage'#13#10'  // conversion magic'#13#10
  +'  SetCodePage(RawByteString(Result), CP_ACP, False);'#13#10'end;'#13#10'{$E'
  +'NDIF}'#13#10#13#10'{$IFDEF Unix}'#13#10'  {$I pas2jsfileutilsunix.inc}'#13
