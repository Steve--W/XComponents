  +'*********************************************************************}'#13
  +#10'{'#13#10'Abstract:'#13#10'  After running TPasResolver, run this to'#13
  +#10'  - create a list of used declararion, either in a module or a whole pro'
  +'gram.'#13#10'  - emit hints about unused declarations'#13#10'  - and warnin'
  +'gs about uninitialized variables.'#13#10#13#10'Working:'#13#10'- mark used '
  +'elements of a module, starting from all accessible elements'#13#10'- Hint: '
  +'''Unit "%s" not used in %s'''#13#10'- Hint: ''Parameter "%s" not used'''#13
  +#10'- Hint: ''Local variable "%s" not used'''#13#10'- Hint: ''Value paramete'
  +'r "%s" is assigned but never used'''#13#10'- Hint: ''Local variable "%s" is'
  +' assigned but never used'''#13#10'- Hint: ''Local %s "%s" not used'''#13#10
  +'- Hint: ''Private field "%s" is never used'''#13#10'- Hint: ''Private field'
  +' "%s" is assigned but never used'''#13#10'- Hint: ''Private method "%s" is '
  +'never used'''#13#10'- Hint: ''Private type "%s" never used'''#13#10'- Hint:'
  +' ''Private const "%s" never used'''#13#10'- Hint: ''Private property "%s" n'
  +'ever used'''#13#10'- Hint: ''Function result does not seem to be set'''#13
  +#10'- TPasArgument: compute the effective Access'#13#10'- calls: use the eff'
  +'ective Access of arguments'#13#10'}'#13#10'unit PasUseAnalyzer;'#13#10#13#10
  +'{$mode objfpc}{$H+}'#13#10'{$inline on}'#13#10#13#10'{$ifdef fpc}'#13#10'  '
  +'{$define UsePChar}'#13#10'  {$define HasInt64}'#13#10'{$endif}'#13#10#13#10
