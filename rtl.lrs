  +'ncodeVLQ(i: TMaxPrecInt): string;'#13#10'{ Convert signed number to base256'
  +'-VLQ:'#13#10'  Each byte has 8bit, where the least significant bit is the c'
  +'ontinuation bit'#13#10'  (1=there is a next byte).'#13#10'  The first byte '
  +'contains the sign bit in the last bit'#13#10'  and the 6 most significant b'
  +'its of the number.'#13#10'  For example:'#13#10'  0 = %00000000 => 0'#13#10
  +'  1 = %00000001 => -0'#13#10'  2 = %00000010 => 1'#13#10'  130 5 = %1000001'
  +'0 %00000101 = 000010 0000101 = 100000101 = 133'#13#10'}'#13#10'var'#13#10' '
  +' digits: integer;'#13#10'begin'#13#10'  digits:=0;'#13#10'  if i<0 then'#13
  +#10'    begin'#13#10'    if i=Low(TMaxPrecInt) then'#13#10'      begin'#13#10
  +'      Result:=EncodeVLQ(High(TMaxPrecInt)+1);'#13#10'      Result[1]:=chr(o'
  +'rd(Result[1]) or 1);'#13#10'      exit;'#13#10'      end;'#13#10'    digits'
  +':=1;'#13#10'    i:=-i;'#13#10'    end;'#13#10'  inc(digits,(i and %111111) '
  +'shl 1);'#13#10'  i:=i shr 6;'#13#10'  if i>0 then'#13#10'    inc(digits,%10'
  +'000000); // need another byte -> set continuation bit'#13#10'  Result:=chr('
  +'digits);'#13#10'  while i>0 do'#13#10'    begin'#13#10'    digits:=i and %1'
  +'111111;'#13#10'    i:=i shr 7;'#13#10'    if i>0 then'#13#10'      inc(digi'
  +'ts,%10000000); // need another byte -> set continuation bit'#13#10'    Resu'
  +'lt:=Result+chr(digits);'#13#10'    end;'#13#10'end;'#13#10#13#10'function E'
  +'ncodeVLQ(i: TMaxPrecUInt): string;'#13#10'var'#13#10'  digits: integer;'#13
  +#10'begin'#13#10'  digits:=(i and %111111) shl 1;'#13#10'  if i>0 then'#13#10
  +'    inc(digits,%10000000); // need another byte -> set continuation bit'#13
  +#10'  Result:=chr(digits);'#13#10'  i:=i shr 6;'#13#10'  while i>0 do'#13#10
  +'    begin'#13#10'    digits:=i and %1111111;'#13#10'    i:=i shr 7;'#13#10
  +'    if i>0 then'#13#10'      inc(digits,%10000000); // need another byte ->'
  +' set continuation bit'#13#10'    Result:=Result+chr(digits);'#13#10'    end'
  +';'#13#10'end;'#13#10#13#10'function DecodeVLQ(const s: string): TMaxPrecInt'
