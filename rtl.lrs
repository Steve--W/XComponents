  +'lename: string): boolean;'#13#10'begin'#13#10'  Result:=(aFilename<>'''') a'
  +'nd (aFilename[1]=''/'');'#13#10'end;'#13#10#13#10'function FileIsInPath(con'
  +'st Filename, Path: string): boolean;'#13#10'var'#13#10'  ExpFile: String;'
  +#13#10'  ExpPath: String;'#13#10'  l: integer;'#13#10'begin'#13#10'  if Path'
  +'='''' then'#13#10'  begin'#13#10'    Result:=false;'#13#10'    exit;'#13#10
  +'  end;'#13#10'  ExpFile:=Filename;'#13#10'  ExpPath:=IncludeTrailingPathDel'
  +'imiter(Path);'#13#10'  l:=length(ExpPath);'#13#10'  Result:=(l>0) and (leng'
  +'th(ExpFile)>l) and (ExpFile[l]=PathDelim)'#13#10'          and (CompareFile'
  +'Names(ExpPath,LeftStr(ExpFile,l))=0);'#13#10'end;'#13#10#13#10'function Cho'
  +'mpPathDelim(const Path: string): string;'#13#10'var'#13#10'  Len, MinLen: I'
  +'nteger;'#13#10'begin'#13#10'  Result:=Path;'#13#10'  if Path = '''' then'#13
  +#10'    exit;'#13#10'  Len:=length(Result);'#13#10'  if (Result[1] in AllowD'
  +'irectorySeparators) then'#13#10'  begin'#13#10'    MinLen := 1;'#13#10'    '
  +'{$IFDEF HasUNCPaths}'#13#10'    if (Len >= 2) and (Result[2] in AllowDirect'
  +'orySeparators) then'#13#10'      MinLen := 2; // keep UNC ''\\'', chomp ''a'
  +'\'' to ''a'''#13#10'    {$ENDIF}'#13#10'    {$IFDEF Pas2js}'#13#10'    if ('
  +'Len >= 2) and (Result[2]=Result[1]) and (PathDelim=''\'') then'#13#10'     '
  +' MinLen := 2; // keep UNC ''\\'', chomp ''a\'' to ''a'''#13#10'    {$ENDIF}'
  +#13#10'  end'#13#10'  else begin'#13#10'    MinLen := 0;'#13#10'    {$IFdef '
  +'MSWindows}'#13#10'    if (Len >= 3) and (Result[1] in [''a''..''z'', ''A''.'
  +'.''Z''])  and'#13#10'       (Result[2] = '':'') and (Result[3] in AllowDire'
  +'ctorySeparators)'#13#10'    then'#13#10'      MinLen := 3;'#13#10'    {$END'
  +'IF}'#13#10'    {$IFdef Pas2js}'#13#10'    if (PathDelim=''\'')'#13#10'     '
  +'   and (Len >= 3) and (Result[1] in [''a''..''z'', ''A''..''Z''])'#13#10'  '
  +'      and (Result[2] = '':'') and (Result[3] in AllowDirectorySeparators)'
  +#13#10'    then'#13#10'      MinLen := 3;'#13#10'    {$ENDIF}'#13#10'  end;'
  +#13#10#13#10'  while (Len > MinLen) and (Result[Len] in AllowDirectorySepara'
  +'tors) do dec(Len);'#13#10'  if Len<length(Result) then'#13#10'    SetLength'
  +'(Result,Len);'#13#10'end;'#13#10#13#10'function ExpandDirectory(const aDire'
  +'ctory: string): string;'#13#10'begin'#13#10'  Result:=aDirectory;'#13#10'  '
  +'if Result='''' then exit;'#13#10'  Result:=ExpandFileNamePJ(Result);'#13#10
  +'  if Result='''' then exit;'#13#10'  Result:=IncludeTrailingPathDelimiter(R'
  +'esult);'#13#10'end;'#13#10#13#10'function TryCreateRelativePath(const Filen'
  +'ame, BaseDirectory: String;'#13#10'  UsePointDirectory: boolean; out RelPat'
  +'h: String): Boolean;'#13#10'{'#13#10'  Returns True if it is possible to cr'
  +'eate a relative path from Source to Dest'#13#10'  Function must be thread s'
  +'afe, so no expanding of filenames is done, since this'#13#10'  is not threa'
  +'dsafe (at least on Windows platform)'#13#10#13#10'  - Dest and Source must '
  +'either be both absolute filenames, or relative'#13#10'  - Dest and Source c'
  +'annot contain ''..'' since no expanding is done by design'#13#10'  - Dest a'
  +'nd Source must be on same drive or UNC path (Windows)'#13#10'  - if both De'
  +'st and Source are relative they must at least share their base directory'#13
  +#10'  - Double PathDelims are ignored (unless they are part of the UNC conve'
  +'ntion)'#13#10#13#10'  - if UsePointDirectory is True and Result is True the'
  +'n if RelPath is Empty string, RelPath becomes ''.'''#13#10'  - if AlwaysReq'
  +'uireSharedBaseFolder is False then Absolute filenames need not share a base'
  +'folder'#13#10#13#10'  - if the function succeeds RelPath contains the relat'
  +'ive path from Source to Dest,'#13#10'    no PathDelimiter is appended to th'
  +'e end of RelPath'#13#10#13#10'  Examples:'#13#10'  - Filename = /foo/bar Ba'
  +'seDirectory = /foo Result = True RelPath = bar'#13#10'  - Filename = /foo//'
  +'/bar BaseDirectory = /foo// Result = True RelPath = bar'#13#10'  - Filename'
  +' = /foo BaseDirectory = /foo/bar Result = True RelPath = ../'#13#10'  - Fil'
  +'ename = /foo/bar BaseDirectory = /bar Result = False (no shared base direct'
  +'ory)'#13#10'  - Filename = foo/bar BaseDirectory = foo/foo Result = True Re'
  +'lPath = ../bar'#13#10'  - Filename = foo/bar BaseDirectory = bar/foo Result'
  +' = False (no shared base directory)'#13#10'  - Filename = /foo BaseDirector'
  +'y = bar Result = False (mixed absolute and relative)'#13#10'}'#13#10'  func'
  ,'tion IsNameChar(c: char): boolean; inline;'#13#10'  begin'#13#10'    Result'
  +':=(c<>#0) and not (c in AllowDirectorySeparators);'#13#10'  end;'#13#10#13
  +#10'var'#13#10'  UpDirCount: Integer;'#13#10'  i: Integer;'#13#10'  s: strin'
