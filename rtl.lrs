  +'oEngine.Substitute(var s: string; Sender: TObject;'#13#10'  Lvl: integer);'
  +#13#10'// Rules:'#13#10'//   $macro or $macro$'#13#10'// if Macro.OnSubstitu'
  +'te is set then optional brackets are allowed: $macro(params)'#13#10'var'#13
  +#10'  p, StartP, BracketLvl, ParamStartP: Integer;'#13#10'  MacroName, NewVa'
