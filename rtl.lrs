  +');'#13#10#13#10'      setalignproperty(AControl,AControl.Parent);'#13#10'  '
  +'    myAlignmt:=SortOutAlignmentAndLabelPos(AControl,myLbl,myControl,myAlign'
  +'mt,myLabelPos);'#13#10'      SetStrProp(AControl,''Alignment'',myAlignmt);'
  +#13#10'    end;'#13#10'    //showmessage(''reset ''+AControl.Name)'#13#10'  '
  +'end;'#13#10'end;'#13#10#13#10'procedure TXDesignerExtension.PersistentDelet'
  +'ing(APersistent: TPersistent);'#13#10'var i:integer;'#13#10'   datanode,Par'
  +'entNode:TDataNode;'#13#10'begin'#13#10'  if (APersistent is TControl)'#13#10
  +'  and (APersistent = self.myWrapper) then'#13#10'  begin'#13#10'    if (sel'
  +'f.myWrapper is TControl) then'#13#10'    begin'#13#10'      if IsPublishedP'
  +'rop(self.myWrapper,''myNode'') then'#13#10'      begin'#13#10'        datan'
  +'ode:= TDataNode(GetObjectProp(self.myWrapper,''myNode''));'#13#10'        i'
