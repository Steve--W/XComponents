  +'xLevel then'#13#10'    raise EPas2jsMacro.Create(''macro cycle detected: "'
  ,'''+s+''"'');'#13#10'  p:=1;'#13#10'  while p<length(s) do begin'#13#10'    '
  +'if (s[p]=''$'') and (s[p+1] in [''_'',''a''..''z'',''A''..''Z'']) then'#13
  +#10'    begin'#13#10'      StartP:=p;'#13#10'      inc(p,2);'#13#10'      wh'
  +'ile (p<=length(s)) and (s[p] in [''_'',''a''..''z'',''A''..''Z'',''0''..''9'
  +''']) do'#13#10'        inc(p);'#13#10'      MacroName:=copy(s,StartP+1,p-St'
  +'artP-1);'#13#10'      Macro:=FindMacro(MacroName);'#13#10'      if Macro=ni'
  +'l then'#13#10'        raise EPas2jsMacro.Create(''macro not found "''+Macro'
  +'Name+''" in "''+s+''"'');'#13#10'      NewValue:='''';'#13#10'      if Macr'
  +'o.CanHaveParams and (p<=length(s)) and (s[p]=''('') then'#13#10'      begin'
  +#13#10'        // read NewValue'#13#10'        inc(p);'#13#10'        ParamS'
  +'tartP:=p;'#13#10'        BracketLvl:=1;'#13#10'        repeat'#13#10'      '
  +'    if p>length(s) then'#13#10'            raise EPas2jsMacro.Create(''miss'
  +'ing closing bracket ) in "''+s+''"'');'#13#10'          case s[p] of'#13#10
  +'          ''('': inc(BracketLvl);'#13#10'          '')'':'#13#10'          '
  +'  if BracketLvl=1 then'#13#10'            begin'#13#10'              NewVal'
  +'ue:=copy(s,ParamStartP,p-ParamStartP);'#13#10'              break;'#13#10' '
  +'           end else begin'#13#10'              dec(BracketLvl);'#13#10'    '
  +'        end;'#13#10'          end;'#13#10'        until false;'#13#10'     '
  +' end else if (p<=length(s)) and (s[p]=''$'') then'#13#10'        inc(p);'#13
  +#10'      if Assigned(Macro.OnSubstitute) then'#13#10'      begin'#13#10'   '
  +'     if not Macro.OnSubstitute(Sender,NewValue,Lvl+1) then'#13#10'         '
  +' raise EPas2jsMacro.Create(''macro "''+MacroName+''" failed in "''+s+''"'')'
  +';'#13#10'      end else'#13#10'        NewValue:=Macro.Value;'#13#10'      '
  +'s:=LeftStr(s,StartP-1)+NewValue+copy(s,p,length(s));'#13#10'      p:=StartP'
  +';'#13#10'    end;'#13#10'    inc(p);'#13#10'  end;'#13#10'end;'#13#10#13#10
