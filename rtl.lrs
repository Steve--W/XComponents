  +'n UnixTimeStampToMac(const AValue: NativeLargeInt): NativeLargeInt;'#13#10
  +#13#10'{ -------------------------------------------------------------------'
  +'--'#13#10'    Mac timestamp support.'#13#10'  -----------------------------'
  +'----------------------------------------}'#13#10#13#10'Function DateTimeToM'
  +'ac(const AValue: TDateTime): NativeLargeInt;'#13#10'Function MacToDateTime('
  +'const AValue: NativeLargeInt): TDateTime;'#13#10'Function MacTimeStampToUni'
  +'x(const AValue: NativeLargeInt): NativeLargeInt;'#13#10#13#10'{ ...........'
  +'..........................................................'#13#10'    Dos <'
  +'-> Delphi datetime support'#13#10'  .......................................'
