  +'            else  browser := ''Safari'';'#13#10'              end;'#13#10' '
  +'          end;'#13#10'        end;'#13#10'     end;'#13#10'  end;'#13#10'  '
  +'//Showmessage(''Browser = ''+browser);'#13#10'  if (browser <> ''Google Chr'
  +'ome'')'#13#10'  and (browser <> ''Microsoft Edge'') then              //!! '
