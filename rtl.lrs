  +#13#10'  If Not assigned(FComponents) then'#13#10'    exit;'#13#10'  C:=FCom'
  +'ponents.Count-1;'#13#10'  While (C>=0) do'#13#10'    begin'#13#10'    TComp'
  +'onent(FComponents.Items[C]).Notification(AComponent,Operation);'#13#10'    '
  +'Dec(C);'#13#10'    if C>=FComponents.Count then'#13#10'      C:=FComponents'
  +'.Count-1;'#13#10'    end;'#13#10'end;'#13#10#13#10#13#10'procedure TCompone'
  +'nt.PaletteCreated;'#13#10'begin'#13#10'end;'#13#10#13#10#13#10#13#10'Proced'
  +'ure TComponent.SetAncestor(Value: Boolean);'#13#10#13#10'Var Runner : Longi'
  ,'nt;'#13#10#13#10'begin'#13#10'  If Value then'#13#10'    Include(FComponent'
  +'State,csAncestor)'#13#10'  else'#13#10'    Exclude(FCOmponentState,csAncest'
  +'or);'#13#10'  if Assigned(FComponents) then'#13#10'    For Runner:=0 To FCo'
  +'mponents.Count-1 do'#13#10'      TComponent(FComponents.Items[Runner]).SetA'
  +'ncestor(Value);'#13#10'end;'#13#10#13#10#13#10'Procedure TComponent.SetDesi'
  +'gning(Value: Boolean; SetChildren : Boolean = True);'#13#10#13#10'Var Runne'
  +'r : Longint;'#13#10#13#10'begin'#13#10'  If Value then'#13#10'    Include(F'
  +'ComponentState,csDesigning)'#13#10'  else'#13#10'    Exclude(FComponentStat'
  +'e,csDesigning);'#13#10'  if Assigned(FComponents) and SetChildren then'#13
  +#10'    For Runner:=0 To FComponents.Count - 1 do'#13#10'      TComponent(FC'
  +'omponents.items[Runner]).SetDesigning(Value);'#13#10'end;'#13#10#13#10'Proc'
  +'edure TComponent.SetDesignInstance(Value: Boolean);'#13#10#13#10'begin'#13
  +#10'  If Value then'#13#10'    Include(FComponentState,csDesignInstance)'#13
  +#10'  else'#13#10'    Exclude(FComponentState,csDesignInstance);'#13#10'end;'
  +#13#10#13#10'Procedure TComponent.SetInline(Value: Boolean);'#13#10#13#10'be'
  +'gin'#13#10'  If Value then'#13#10'    Include(FComponentState,csInline)'#13
  +#10'  else'#13#10'    Exclude(FComponentState,csInline);'#13#10'end;'#13#10
  +#13#10#13#10'Procedure TComponent.SetName(const NewName: TComponentName);'#13
  +#10#13#10'begin'#13#10'  If FName=NewName then exit;'#13#10'  If (NewName<>'
  +''''') and not IsValidIdent(NewName) then'#13#10'    Raise EComponentError.C'
  +'reateFmt(SInvalidName,[NewName]);'#13#10'  If Assigned(FOwner) Then'#13#10
  +'    FOwner.ValidateRename(Self,FName,NewName)'#13#10'  else'#13#10'    Vali'
  +'dateRename(Nil,FName,NewName);'#13#10'  ChangeName(NewName);'#13#10'end;'#13
  +#10#13#10#13#10'Procedure TComponent.SetChildOrder(Child: TComponent; Order:'
  +' Integer);'#13#10#13#10'begin'#13#10'  // does nothing'#13#10'  if Child=ni'
  +'l then ;'#13#10'  if Order=0 then ;'#13#10'end;'#13#10#13#10#13#10'Procedur'
  +'e TComponent.SetParentComponent(Value: TComponent);'#13#10#13#10'begin'#13
  +#10'  // Does nothing'#13#10'  if Value=nil then ;'#13#10'end;'#13#10#13#10
  +#13#10'Procedure TComponent.Updating;'#13#10#13#10'begin'#13#10'  Include (F'
  +'ComponentState,csUpdating);'#13#10'end;'#13#10#13#10#13#10'Procedure TCompo'
  +'nent.Updated;'#13#10#13#10'begin'#13#10'  Exclude(FComponentState,csUpdatin'
  +'g);'#13#10'end;'#13#10#13#10#13#10'Procedure TComponent.ValidateRename(ACom'
  +'ponent: TComponent;'#13#10'  const CurName, NewName: string);'#13#10#13#10
  +'begin'#13#10'//!! This contradicts the Delphi manual.'#13#10'  If (ACompone'
  +'nt<>Nil) and (CompareText(CurName,NewName)<>0) and (AComponent.Owner = Self'
  +') and'#13#10'     (FindComponent(NewName)<>Nil) then'#13#10'      raise ECo'
  +'mponentError.Createfmt(SDuplicateName,[newname]);'#13#10'  If (csDesigning '
  +'in FComponentState) and (FOwner<>Nil) then'#13#10'    FOwner.ValidateRename'
  +'(AComponent,Curname,Newname);'#13#10'end;'#13#10#13#10#13#10'Procedure TCom'
  +'ponent.ValidateContainer(AComponent: TComponent);'#13#10#13#10'begin'#13#10
  +'  AComponent.ValidateInsert(Self);'#13#10'end;'#13#10#13#10#13#10'Procedure'
  +' TComponent.ValidateInsert(AComponent: TComponent);'#13#10#13#10'begin'#13
  +#10'  // Does nothing.'#13#10'  if AComponent=nil then ;'#13#10'end;'#13#10
  +#13#10'function TComponent._AddRef: Integer;'#13#10'begin'#13#10'  Result:=-'
  +'1;'#13#10'end;'#13#10#13#10'function TComponent._Release: Integer;'#13#10'b'
  +'egin'#13#10'  Result:=-1;'#13#10'end;'#13#10#13#10#13#10'Constructor TCompo'
  +'nent.Create(AOwner: TComponent);'#13#10#13#10'begin'#13#10'  FComponentStyl'
  +'e:=[csInheritable];'#13#10'  If Assigned(AOwner) then AOwner.InsertComponen'
  +'t(Self);'#13#10'end;'#13#10#13#10#13#10'Destructor TComponent.Destroy;'#13
  +#10#13#10'Var'#13#10'  I : Integer;'#13#10'  C : TComponent;'#13#10#13#10'be'
  +'gin'#13#10'  Destroying;'#13#10'  If Assigned(FFreeNotifies) then'#13#10'  '
  +'  begin'#13#10'    I:=FFreeNotifies.Count-1;'#13#10'    While (I>=0) do'#13
  +#10'      begin'#13#10'      C:=TComponent(FFreeNotifies.Items[I]);'#13#10' '
  +'     // Delete, so one component is not notified twice, if it is owned.'#13
  +#10'      FFreeNotifies.Delete(I);'#13#10'      C.Notification (self,opRemov'
  +'e);'#13#10'      If (FFreeNotifies=Nil) then'#13#10'        I:=0'#13#10'   '
  +'   else if (I>FFreeNotifies.Count) then'#13#10'        I:=FFreeNotifies.Cou'
  +'nt;'#13#10'      dec(i);'#13#10'      end;'#13#10'    FreeAndNil(FFreeNotif'
  +'ies);'#13#10'    end;'#13#10'  DestroyComponents;'#13#10'  If FOwner<>Nil T'
  +'hen FOwner.RemoveComponent(Self);'#13#10'  inherited destroy;'#13#10'end;'
  +#13#10#13#10#13#10'Procedure TComponent.BeforeDestruction;'#13#10'begin'#13
  +#10'  if not(csDestroying in FComponentstate) then'#13#10'    Destroying;'#13
  +#10'end;'#13#10#13#10#13#10'Procedure TComponent.DestroyComponents;'#13#10#13
  +#10'Var acomponent: TComponent;'#13#10#13#10'begin'#13#10'  While assigned(F'
  ,'Components) do'#13#10'    begin'#13#10'    aComponent:=TComponent(FComponen'
  +'ts.Last);'#13#10'    Remove(aComponent);'#13#10'    Acomponent.Destroy;'#13
  +#10'    end;'#13#10'end;'#13#10#13#10#13#10'Procedure TComponent.Destroying;'
  +#13#10#13#10'Var Runner : longint;'#13#10#13#10'begin'#13#10'  If csDestroyi'
  +'ng in FComponentstate Then Exit;'#13#10'  include (FComponentState,csDestro'
  +'ying);'#13#10'  If Assigned(FComponents) then'#13#10'    for Runner:=0 to F'
  +'Components.Count-1 do'#13#10'      TComponent(FComponents.Items[Runner]).De'
  +'stroying;'#13#10'end;'#13#10#13#10'function TComponent.QueryInterface(const'
  +' IID: TGUID; out Obj): integer;'#13#10'begin'#13#10'  if GetInterface(IID, '
  +'Obj) then'#13#10'    Result := S_OK'#13#10'  else'#13#10'    Result := E_NO'
  +'INTERFACE;'#13#10#13#10'end;'#13#10#13#10#13#10'Function  TComponent.FindCo'
  +'mponent(const AName: string): TComponent;'#13#10#13#10'Var I : longint;'#13
  +#10#13#10'begin'#13#10'  Result:=Nil;'#13#10'  If (AName='''') or Not assign'
  +'ed(FComponents) then exit;'#13#10'  For i:=0 to FComponents.Count-1 do'#13
  +#10'    if (CompareText(TComponent(FComponents[I]).Name,AName)=0) then'#13#10
  +'      begin'#13#10'      Result:=TComponent(FComponents.Items[I]);'#13#10' '
  +'     exit;'#13#10'      end;'#13#10'end;'#13#10#13#10#13#10'Procedure TComp'
  +'onent.FreeNotification(AComponent: TComponent);'#13#10#13#10'begin'#13#10' '
  +' If (Owner<>Nil) and (AComponent=Owner) then exit;'#13#10'  If not (Assigne'
  +'d(FFreeNotifies)) then'#13#10'    FFreeNotifies:=TFpList.Create;'#13#10'  I'
  +'f FFreeNotifies.IndexOf(AComponent)=-1 then'#13#10'    begin'#13#10'    FFr'
  +'eeNotifies.Add(AComponent);'#13#10'    AComponent.FreeNotification (self);'
  +#13#10'    end;'#13#10'end;'#13#10#13#10#13#10'procedure TComponent.RemoveFr'
  +'eeNotification(AComponent: TComponent);'#13#10'begin'#13#10'  RemoveNotific'
  +'ation(AComponent);'#13#10'  AComponent.RemoveNotification (self);'#13#10'en'
  +'d;'#13#10#13#10#13#10'Function  TComponent.GetParentComponent: TComponent;'
  +#13#10#13#10'begin'#13#10'  Result:=Nil;'#13#10'end;'#13#10#13#10#13#10'Func'
  +'tion  TComponent.HasParent: Boolean;'#13#10#13#10'begin'#13#10'  Result:=Fa'
  +'lse;'#13#10'end;'#13#10#13#10#13#10'Procedure TComponent.InsertComponent(AC'
  +'omponent: TComponent);'#13#10#13#10'begin'#13#10'  AComponent.ValidateConta'
  +'iner(Self);'#13#10'  ValidateRename(AComponent,'''',AComponent.FName);'#13
  +#10'  Insert(AComponent);'#13#10'  If csDesigning in FComponentState then'#13
  +#10'    AComponent.SetDesigning(true);'#13#10'  Notification(AComponent,opIn'
  +'sert);'#13#10'end;'#13#10#13#10#13#10'Procedure TComponent.RemoveComponent('
  +'AComponent: TComponent);'#13#10#13#10'begin'#13#10'  Notification(AComponen'
  +'t,opRemove);'#13#10'  Remove(AComponent);'#13#10'  Acomponent.Setdesigning('
  +'False);'#13#10'  ValidateRename(AComponent,AComponent.FName,'''');'#13#10'e'
  +'nd;'#13#10#13#10'procedure TComponent.SetSubComponent(ASubComponent: Boolea'
  +'n);'#13#10'begin'#13#10'  if ASubComponent then'#13#10'    Include(FCompone'
  +'ntStyle, csSubComponent)'#13#10'  else'#13#10'    Exclude(FComponentStyle, '
  +'csSubComponent);'#13#10'end;'#13#10#13#10'function TComponent.GetEnumerator'
  +': TComponentEnumerator;'#13#10'begin'#13#10'  Result:=TComponentEnumerator.'
  +'Create(Self);'#13#10'end;'#13#10#13#10#13#10'{ ----------------------------'
  +'-----------------------------------------'#13#10'  Global routines'#13#10' '
  +' ---------------------------------------------------------------------}'#13
  +#10#13#10'var'#13#10'  ClassList : TJSObject;'#13#10'  '#13#10'Procedure Reg'
  +'isterClass(AClass : TPersistentClass);'#13#10#13#10'begin'#13#10'  ClassLis'
  +'t[AClass.ClassName]:=AClass;'#13#10'end;'#13#10#13#10'Function GetClass(ACl'
  +'assName : string) : TPersistentClass;'#13#10#13#10'begin'#13#10'  Result:=n'
  +'il;'#13#10'  if AClassName='''' then exit;'#13#10'  if not ClassList.hasOwn'
  +'Property(AClassName) then exit;'#13#10'  Result:=TPersistentClass(ClassList'
  +'[AClassName]);'#13#10'end;'#13#10#13#10'initialization'#13#10'  ClassList:='
  +'TJSObject.create(nil);'#13#10'end.'#13#10#13#10
]);
