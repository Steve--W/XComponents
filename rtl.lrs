  +') then'#13#10'    Mode:=paumAllExports'#13#10'  else'#13#10'    Mode:=paumA'
  +'llPasUsable;'#13#10'  UseModule(aModule,Mode);'#13#10'  {$IFDEF VerbosePasA'
