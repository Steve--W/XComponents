  +#13#10'function TPasResolver.CheckSrcIsADstType(const ResolvedSrcType,'#13#10
  +'  ResolvedDestType: TPasResolverResult; ErrorEl: TPasElement): integer;'#13
  +#10'// finds distance between classes SrcType and DestType'#13#10'begin'#13
  +#10'  Result:=CheckClassIsClass(ResolvedSrcType.LoTypeEl,ResolvedDestType.Lo'
  +'TypeEl,ErrorEl);'#13#10'end;'#13#10#13#10'function TPasResolver.CheckClassI'
  +'sClass(SrcType, DestType: TPasType;'#13#10'  ErrorEl: TPasElement): integer'
  +';'#13#10'// check if Src is equal or descends from Dest'#13#10'var'#13#10' '
  +' ClassEl: TPasClassType;'#13#10'begin'#13#10'  {$IFDEF VerbosePasResolver}'
  +#13#10'  writeln(''TPasResolver.CheckClassIsClass SrcType='',GetObjName(SrcT'
  +'ype),'' DestType='',GetObjName(DestType));'#13#10'  {$ENDIF}'#13#10'  if De'
  +'stType=nil then exit(cIncompatible);'#13#10'  DestType:=ResolveAliasType(De'
  +'stType);'#13#10#13#10'  Result:=cExact;'#13#10'  while SrcType<>nil do'#13
  +#10'    begin'#13#10'    {$IFDEF VerbosePasResolver}'#13#10'    writeln('' S'
  +'tep='',Result,'' SrcType='',GetObjName(SrcType),'' DestType='',GetObjName(D'
  +'estType));'#13#10'    {$ENDIF}'#13#10'    if SrcType=DestType then'#13#10' '
  +'     exit'#13#10'    else if SrcType.ClassType=TPasAliasType then'#13#10'  '
  +'    // alias -> skip'#13#10'      SrcType:=TPasAliasType(SrcType).DestType'
  +#13#10'    else if SrcType.ClassType=TPasTypeAliasType then'#13#10'      beg'
  +'in'#13#10'      // type alias -> increases distance'#13#10'      SrcType:=T'
  +'PasAliasType(SrcType).DestType;'#13#10'      inc(Result);'#13#10'      end'
  +#13#10'    else if SrcType.ClassType=TPasClassType then'#13#10'      begin'
  +#13#10'      ClassEl:=TPasClassType(SrcType);'#13#10'      if ClassEl.IsForw'
  +'ard then'#13#10'        // class forward -> skip'#13#10'        SrcType:=(C'
  +'lassEl.CustomData as TResolvedReference).Declaration as TPasType'#13#10'   '
  +'   else'#13#10'        begin'#13#10'        // class ancestor -> increase d'
  +'istance'#13#10'        SrcType:=(ClassEl.CustomData as TPasClassScope).Dire'
  +'ctAncestor;'#13#10'        inc(Result);'#13#10'        end;'#13#10'      en'
  +'d'#13#10'    else'#13#10'      exit(cIncompatible);'#13#10'    end;'#13#10
  +'  if ErrorEl=nil then ;'#13#10'  Result:=cIncompatible;'#13#10'end;'#13#10
  +#13#10'function TPasResolver.CheckClassesAreRelated(TypeA, TypeB: TPasType;'
  +#13#10'  ErrorEl: TPasElement): integer;'#13#10'begin'#13#10'  Result:=Check'
  +'ClassIsClass(TypeA,TypeB,ErrorEl);'#13#10'  if Result<>cIncompatible then e'
  +'xit;'#13#10'  Result:=CheckClassIsClass(TypeB,TypeA,ErrorEl);'#13#10'end;'
  +#13#10#13#10'function TPasResolver.GetClassImplementsIntf(ClassEl, Intf: TPa'
  +'sClassType'#13#10'  ): TPasClassType;'#13#10'begin'#13#10'  Result:=nil;'#13
  +#10'  while ClassEl<>nil do'#13#10'    begin'#13#10'    if IndexOfImplemente'
  +'dInterface(ClassEl,Intf)>=0 then'#13#10'      exit(ClassEl);'#13#10'    Cla'
  +'ssEl:=GetPasClassAncestor(ClassEl,true) as TPasClassType;'#13#10'    end;'
  +#13#10'end;'#13#10#13#10'end.'#13#10#13#10
]);
