  +'Name.toLowerCase () ;'#13#10'  end;'#13#10'  navigatorappName:=tempstr;'#13
  +#10'end;'#13#10#13#10'begin'#13#10'  browser := ''Unknown browser'';'#13#10
  +'  if (windowopera) = ''opera'''#13#10'  then  browser := ''Opera'''#13#10' '
  +' else'#13#10'  begin'#13#10'     if (navigatorappName() = ''microsoft inter'
  +'net explorer'')'#13#10'     then  browser := ''Internet Explorer'''#13#10' '
