  +' boolean;'#13#10'var'#13#10'  ParentIsContainer:Boolean;'#13#10'  tmp:TObje'
  +'ct;'#13#10'begin'#13#10'  // MouseDownComponent may be a wrapperpanel, or a'
  +' control inside the wrapper which is a container type'#13#10'  if (MouseDow'
  +'nComponent is TControl)'#13#10'  and (MouseDownComponent = self.myWrapper) '
  +'then'#13#10'  begin'#13#10'    // Whenever the user drops a control on a no'
