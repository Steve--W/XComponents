  +'peInfoClass;'#13#10'  i: Integer;'#13#10'  PropName: String;'#13#10'  Names'
  +': TJSObject;'#13#10'begin'#13#10'  Result:=nil;'#13#10'  Names:=TJSObject.n'
  +'ew;'#13#10'  C:=aTIClass;'#13#10'  while C<>nil do'#13#10'  begin'#13#10'  '
  +'  for i:=0 to length(C.Names)-1 do'#13#10'    begin'#13#10'      PropName:='
  +'C.Names[i];'#13#10'      if Names.hasOwnProperty(PropName) then continue;'
  +#13#10'      TJSArray(Result).push(C.Members[PropName]);'#13#10'      Names['
  +'PropName]:=true;'#13#10'    end;'#13#10'    C:=C.Ancestor;'#13#10'  end;'#13
  +#10'end;'#13#10#13#10'function GetClassMember(aTIClass: TTypeInfoClass; cons'
  +'t aName: String): TTypeMember;'#13#10'var'#13#10'  C: TTypeInfoClass;'#13#10
  +'  i: Integer;'#13#10'begin'#13#10'  // quick search: case sensitive'#13#10
  +'  C:=aTIClass;'#13#10'  while C<>nil do'#13#10'  begin'#13#10'    if TJSObj'
  +'ect(C.Members).hasOwnProperty(aName) then'#13#10'      exit(C.Members[aName'
  +']);'#13#10'    C:=C.Ancestor;'#13#10'  end;'#13#10'  // slow search: case i'
  +'nsensitive'#13#10'  C:=aTIClass;'#13#10'  while C<>nil do'#13#10'  begin'#13
  +#10'    for i:=0 to length(C.Names)-1 do'#13#10'      if CompareText(C.Names'
  +'[i],aName)=0 then'#13#10'        exit(C.Members[C.Names[i]]);'#13#10'    C:'
  +'=C.Ancestor;'#13#10'  end;'#13#10'  Result:=nil;'#13#10'end;'#13#10#13#10'f'
  +'unction GetInstanceMethod(Instance: TObject; const aName: String): Pointer;'
  +#13#10'var'#13#10'  TI: TTypeMember;'#13#10'begin'#13#10'  if Instance=nil t'
  +'hen exit(nil);'#13#10'  TI:=GetClassMember(TypeInfo(Instance),aName);'#13#10
  +'  if not (TI is TTypeMemberMethod) then exit(nil);'#13#10'  Result:=CreateM'
  +'ethod(Instance,TI.Name); // Note: use TI.Name for the correct case!'#13#10
  +'end;'#13#10#13#10'function GetClassMethods(aTIClass: TTypeInfoClass): TType'
  +'MemberMethodDynArray;'#13#10'var'#13#10'  C: TTypeInfoClass;'#13#10'  i, Cn'
  +'t, j: Integer;'#13#10'begin'#13#10'  Cnt:=0;'#13#10'  C:=aTIClass;'#13#10' '
  +' while C<>nil do'#13#10'  begin'#13#10'    inc(Cnt,C.MethodCount);'#13#10' '
  +'   C:=C.Ancestor;'#13#10'  end;'#13#10'  SetLength(Result,Cnt);'#13#10'  C:'
  +'=aTIClass;'#13#10'  i:=0;'#13#10'  while C<>nil do'#13#10'  begin'#13#10'  '
  +'  for j:=0 to C.MethodCount-1 do'#13#10'    begin'#13#10'      Result[i]:=T'
  +'TypeMemberMethod(C.Members[C.Methods[j]]);'#13#10'      inc(i);'#13#10'    '
  +'end;'#13#10'    C:=C.Ancestor;'#13#10'  end;'#13#10'end;'#13#10#13#10'funct'
  +'ion GetInterfaceMembers(aTIInterface: TTypeInfoInterface'#13#10'  ): TTypeM'
