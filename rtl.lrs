  +'       if mp=0 then'#13#10'          begin'#13#10'            Inc(Which);'
  +#13#10'            mp:=which;'#13#10'          end;'#13#10'       ''D'' :'#13
  +#10'         if dp=0 then'#13#10'          begin'#13#10'            Inc(Whic'
  +'h);'#13#10'            dp:=which;'#13#10'          end;'#13#10'     end;'#13
  +#10'   end;'#13#10'  // Writeln(''YP: '',Yp,'', MP: '',Mp,'', DP: '',DP);'#13
  +#10'  for i := 1 to 3 do'#13#10'    values[i] := 0;'#13#10'  s1 := '''';'#13
  +#10'  n := 0;'#13#10'  for i := 1 to len do'#13#10'     begin'#13#10'     if'
  ,' Pos(s[i],Digits)>0 then'#13#10'       s1 := s1 + s[i];'#13#10'     { space'
  +' can be part of the shortdateformat, and is defaultly in slovak'#13#10'    '
  +'   windows, therefor it shouldn''t be taken as separator (unless so specifi'
  +'ed)'#13#10'       and ignored }'#13#10'     if (Separator <> '' '') and (s['
