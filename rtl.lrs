  +#10'end;'#13#10#13#10'procedure TXTable.SetTableData(const AValue:String);'
  +#13#10'var'#13#10'  cw,dta:String;'#13#10'  hasHeaders:Boolean;'#13#10'  i:i'
  +'nteger;'#13#10'begin'#13#10'  //showmessage(''table data : ''+AValue);'#13
  +#10'  myNode.SetAttributeValue(''TableData'',AValue,''TableString'');'#13#10
  +'  {$ifndef JScript}'#13#10'  self.PopulateStringGrid(AValue);'#13#10'  {$el'
  +'se}'#13#10'  //showmessage(TXTable(self).NameSpace+TXTable(self).NodeName+'
  +''' SetTableData : ''+AValue);'#13#10'  hasHeaders:=self.HasHeaderRow;'#13#10
  +'  cw:=myNode.GetAttribute(''ColWidth'',true).AttribValue;'#13#10'  //showme'
  +'ssage(''settabledata with colwidth ''+cw);'#13#10'  //CleanValue:=myStringR'
  +'eplace(AValue,LineEnding,''\\n'',-1,-1);'#13#10'  asm'#13#10'    // fudge..'
  +'. (problem with newline embedded)....'#13#10'    var CleanValue = '''';'#13
  +#10'    for ( var c = 0; c < AValue.length; c++ ) {'#13#10'      if (AValue.'
  +'charCodeAt(c) != 10) {CleanValue = CleanValue + AValue[c];}'#13#10'      el'
  +'se {CleanValue = CleanValue + ''\\n'';}'#13#10'      }'#13#10'    // this f'
  +'ailed to work....'#13#10'    //var CleanValue = AValue.replace(/\\n/g, "\\n'
  +'")'#13#10'    //                         .replace(/\\&/g, "\\&")'#13#10'   '
  +' //                         .replace(/\\r/g, "\\r")'#13#10'    //          '
  +'               .replace(/\\t/g, "\\t")'#13#10'    //                       '
  +'  .replace(/\\b/g, "\\b")'#13#10'    //                         .replace(/\'
  +'\f/g, "\\f");'#13#10'    //console.log(CleanValue);'#13#10'    try {'#13#10
  +'    var ob = document.getElementById(this.NameSpace+this.NodeName+''Content'
  +'s'');'#13#10'    if ((ob!=null)&&(AValue!='''')) {'#13#10'      var localte'
  ,'stdata=JSON.parse(CleanValue);'#13#10'      var RowCount =localtestdata.len'
  +'gth;'#13#10'      var ColCount = 0;'#13#10'      for ( var i = 0; i < RowCo'
  +'unt; i++ ) {'#13#10'        if(localtestdata[i].length> ColCount)'#13#10'  '
  +'        {ColCount = localtestdata[i].length }'#13#10'      }'#13#10'      /'
  +'/alert(''rows=''+RowCount+'' cols=''+ColCount);'#13#10'      ob.innerHTML='
  +''''';'#13#10'      if (RowCount>0) {'#13#10#13#10'        // first row is h'
  +'eaders'#13#10'        var toprow=document.createElement("tr");'#13#10'     '
  +'   for (var j=0; j<ColCount; j++) {'#13#10'          if (hasHeaders==true) '
  +'{'#13#10'            var hdr=document.createElement("th");'#13#10'         '
  +'   }'#13#10'          else {'#13#10'            var hdr=document.createElem'
  +'ent("td");}'#13#10'          hdr.style.width=cw+''px'';'#13#10'          va'
  +'r textnode=document.createTextNode(localtestdata[0][j]);'#13#10'          h'
  +'dr.appendChild(textnode);'#13#10'          toprow.appendChild(hdr);'#13#10
  +'        }'#13#10'        ob.appendChild(toprow);'#13#10#13#10'        var b'
  +'dy=document.createElement("tbody");'#13#10'        ob.appendChild(bdy);'#13
  +#10'        for (i = 1; i < RowCount; i++ ) {'#13#10'           var row=docu'
  +'ment.createElement("tr");'#13#10'           for (j=0; j<ColCount; j++) {'#13
  +#10'             var cell = document.createElement("td");'#13#10'           '
  +'  //alert(''cell value is ''+localtestdata[i][j]);'#13#10'             text'
  +'node=document.createTextNode(localtestdata[i][j]);'#13#10'             cell'
  +'.appendChild(textnode);'#13#10'             row.appendChild(cell);'#13#10' '
  +'          }'#13#10'           bdy.appendChild(row);'#13#10'        }'#13#10
  +'      }'#13#10'    }'#13#10'    }'#13#10'    catch(err) {  alert("Error in '
  +'TXTable.SetTableData: "+ err.message); };'#13#10#13#10'  end;'#13#10'  {$en'
  +'dif}'#13#10'  i:=self.NumCols;'#13#10'  self.NumCols:=self.NumCols;'#13#10
  +'  self.NumRows:=self.NumRows;'#13#10#13#10'  //...and reset the TableData a'
  +'ttribute again from the grid, so that the format is browser JSON-compatible'
  +#13#10'  dta:=self.ConstructDataString;'#13#10'  myNode.SetAttributeValue('''
  +'TableData'',dta,''TableString'');'#13#10'end;'#13#10#13#10'begin'#13#10'  /'
  +'/ this is the set of node attributes that each TXTable instance will have.'
  +#13#10'  AddWrapperDefaultAttribs(myDefaultAttribs);'#13#10'  AddDefaultAttr'
  +'ibute(myDefaultAttribs,''TableWidth'',''String'',''300'','''',false);'#13#10
  +'  AddDefaultAttribute(myDefaultAttribs,''TableHeight'',''String'',''200'','
  +''''',false);'#13#10'  AddDefaultAttribute(myDefaultAttribs,''SpacingAround'
  +''',''Integer'',''0'','''',false);'#13#10'  AddDefaultAttribute(myDefaultAtt'
  +'ribs,''LabelPos'',''String'',''Top'','''',false);'#13#10'  AddDefaultAttrib'
  +'ute(myDefaultAttribs,''LabelText'',''String'',''Table'','''',false);'#13#10
  +'  AddDefaultAttribute(myDefaultAttribs,''ReadOnly'',''Boolean'',''False'','
  +''''',false);'#13#10'  AddDefaultAttribute(myDefaultAttribs,''HasHeaderRow'''
  +',''Boolean'',''True'','''',false);'#13#10'  AddDefaultAttribute(myDefaultAt'
  +'tribs,''IsNumeric'',''Boolean'',''False'',''If true, all cells (except head'
  +'er) must contain numeric data only'',false);'#13#10'  AddDefaultAttribute(m'
  +'yDefaultAttribs,''TableData'',''String'',''[["a","b","c"],["1","2","3"]]'','
  +''''',false);'#13#10'  AddDefaultAttribute(myDefaultAttribs,''SelectedRow'','
  +'''Integer'',''-1'','''',false);'#13#10'  AddDefaultAttribute(myDefaultAttri'
  +'bs,''SelectedCol'',''Integer'',''-1'','''',false);'#13#10'  AddDefaultAttri'
  +'bute(myDefaultAttribs,''NumCols'',''Integer'',''3'','''',false,false);'#13
  +#10'  AddDefaultAttribute(myDefaultAttribs,''NumRows'',''Integer'',''2'','''
  +''',false,false);'#13#10'  AddDefaultAttribute(myDefaultAttribs,''ColWidth'''
  +',''Integer'',''40'','''',false);'#13#10'  AddDefaultAttribute(myDefaultAttr'
  +'ibs,''SelectedValue'',''String'','''','''',false,false);'#13#10'  AddDefaul'
  +'tAttribute(myDefaultAttribs,''IncludeDataInSave'',''Boolean'',''True'',''If'
  +' false, the table contents will be excluded from saved system data'',false)'
  +';'#13#10'  AddDefaultAttribute(myDefaultAttribs,''ShowCopyButton'',''Boolea'
  +'n'',''False'',''show the Copy button'',false);'#13#10'  AddDefaultAttribute'
  +'(myDefaultAttribs,''ShowPasteButton'',''Boolean'',''False'',''show the Past'
  +'e button'',false);'#13#10'  AddDefaultsToTable(MyNodeType,myDefaultAttribs)'
  +';'#13#10#13#10'  AddExclusionAttribToTable(MyNodeType,''IncludeDataInSave'''
  +',''TableData'');'#13#10#13#10'  AddAttribOptions(MyNodeType,''Alignment'',A'
  +'lignmentOptions);'#13#10'  AddAttribOptions(MyNodeType,''LabelPos'',LabelPo'
  +'sOptions);'#13#10'  {$ifndef JScript}'#13#10'  RegisterClass(TXTable);'#13
  +#10'  AddNodeFuncLookup(MyNodeType,@CreateWidget);'#13#10'  {$else}'#13#10' '
  +' AddNodeFuncLookup(MyNodeType,@CreateinterfaceObj,@CreateWidget);'#13#10'  '
  +'{$endif}'#13#10'  SuppressDesignerProperty(''TXTable'',''BgColor'');'#13#10
  ,'  SuppressDesignerProperty(''TXTable'',''Border'');'#13#10'  SuppressDesign'
  +'erProperty(MyNodeType,''ContainerHeight'');'#13#10'  SuppressDesignerProper'
  +'ty(MyNodeType,''ContainerWidth'');'#13#10'end.'#13#10#13#10
]);
