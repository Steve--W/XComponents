  +'lue)-DayOfTheWeek(AValue)+1;'#13#10'end;'#13#10#13#10#13#10'Function EndOfT'
  +'heWeek(const AValue: TDateTime): TDateTime;'#13#10'begin'#13#10'  Result:=E'
