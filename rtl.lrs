  +#10'end;'#13#10#13#10'function TSourceMap.IndexOfSourceFile(const SrcFile: s'
  +'tring;'#13#10'  AddIfNotExists: boolean): integer;'#13#10'var'#13#10'  Src:'
  +' TSourceMapSrc;'#13#10'begin'#13#10'  Result:=FSourceToIndex.FindValue(SrcF'
  +'ile);'#13#10'  if (Result>=0) or not AddIfNotExists then exit;'#13#10'  Src'
  +':=TSourceMapSrc.Create;'#13#10'  Src.Filename:=SrcFile;'#13#10'  Src.Transl'
  +'atedFilename:=SrcFile;'#13#10'  Result:=FSources.Count;'#13#10'  FSources.A'
  +'dd(Src);'#13#10'  FSourceToIndex.Add(SrcFile,Result);'#13#10'end;'#13#10#13
  +#10'function TSourceMap.IndexOfSegmentAt(GeneratedLine, GeneratedCol: intege'
  +'r'#13#10'  ): integer;'#13#10'var'#13#10'  l, r, m: Integer;'#13#10'  aSeg:'
  +' TSourceMapSegment;'#13#10'begin'#13#10'  Sort;'#13#10'  l:=0;'#13#10'  r:='
  +'Count-1;'#13#10'  aSeg:=nil;'#13#10'  while l<=r do'#13#10'    begin'#13#10
  +'    m:=(l+r) div 2;'#13#10'    aSeg:=Items[m];'#13#10'    if aSeg.Generated'
  +'Line<GeneratedLine then'#13#10'      l:=m+1'#13#10'    else if aSeg.Generat'
  +'edLine>GeneratedLine then'#13#10'      r:=m-1'#13#10'    else if aSeg.Gener'
  +'atedColumn<GeneratedCol then'#13#10'      l:=m+1'#13#10'    else if aSeg.Ge'
  +'neratedColumn>GeneratedCol then'#13#10'      r:=m-1'#13#10'    else'#13#10
  +'      begin'#13#10'      // exact match found'#13#10'      Result:=m;'#13#10
  +'      // -> return the leftmost exact match'#13#10'      while Result>0 do'
  +#13#10'        begin'#13#10'        aSeg:=Items[Result-1];'#13#10'        if'
  +' (aSeg.GeneratedLine<>GeneratedLine)'#13#10'            or (aSeg.GeneratedC'
  +'olumn<>GeneratedCol) then'#13#10'          exit;'#13#10'        dec(Result)'
  +';'#13#10'        end;'#13#10'      exit;'#13#10'      end;'#13#10'    end;'
  +#13#10'  // no exact match found'#13#10'  if aSeg=nil then'#13#10'    exit(-'
  +'1);'#13#10'  // return the next lower. Note: there may be no such segment'
  +#13#10'  if (aSeg.GeneratedLine>GeneratedLine)'#13#10'      or ((aSeg.Genera'
  +'tedLine=GeneratedLine) and (aSeg.GeneratedColumn>GeneratedCol)) then'#13#10
  +'    dec(m);'#13#10'  Result:=m;'#13#10'end;'#13#10#13#10'function TSourceMa'
  +'p.Count: integer;'#13#10'begin'#13#10'  Result:=FItems.Count;'#13#10'end;'
