  +'*************************************************'#13#10'}'#13#10#13#10'fun'
  +'ction FilenameIsAbsolute(const aFilename: string): boolean;'#13#10'begin'#13
  +#10'  Result:=NJS_Path.isAbsolute(aFilename);'#13#10'end;'#13#10#13#10'funct'
  +'ion ExpandFileNamePJ(const FileName: string; BaseDir: string): string;'#13
  +#10'var'#13#10'  IsAbs: Boolean;'#13#10'  HomeDir, Fn: String;'#13#10'begin'
  +#13#10'  Fn := GetForcedPathDelims(Filename);'#13#10'  IsAbs := FileNameIsUn'
  +'ixAbsolute(Fn);'#13#10'  if (not IsAbs) then'#13#10'  begin'#13#10'    if ('
  +'(Length(Fn) > 1) and (Fn[1] = ''~'') and (Fn[2] = ''/'')) or (Fn = ''~'') t'
  +'hen'#13#10'    begin'#13#10'      HomeDir := GetEnvironmentVariablePJ(''HOM'
  +'E'');'#13#10'      if not FileNameIsUnixAbsolute(HomeDir) then'#13#10'     '
  +'   HomeDir := ExpandFileNamePJ(HomeDir,'''');'#13#10'      Fn := HomeDir + '
  +'Copy(Fn,2,length(Fn));'#13#10'      IsAbs := True;'#13#10'    end;'#13#10' '
  +' end;'#13#10'  if IsAbs then'#13#10'  begin'#13#10'    Result := ResolveDot'
  +'s(Fn);'#13#10'  end'#13#10'  else'#13#10'  begin'#13#10'    if (BaseDir = '
  +''''') then'#13#10'      Fn := IncludeTrailingPathDelimiter(GetCurrentDirPJ)'
  +' + Fn'#13#10'    else'#13#10'      Fn := IncludeTrailingPathDelimiter(BaseD'
  +'ir) + Fn;'#13#10'    Fn := ResolveDots(Fn);'#13#10'    //if BaseDir is not '
  +'absolute then this needs to be expanded as well'#13#10'    if not FileNameI'
  +'sUnixAbsolute(Fn) then'#13#10'      Fn := ExpandFileNamePJ(Fn, '''');'#13#10
  +'    Result := Fn;'#13#10'  end;'#13#10'end;'#13#10#13#10'function GetCurren'
  +'tDirPJ: String;'#13#10'begin'#13#10'  Result:=GetCurrentDir;'#13#10'end;'#13
  +#10#13#10'function GetPhysicalFilename(const Filename: string; ExceptionOnEr'
  +'ror: boolean'#13#10'  ): string;'#13#10'var'#13#10'  OldPath, NewPath: Stri'
  +'ng;'#13#10'  p, l: integer;'#13#10'begin'#13#10'  Result:=Filename;'#13#10
  +'  p:=1;'#13#10'  l:=length(Result);'#13#10'  while p<=l do'#13#10'  begin'
  +#13#10'    while (p<=l) and (Result[p]=''/'') do'#13#10'      inc(p);'#13#10
  +'    if p>l then exit;'#13#10'    if Result[p]<>''/'' then'#13#10'    begin'
  +#13#10'      repeat'#13#10'        inc(p);'#13#10'      until (p>l) or (Resu'
  +'lt[p]=''/'');'#13#10'      OldPath:=LeftStr(Result,p-1);'#13#10'      NewPa'
  +'th:=ResolveSymLinks(OldPath,ExceptionOnError);'#13#10'      if NewPath='''''
  +' then exit('''');'#13#10'      if OldPath<>NewPath then'#13#10'      begin'
  +#13#10'        Result:=NewPath+copy(Result,length(OldPath)+1,length(Result))'
  +';'#13#10'        p:=length(NewPath)+1;'#13#10'      end;'#13#10'    end;'#13
  +#10'  end;'#13#10'end;'#13#10#13#10'function ResolveSymLinks(const Filename:'
  +' string; ExceptionOnError: boolean'#13#10'  ): string;'#13#10'var'#13#10'  '
  +'LinkFilename: string;'#13#10'  AText: string;'#13#10'  Depth: Integer;'#13
  +#10'begin'#13#10'  Result:=Filename;'#13#10'  Depth:=0;'#13#10'  while Depth'
  +'<12 do'#13#10'  begin'#13#10'    inc(Depth);'#13#10'    try'#13#10'      Li'
  +'nkFilename:=NJS_FS.readlinkSync(Result);'#13#10'    except'#13#10'      if '
  +'not ExceptionOnError then'#13#10'        exit;'#13#10'      if isString(JSE'
  +'xceptValue) then'#13#10'        AText:=String(JSExceptValue)'#13#10'      e'
  +'lse if isObject(JSExceptValue) and isString(TJSObject(JSExceptValue)[''mess'
  +'age'']) then'#13#10'      begin'#13#10'        if TJSObject(JSExceptValue)['
  +'''code'']=''EINVAL'' then'#13#10'        begin'#13#10'          // not a sy'
  +'mbolic link'#13#10'          exit;'#13#10'        end;'#13#10'        AText'
  +':=String(TJSObject(JSExceptValue)[''message'']);'#13#10'      end else'#13
  +#10'        AText:=''uknown error (''+jsTypeOf(JSExceptValue)+'')'';'#13#10
  +'      if Pos(Filename,AText)<1 then'#13#10'        AText+='' "''+Filename+'
  +'''"'';'#13#10'      raise EFOpenError.Create(AText);'#13#10'    end;'#13#10
  +'    if LinkFilename='''' then'#13#10'    begin'#13#10'      // not a symbol'
  +'ic link, just a regular file'#13#10'      exit;'#13#10'    end;'#13#10'    '
  +'if not FilenameIsAbsolute(LinkFilename) then'#13#10'      Result:=ExtractFi'
  +'lePath(Result)+LinkFilename'#13#10'    else'#13#10'      Result:=LinkFilena'
  +'me;'#13#10'  end;'#13#10'  // probably an endless loop'#13#10'  if Exceptio'
  +'nOnError then'#13#10'    raise EFOpenError.Create(''too many links, maybe a'
  +'n endless loop.'')'#13#10'  else'#13#10'    Result:='''';'#13#10'end;'#13#10
  ,#13#10'function FileIsWritable(const AFilename: string): boolean;'#13#10'beg'
  +'in'#13#10'  try'#13#10'    NJS_FS.accessSync(AFilename,W_OK);'#13#10'  exce'
  +'pt'#13#10'    exit(false);'#13#10'  end;'#13#10'  Result:=true;'#13#10'end;'
  +#13#10#13#10'function FileIsExecutable(const AFilename: string): boolean;'#13
  +#10'begin'#13#10'  try'#13#10'    NJS_FS.accessSync(AFilename,X_OK);'#13#10
  +'  except'#13#10'    exit(false);'#13#10'  end;'#13#10'  Result:=true;'#13#10
  +'end;'#13#10#13#10'function GetEnvironmentVariableCountPJ: Integer;'#13#10'b'
  +'egin'#13#10'  Result:=GetEnvironmentVariableCount;'#13#10'end;'#13#10#13#10
  +'function GetEnvironmentStringPJ(Index: Integer): string;'#13#10'begin'#13#10
