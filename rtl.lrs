  +'mentOptions);'#13#10'  AddAttribOptions(MyNodeType,''LabelPos'',LabelPosOpt'
  ,'ions);'#13#10'  {$ifndef JScript}'#13#10'  RegisterClass(TXTree);'#13#10'  '
  +'AddNodeFuncLookup(MyNodeType,@CreateWidget);'#13#10'{$else}'#13#10'  AddNod'
  +'eFuncLookup(MyNodeType,@CreateinterfaceObj,@CreateWidget);'#13#10'  {$endif'
