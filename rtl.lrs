  +'        Writeln(''More than 3 separators'');'#13#10'            FixErrorMsg'
  +'(S);'#13#10'            exit;'#13#10'          end;'#13#10'         // Chec'
  +'k if the year has more then two digits (if n=yp, then we are evaluating the'
  +' year.)'#13#10'        if (n=yp) and (length(s1)>2) then YearMoreThenTwoDig'
  +'its := True;'#13#10'        val(s1, values[n], c);'#13#10'        if c<>0 t'
  +'hen'#13#10'          begin'#13#10'//            Writeln(''S1 not a number '
  +''',S1);'#13#10'            FixErrorMsg(s);'#13#10'            Exit;'#13#10
  +'          end;'#13#10'        s1 := '''';'#13#10'      end'#13#10'     else'
  +' if (Pos(s[i],Digits)=0) then'#13#10'       begin'#13#10'//       Writeln('
  +'''Not a number at pos '',I,'' '',S[i]);'#13#10'       FixErrorMsg(s);'#13#10
  +'       Exit;'#13#10'       end;'#13#10'   end ;'#13#10'//   Writeln(''Which'
  +' : '',Which,'' N : '',N);'#13#10'   if (Which<3) and (N>Which) then'#13#10
  +'    begin'#13#10'    FixErrorMsg(s);'#13#10'    Exit;'#13#10'    end;'#13#10
  +'  // Fill in values.'#13#10'  DecodeDate(Date,Ly,LM,LD);'#13#10'  If N=3 th'
  +'en'#13#10'   begin'#13#10'     y:=values[yp];'#13#10'     m:=values[mp];'#13
  +#10'     d:=values[dp];'#13#10'   end'#13#10'  Else'#13#10'  begin'#13#10'  '
  +'  Y:=ly;'#13#10'    If n<2 then'#13#10'     begin'#13#10'       d:=values[1'
  +'];'#13#10'       m := LM;'#13#10'     end'#13#10'    else'#13#10'     If dp'
  +'<mp then'#13#10'      begin'#13#10'        d:=values[1];'#13#10'        m:='
  +'values[2];'#13#10'      end'#13#10'    else'#13#10'      begin'#13#10'     '
  +'   d:=values[2];'#13#10'        m:=values[1];'#13#10'      end;'#13#10'  en'
  +'d;'#13#10'  if (y >= 0) and (y < 100) and not YearMoreThenTwoDigits then'#13
  +#10'    begin'#13#10'    ly := ly - TwoDigitYearCenturyWindow;'#13#10'    In'
  +'c(Y, ly div 100 * 100);'#13#10'    if (TwoDigitYearCenturyWindow > 0) and ('
  +'Y < ly) then'#13#10'      Inc(Y, 100);'#13#10'    end;'#13#10'  if not TryE'
  +'ncodeDate(y, m, d, result) then'#13#10'    errormsg:=SErrInvalidDate;'#13#10
  +'end;'#13#10#13#10'function StrToDate(const S: String; const useformat : str'
  +'ing; separator : char): TDateTime;'#13#10'Var'#13#10'  MSg : String;'#13#10
  +'begin'#13#10'  Result:=IntStrToDate(Msg,S,useFormat,Separator);'#13#10'  If'
