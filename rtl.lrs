  +'eapYear(Y),M])'#13#10'end;'#13#10#13#10#13#10'Function EndOfTheMonth(const '
  +'AValue: TDateTime): TDateTime;'#13#10#13#10'Var'#13#10'  Y,M,D : Word;'#13
  +#10#13#10'begin'#13#10'  DecodeDate(AValue,Y,M,D);'#13#10'  Result:=EncodeDa'
  +'teTime(Y,M,MonthDays[IsLeapYear(Y),M],23,59,59,999);'#13#10'end;'#13#10#13
  +#10#13#10'Function StartOfAMonth(const AYear, AMonth: Word): TDateTime;'#13
  +#10'begin'#13#10'  Result:=EncodeDate(AYear,AMonth,1);'#13#10'end;'#13#10#13
  +#10#13#10'Function EndOfAMonth(const AYear, AMonth: Word): TDateTime;'#13#10
  +#13#10'begin'#13#10'  Result:=EncodeDateTime(AYear,AMonth,MonthDays[IsLeapYe'
  +'ar(AYear),AMonth],23,59,59,999);'#13#10'end;'#13#10#13#10#13#10'{ ---------'
  +'------------------------------------------------------------'#13#10'    Sta'
  +'rt/End of week functions.'#13#10'  ----------------------------------------'
  +'-----------------------------}'#13#10#13#10#13#10'Function StartOfTheWeek(c'
