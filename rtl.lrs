  +'GetConsoleTextEncoding: string;'#13#10'begin'#13#10'  Result:=GetDefaultTex'
  +'tEncoding;'#13#10'end;'#13#10#13#10'procedure InitPlatform;'#13#10'begin'#13
  +#10#13#10'end;'#13#10#13#10
