  +'********}'#13#10'unit TypInfo;'#13#10#13#10'{$mode objfpc}'#13#10'{$modeswi'
  +'tch externalclass}'#13#10#13#10'interface'#13#10#13#10'uses'#13#10'  SysUti'
  +'ls, Types, RTLConsts, JS;'#13#10#13#10'type'#13#10'  // if you change the f'
  +'ollowing enumeration type in any way'#13#10'  // you also have to change th'
  +'e rtl.js in an appropriate way !'#13#10'  TTypeKind = ('#13#10'    tkUnknow'
  +'n,  // 0'#13#10'    tkInteger,  // 1'#13#10'    tkChar,     // 2 in Delphi/'
  +'FPC tkWChar, tkUChar'#13#10'    tkString,   // 3 in Delphi/FPC tkSString, t'
  +'kWString or tkUString'#13#10'    tkEnumeration, // 4'#13#10'    tkSet,     '
  +' // 5'#13#10'    tkDouble,   // 6'#13#10'    tkBool,     // 7'#13#10'    tk'
  +'ProcVar,  // 8'#13#10'    tkMethod,   // 9  proc var of object'#13#10'    t'
  +'kArray,    // 10 static array'#13#10'    tkDynArray, // 11'#13#10'    tkRec'
  +'ord,   // 12'#13#10'    tkClass,    // 13'#13#10'    tkClassRef, // 14'#13
  +#10'    tkPointer,  // 15'#13#10'    tkJSValue,  // 16'#13#10'    tkRefToPro'
  +'cVar, // 17'#13#10'    tkInterface // 18'#13#10'    //tkObject,'#13#10'    '
  +'//tkSString,tkLString,tkAString,tkWString,'#13#10'    //tkVariant,'#13#10' '
  +'   //tkWChar,'#13#10'    //tkInt64,'#13#10'    //tkQWord,'#13#10'    //tkIn'
  +'terfaceRaw,'#13#10'    //tkUString,tkUChar,'#13#10'    //tkHelper,'#13#10' '
  +'   //tkFile,'#13#10'    );'#13#10'  TTypeKinds = set of TTypeKind;'#13#10#13
  +#10'const'#13#10'  tkFloat = tkDouble; // for compatibility with Delphi/FPC'
  +#13#10'  tkProcedure = tkProcVar; // for compatibility with Delphi'#13#10'  '
  +'tkAny = [Low(TTypeKind)..High(TTypeKind)];'#13#10'  tkMethods = [tkMethod];'
  +#13#10'  tkProperties = tkAny-tkMethods-[tkUnknown];'#13#10#13#10'type'#13#10
  +'  { TTypeInfo }'#13#10#13#10'  TTypeInfo = class external name ''rtl.tTypeI'
  +'nfo'''#13#10'  public'#13#10'    Name: String external name ''name'';'#13#10
  +'    Kind: TTypeKind external name ''kind'';'#13#10'  end;'#13#10'  TTypeInf'
  +'oClassOf = class of TTypeInfo;'#13#10#13#10'  TOrdType  = ('#13#10'    otSB'
  +'yte,      // 0'#13#10'    otUByte,      // 1'#13#10'    otSWord,      // 2'
  +#13#10'    otUWord,      // 3'#13#10'    otSLong,      // 4'#13#10'    otULo'
  +'ng,      // 5'#13#10'    otSIntDouble, // 6 NativeInt'#13#10'    otUIntDoub'
  +'le  // 7 NativeUInt'#13#10'    );'#13#10#13#10'  { TTypeInfoInteger - Kind '
  +'= tkInteger }'#13#10#13#10'  TTypeInfoInteger = class external name ''rtl.t'
  +'TypeInfoInteger''(TTypeInfo)'#13#10'  public'#13#10'    MinValue: NativeInt'
  +' external name ''minvalue'';'#13#10'    MaxValue: NativeInt external name '
  +'''maxvalue'';'#13#10'    OrdType : TOrdType external name ''ordtype'';'#13
  +#10'  end;'#13#10#13#10'  { TEnumType }'#13#10#13#10'  TEnumType = class ext'
  +'ernal name ''anonymous'''#13#10'  private'#13#10'    function GetIntToName('
  +'Index: NativeInt): String; external name ''[]'';'#13#10'    function GetNam'
  +'eToInt(Name: String): NativeInt; external name ''[]'';'#13#10'  public'#13
  +#10'    property IntToName[Index: NativeInt]: String read GetIntToName;'#13
  +#10'    property NameToInt[Name: String]: NativeInt read GetNameToInt;'#13#10
  +'  end;'#13#10#13#10'  { TTypeInfoEnum - Kind = tkEnumeration }'#13#10#13#10
  +'  TTypeInfoEnum = class external name ''rtl.tTypeInfoEnum''(TTypeInfoIntege'
  +'r)'#13#10'  public'#13#10'    // not supported: BaseType: TTypeInfo'#13#10
  +'    EnumType: TEnumType external name ''enumtype'';'#13#10'  end;'#13#10#13
  +#10'  { TTypeInfoSet - Kind = tkSet }'#13#10#13#10'  TTypeInfoSet = class ex'
  +'ternal name ''rtl.tTypeInfoSet''(TTypeInfo)'#13#10'  public'#13#10'    // n'
  +'ot supported: BaseType: TTypeInfo'#13#10'    CompType: TTypeInfo external n'
  +'ame ''comptype'';'#13#10'  end;'#13#10#13#10'  { TTypeInfoStaticArray - Kin'
  +'d = tkArray }'#13#10#13#10'  TTypeInfoStaticArray = class external name ''r'
  +'tl.tTypeInfoStaticArray''(TTypeInfo)'#13#10'  public'#13#10'    Dims: TInte'
  +'gerDynArray;'#13#10'    ElType: TTypeInfo external name ''eltype'';'#13#10
  +'  end;'#13#10#13#10'  { TTypeInfoDynArray - Kind = tkDynArray }'#13#10#13#10
  +'  TTypeInfoDynArray = class external name ''rtl.tTypeInfoDynArray''(TTypeIn'
  +'fo)'#13#10'  public'#13#10'    DimCount: NativeInt external name ''dimcount'
  +''';'#13#10'    ElType: TTypeInfo external name ''eltype'';'#13#10'  end;'#13
  +#10#13#10'  TParamFlag     = ('#13#10'    pfVar,     // 2^0 = 1'#13#10'    p'
