  +') and not CharInSet(FileName[I],EndSep) do'#13#10'    Dec(I);'#13#10'  Resu'
  +'lt := Copy(FileName, I + 1, MaxInt);'#13#10'end;'#13#10#13#10'function Extr'
  +'actFileExt(const FileName: PathStr): PathStr;'#13#10'var'#13#10'  i : longi'
  +'nt;'#13#10'  EndSep : Set of Char;'#13#10'  SOF : Boolean; // Dot at Start '
  +'of filename ?'#13#10#13#10'begin'#13#10'  Result:='''';'#13#10'  I := Lengt'
  +'h(FileName);'#13#10'  EndSep:=AllowDirectorySeparators+AllowDriveSeparators'
  +'+[ExtensionSeparator];'#13#10'  while (I > 0) and not CharInSet(FileName[I]'
  +',EndSep) do'#13#10'    Dec(I);'#13#10'  if (I > 0) and (FileName[I] = Exten'
  +'sionSeparator) then'#13#10'    begin'#13#10'        SOF:=(I=1) or (FileName'
  +'[i-1] in AllowDirectorySeparators);'#13#10'        if (Not SOF) or FirstDot'
  +'AtFileNameStartIsExtension then'#13#10'          Result := Copy(FileName, I'
  +', MaxInt);'#13#10'        end'#13#10'  else'#13#10'    Result := '''';'#13
  +#10'end;'#13#10#13#10'function ExtractRelativepath (Const BaseName,DestName '
  +': PathStr): PathStr;'#13#10#13#10'Var'#13#10'  OneLevelBack,Source, Dest   '
  +': PathStr;'#13#10'  Sc,Dc,I,J      : Longint;'#13#10'  SD,DD          : TPa'
  +'thStrArray;'#13#10#13#10#13#10'begin'#13#10'  OneLevelBack := ''..''+PathDe'
  +'lim;'#13#10'  If Uppercase(ExtractFileDrive(BaseName))<>Uppercase(ExtractFi'
  +'leDrive(DestName)) Then'#13#10'    begin'#13#10'    Result:=DestName;'#13#10
  +'    exit;'#13#10'    end;'#13#10'  Source:=ExcludeTrailingPathDelimiter(Ext'
  +'ractFilePath(BaseName));'#13#10'  Dest:=ExcludeTrailingPathDelimiter(Extrac'
  +'tFilePath(DestName));'#13#10'  SD:=GetDirs (Source);'#13#10'  SC:=Length(SD'
  +');'#13#10'  DD:=GetDirs (Dest);'#13#10'  DC:=Length(SD);'#13#10'  I:=0;'#13
  +#10'  While (I<DC) and (I<SC) do'#13#10'    begin'#13#10'    If SameText(DD['
  +'i],SD[i]) then'#13#10'      Inc(i)'#13#10'    else'#13#10'      Break;'#13
  +#10'    end;'#13#10'  Result:='''';'#13#10'  For J:=I to SC do Result:=Resul'
  +'t+OneLevelBack;'#13#10'  For J:=I to DC do Result:=Result+DD[J]+PathDelim;'
  +#13#10'  Result:=Result+ExtractFileName(DestName);'#13#10'end;'#13#10#13#10
  +'Function SetDirSeparators (Const FileName : PathStr) : PathStr;'#13#10#13#10
  +'Var'#13#10'  I : integer;'#13#10#13#10'begin'#13#10'  Result:=FileName;'#13
  +#10'  For I:=1 to Length(Result) do'#13#10'    If CharInSet(Result[I],AllowD'
  +'irectorySeparators) then'#13#10'      Result[i]:=PathDelim;'#13#10'end;'#13
  +#10#13#10'Function GetDirs (DirName : PathStr) : TPathStrArray;'#13#10#13#10
  +'Var'#13#10'  I,J,L : Longint;'#13#10'  D : String;'#13#10#13#10'begin'#13#10
  +'  I:=1;'#13#10'  J:=0;'#13#10'  L:=0;'#13#10'  SetLength(Result,Length(DirN'
  +'ame));'#13#10'  While I<=Length(DirName) do'#13#10'    begin'#13#10'    If '
  +'CharInSet(DirName[i],AllowDirectorySeparators) then'#13#10'      begin'#13
  +#10'      D:=Copy(DirName,J+1,J-I);'#13#10'      if (D<>'''') then'#13#10'  '
  +'      begin'#13#10'        Result[L]:=D;'#13#10'        Inc(L);'#13#10'    '
  +'    end;'#13#10'      J:=I;'#13#10'      end;'#13#10'    Inc(I);'#13#10'   '
  +' end;'#13#10'  SetLength(Result,L);'#13#10'end;'#13#10#13#10'function Inclu'
  +'deTrailingPathDelimiter(Const Path : PathStr) : PathStr;'#13#10#13#10'Var'
  ,#13#10'  l : Integer;'#13#10#13#10'begin'#13#10'  Result:=Path;'#13#10'  l:='
  +'Length(Result);'#13#10'  If (L=0) or not CharInSet(Result[l],AllowDirectory'
  +'Separators) then'#13#10'    Result:=Result+PathDelim;'#13#10'end;'#13#10#13
  +#10'function ExcludeTrailingPathDelimiter(Const Path: PathStr): PathStr;'#13
  +#10#13#10'Var'#13#10'  L : Integer;'#13#10#13#10'begin'#13#10'  L:=Length(Pa'
  +'th);'#13#10'  If (L>0) and CharInSet(Path[L],AllowDirectorySeparators) then'
  +#13#10'    Dec(L);'#13#10'  Result:=Copy(Path,1,L);'#13#10'end;'#13#10#13#10
  +'function IncludeLeadingPathDelimiter(Const Path : PathStr) : PathStr;'#13#10
  +#13#10'Var'#13#10'  l : Integer;'#13#10#13#10'begin'#13#10'  Result:=Path;'
  +#13#10'  l:=Length(Result);'#13#10'  If (L=0) or not CharInSet(Result[1],All'
  +'owDirectorySeparators) then'#13#10'    Result:=PathDelim+Result;'#13#10'end'
  +';'#13#10#13#10'function ExcludeLeadingPathDelimiter(Const Path: PathStr): P'
  +'athStr;'#13#10#13#10'Var'#13#10'  L : Integer;'#13#10#13#10'begin'#13#10'  '
  +'Result:=Path;'#13#10'  L:=Length(Result);'#13#10'  If (L>0) and CharInSet(R'
  +'esult[1],AllowDirectorySeparators) then'#13#10'    Delete(Result,1,1);'#13
  +#10'end;'#13#10#13#10'function IsPathDelimiter(Const Path: PathStr; Index: I'
  +'nteger): Boolean;'#13#10#13#10'begin'#13#10'  Result:=(Index>0) and (Index<'
  +'=Length(Path)) and CharInSet(Path[Index],AllowDirectorySeparators);'#13#10
  +'end;'#13#10#13#10'function ConcatPaths(const Paths: array of PathStr): Path'
  +'Str;'#13#10'var'#13#10'  I: Integer;'#13#10'begin'#13#10'  if Length(Paths)'
  +' > 0 then'#13#10'  begin'#13#10'    Result := Paths[0];'#13#10'    for I :='
  +' 1 to Length(Paths) - 1 do'#13#10'      Result := IncludeTrailingPathDelimi'
  +'ter(Result) + ExcludeLeadingPathDelimiter(Paths[I]);'#13#10'  end else'#13
  +#10'    Result := '''';'#13#10'end;'#13#10#13#10#13#10'initialization'#13#10
  +'  FormatSettings := TFormatSettings.Create;'#13#10#13#10'end.'#13#10#13#10
]);
LazarusResources.Add('types','PAS',[
  '{'#13#10'    This file is part of the Pas2JS run time library.'#13#10'    Co'
  +'pyright (c) 2018 by Mattias Gaertner'#13#10#13#10'    See the file COPYING.'
  +'FPC, included in this distribution,'#13#10'    for details about the copyri'
  +'ght.'#13#10#13#10'    This program is distributed in the hope that it will '
  +'be useful,'#13#10'    but WITHOUT ANY WARRANTY; without even the implied wa'
  +'rranty of'#13#10'    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.'
  +#13#10#13#10' **************************************************************'
  +'********}'#13#10'unit Types;'#13#10#13#10'{$mode objfpc}'#13#10#13#10'inter'
  +'face'#13#10#13#10'type'#13#10'  TDirection = (FromBeginning, FromEnd);'#13
  +#10#13#10'  TBooleanDynArray = array of Boolean;'#13#10'  TIntegerDynArray ='
  +' array of Integer;'#13#10'  TNativeIntDynArray = array of NativeInt;'#13#10
  +'  TStringDynArray = array of String;'#13#10'  TDoubleDynArray = array of Do'
  +'uble;'#13#10'  TJSValueDynArray = array of JSValue;'#13#10#13#10'  TDuplica'
  +'tes = (dupIgnore, dupAccept, dupError);'#13#10#13#10'  TListCallback = proc'
  +'edure(data, arg: JSValue) of object;'#13#10'  TListStaticCallback = procedu'
  +'re(data, arg: JSValue);'#13#10#13#10'  TSize  = record'#13#10'    cx, cy: i'
  +'nteger;'#13#10'  end;'#13#10#13#10'  TPoint  = record'#13#10'    x, y: inte'
  +'ger;'#13#10'  end;'#13#10#13#10'  TRect  = record'#13#10'    Left, Top, Rig'
  +'ht, Bottom: Integer;'#13#10'  end;'#13#10#13#10'function EqualRect(const r1'
  +',r2 : TRect) : Boolean;'#13#10'function Rect(Left, Top, Right, Bottom : Int'
  +'eger) : TRect;'#13#10'function Bounds(ALeft, ATop, AWidth, AHeight : Intege'
  +'r) : TRect;'#13#10'function Point(x,y : Integer): TPoint; {$IFDEF Has_Inlin'
  +'e}inline;{$ENDIF}'#13#10'function PtInRect(const aRect: TRect; const p: TPo'
  +'int) : Boolean;'#13#10'function IntersectRect(out aRect: TRect; const R1,R2'
  +': TRect) : Boolean;'#13#10'function UnionRect(out aRect: TRect; const R1,R2'
  +': TRect) : Boolean;'#13#10'function IsRectEmpty(const aRect: TRect) : Boole'
  +'an;'#13#10'function OffsetRect(var aRect: TRect; DX, DY: Integer) : Boolean'
  +';'#13#10'function CenterPoint(const aRect: TRect): TPoint;'#13#10'function '
  +'InflateRect(var aRect: TRect; dx, dy: Integer): Boolean;'#13#10'function Si'
  +'ze(AWidth, AHeight: Integer): TSize;'#13#10'function Size(const aRect: TRec'
  +'t): TSize;'#13#10#13#10'implementation'#13#10#13#10'function EqualRect(cons'
  +'t r1, r2: TRect): Boolean;'#13#10'begin'#13#10'  Result:=(r1.left=r2.left) '
  +'and (r1.right=r2.right) and (r1.top=r2.top) and (r1.bottom=r2.bottom);'#13
  +#10'end;'#13#10#13#10'function Rect(Left, Top, Right, Bottom: Integer): TRec'
  +'t;'#13#10'begin'#13#10'  Result.Left:=Left;'#13#10'  Result.Top:=Top;'#13#10
  +'  Result.Right:=Right;'#13#10'  Result.Bottom:=Bottom;'#13#10'end;'#13#10#13
  +#10'function Bounds(ALeft, ATop, AWidth, AHeight: Integer): TRect;'#13#10'be'
  +'gin'#13#10'  Result.Left:=ALeft;'#13#10'  Result.Top:=ATop;'#13#10'  Result'
  +'.Right:=ALeft+AWidth;'#13#10'  Result.Bottom:=ATop+AHeight;'#13#10'end;'#13
  +#10#13#10'function Point(x, y: Integer): TPoint;'#13#10'begin'#13#10'  Resul'
  +'t.x:=x;'#13#10'  Result.y:=y;'#13#10'end;'#13#10#13#10'function PtInRect(co'
  +'nst aRect: TRect; const p: TPoint): Boolean;'#13#10'begin'#13#10'  Result:='
  +'(p.y>=aRect.Top) and'#13#10'          (p.y<aRect.Bottom) and'#13#10'       '
  +'   (p.x>=aRect.Left) and'#13#10'          (p.x<aRect.Right);'#13#10'end;'#13
  +#10#13#10'function IntersectRect(out aRect: TRect; const R1, R2: TRect): Boo'
  +'lean;'#13#10'var'#13#10'  lRect: TRect;'#13#10'begin'#13#10'  lRect := R1;'
  +#13#10'  if R2.Left > R1.Left then'#13#10'    lRect.Left := R2.Left;'#13#10
  +'  if R2.Top > R1.Top then'#13#10'    lRect.Top := R2.Top;'#13#10'  if R2.Ri'
  +'ght < R1.Right then'#13#10'    lRect.Right := R2.Right;'#13#10'  if R2.Bott'
  +'om < R1.Bottom then'#13#10'    lRect.Bottom := R2.Bottom;'#13#10#13#10'  //'
  +' The var parameter is only assigned in the end to avoid problems'#13#10'  /'
  +'/ when passing the same rectangle in the var and const parameters.'#13#10' '
  +' if IsRectEmpty(lRect) then'#13#10'  begin'#13#10'    aRect:=Rect(0,0,0,0);'
  +#13#10'    Result:=false;'#13#10'  end'#13#10'  else'#13#10'  begin'#13#10' '
  +'   Result:=true;'#13#10'    aRect := lRect;'#13#10'  end;'#13#10'end;'#13#10
  +#13#10'function UnionRect(out aRect: TRect; const R1, R2: TRect): Boolean;'
  +#13#10'var'#13#10'  lRect: TRect;'#13#10'begin'#13#10'  lRect:=R1;'#13#10'  '
  +'if R2.Left<R1.Left then'#13#10'    lRect.Left:=R2.Left;'#13#10'  if R2.Top<'
  +'R1.Top then'#13#10'    lRect.Top:=R2.Top;'#13#10'  if R2.Right>R1.Right the'
  +'n'#13#10'    lRect.Right:=R2.Right;'#13#10'  if R2.Bottom>R1.Bottom then'#13
  +#10'    lRect.Bottom:=R2.Bottom;'#13#10#13#10'  if IsRectEmpty(lRect) then'
  +#13#10'  begin'#13#10'    aRect:=Rect(0,0,0,0);'#13#10'    Result:=false;'#13
  +#10'  end'#13#10'  else'#13#10'  begin'#13#10'    aRect:=lRect;'#13#10'    R'
  +'esult:=true;'#13#10'  end;'#13#10'end;'#13#10#13#10'function IsRectEmpty(co'
  ,'nst aRect: TRect): Boolean;'#13#10'begin'#13#10'  Result:=(aRect.Right<=aRe'
  +'ct.Left) or (aRect.Bottom<=aRect.Top);'#13#10'end;'#13#10#13#10'function Of'
  +'fsetRect(var aRect: TRect; DX, DY: Integer): Boolean;'#13#10'begin'#13#10' '
  +' with aRect do'#13#10'    begin'#13#10'    inc(Left,dx);'#13#10'    inc(Top'
  +',dy);'#13#10'    inc(Right,dx);'#13#10'    inc(Bottom,dy);'#13#10'    end;'
  +#13#10'  Result:=true;'#13#10'end;'#13#10#13#10'function CenterPoint(const a'
  +'Rect: TRect): TPoint;'#13#10#13#10'  function Avg(a, b: Longint): Longint;'
  +#13#10'  begin'#13#10'    if a < b then'#13#10'      Result := a + ((b - a) '
  +'shr 1)'#13#10'    else'#13#10'      Result := b + ((a - b) shr 1);'#13#10' '
  +' end;'#13#10#13#10'begin'#13#10'  with aRect do'#13#10'    begin'#13#10'   '
  +'   Result.X := Avg(Left, Right);'#13#10'      Result.Y := Avg(Top, Bottom);'
  +#13#10'    end;'#13#10'end;'#13#10#13#10'function InflateRect(var aRect: TRe'
  +'ct; dx, dy: Integer): Boolean;'#13#10'begin'#13#10'  with aRect do'#13#10' '
  +' begin'#13#10'    dec(Left, dx);'#13#10'    dec(Top, dy);'#13#10'    inc(Ri'
  +'ght, dx);'#13#10'    inc(Bottom, dy);'#13#10'  end;'#13#10'  Result := True'
  +';'#13#10'end;'#13#10#13#10'function Size(AWidth, AHeight: Integer): TSize;'
  +#13#10'begin'#13#10'  Result.cx := AWidth;'#13#10'  Result.cy := AHeight;'#13
  +#10'end;'#13#10#13#10'function Size(const aRect: TRect): TSize;'#13#10'begin'
  +#13#10'  Result.cx := aRect.Right - aRect.Left;'#13#10'  Result.cy := aRect.'
  +'Bottom - aRect.Top;'#13#10'end;'#13#10#13#10'end.'#13#10#13#10
]);
