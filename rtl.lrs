  +',Section,GetObjName(Section.PendingUsedIntf));'#13#10'    end;'#13#10'  // '
  +'read external references'#13#10'  ReadUsedUnitsFinish(Obj,Section,aContext)'
  +';'#13#10'  // read scope, needs external refs'#13#10'  ReadSectionScope(Obj'
  +',Scope,aContext);'#13#10'  aContext.BoolSwitches:=Scope.BoolSwitches;'#13#10
  +'  aContext.ModeSwitches:=Scope.ModeSwitches;'#13#10'  // read declarations,'
