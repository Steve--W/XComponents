  +'ntTypes.Add(''EditBoxPaste'');'#13#10'  {$endif}'#13#10'end;'#13#10#13#10'{'
  +'$ifndef JScript}'#13#10'procedure Register;'#13#10'begin'#13#10'  // Lazaru'
  +'s IDE component registration'#13#10'  RegisterComponents(''XComponents'',[T'
