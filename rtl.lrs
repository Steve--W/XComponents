  +'  n:=TIEnum.EnumType.NameToInt[Value];'#13#10'  if not isUndefined(n) then'
  +#13#10'    SetJSValueProp(Instance,PropInfo,n);'#13#10'end;'#13#10#13#10'fun'
  +'ction GetEnumName(TypeInfo: TTypeInfoEnum; Value: Integer): String;'#13#10
  +'begin'#13#10'  Result:=TypeInfo.EnumType.IntToName[Value];'#13#10'end;'#13
  +#10#13#10'function GetEnumValue(TypeInfo: TTypeInfoEnum; const Name: string)'
  +': Longint;'#13#10'begin'#13#10'  Result:=TypeInfo.EnumType.NameToInt[Name];'
  +#13#10'end;'#13#10#13#10'function GetEnumNameCount(TypeInfo: TTypeInfoEnum):'
  +' Longint;'#13#10'var'#13#10'  o: TJSObject;'#13#10'  l, r: LongInt;'#13#10
  +'begin'#13#10'  o:=TJSObject(TypeInfo.EnumType);'#13#10'  // as of pas2js 1.'
  +'0 the RTTI does not contain a min/max value'#13#10'  // -> use exponential '
  +'search'#13#10'  // ToDo: adapt this once enums with gaps are supported'#13
  +#10'  Result:=1;'#13#10'  while o.hasOwnProperty(String(JSValue(Result))) do'
  +#13#10'    Result:=Result*2;'#13#10'  l:=Result div 2;'#13#10'  r:=Result;'
  +#13#10'  while l<=r do'#13#10'    begin'#13#10'    Result:=(l+r) div 2;'#13
  +#10'    if o.hasOwnProperty(String(JSValue(Result))) then'#13#10'      l:=Re'
  +'sult+1'#13#10'    else'#13#10'      r:=Result-1;'#13#10'    end;'#13#10'  i'
  +'f o.hasOwnProperty(String(JSValue(Result))) then'#13#10'    inc(Result);'#13
  +#10'end;'#13#10#13#10'function GetSetProp(Instance: TObject; const PropName:'
  +' String): String;'#13#10'begin'#13#10'  Result:=GetSetProp(Instance,FindPro'
  +'pInfo(Instance,PropName));'#13#10'end;'#13#10#13#10'function GetSetProp(Ins'
  +'tance: TObject; const PropInfo: TTypeMemberProperty'#13#10'  ): String;'#13
  +#10'var'#13#10'  o: TJSObject;'#13#10'  key, Value: String;'#13#10'  n: Nati'
  +'veInt;'#13#10'  TIEnum: TTypeInfoEnum;'#13#10'  TISet: TTypeInfoSet;'#13#10
  +'begin'#13#10'  Result:='''';'#13#10'  // get enum type if available'#13#10
  +'  TISet:=PropInfo.TypeInfo as TTypeInfoSet;'#13#10'  TIEnum:=nil;'#13#10'  '
  +'if TISet.CompType is TTypeInfoEnum then'#13#10'    TIEnum:=TTypeInfoEnum(TI'
  +'Set.CompType);'#13#10'  // read value'#13#10'  o:=TJSObject(GetJSValueProp('
  +'Instance,PropInfo));'#13#10'  // a set is a JS object, where included eleme'
  +'nt is stored as: o[ElementDecimal]=true'#13#10'  for Key in o do'#13#10'  b'
  +'egin'#13#10'    n:=parseInt(Key,10);'#13#10'    if (TIEnum<>nil) and (n>=TI'
  +'Enum.MinValue) and (n<=TIEnum.MaxValue) then'#13#10'      Value:=TIEnum.Enu'
  +'mType.IntToName[n]'#13#10'    else'#13#10'      Value:=str(n);'#13#10'    i'
  +'f Result<>'''' then Result:=Result+'','';'#13#10'    Result:=Result+Value;'
  +#13#10'  end;'#13#10'  Result:=''[''+Result+'']'';'#13#10'end;'#13#10#13#10
