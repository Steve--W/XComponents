  +' inline;'#13#10'function JSStringToString(const S: TJSString): String; inli'
  +'ne;'#13#10#13#10'implementation'#13#10#13#10'function IsValidJSIdentifier(N'
  +'ame: TJSString; AllowEscapeSeq: boolean): boolean;'#13#10'{$ifdef pas2js}'
  +#13#10'const'#13#10'  HexChars = [''0''..''9'',''a''..''f'',''A''..''F''];'
  +#13#10'var'#13#10'  p, l, i: Integer;'#13#10'begin'#13#10'  Result:=false;'
  +#13#10'  if Name='''' then exit;'#13#10'  l:=length(Name);'#13#10'  p:=1;'#13
  +#10'  while p<=l do'#13#10'    case Name[p] of'#13#10'    ''0''..''9'':'#13
  +#10'      if p=1 then'#13#10'        exit'#13#10'      else'#13#10'        i'
  +'nc(p);'#13#10'    ''a''..''z'',''A''..''Z'',''_'',''$'': inc(p);'#13#10'   '
  +' ''\'':'#13#10'      begin'#13#10'      if not AllowEscapeSeq then exit;'#13
  +#10'      inc(p);'#13#10'      if p>l then exit;'#13#10'      if Name[p]=''x'
  +''' then'#13#10'        begin'#13#10'        // \x00'#13#10'        inc(p);'
  ,#13#10'        if (p>l) or not (Name[p] in HexChars) then exit;'#13#10'     '
  +'   inc(p);'#13#10'        if (p>l) or not (Name[p] in HexChars) then exit;'
  +#13#10'        end'#13#10'      else if Name[p]=''u'' then'#13#10'        be'
  +'gin'#13#10'        inc(p);'#13#10'        if p>l then exit;'#13#10'        '
  +'if Name[p]=''{'' then'#13#10'          begin'#13#10'          // \u{00000}'
  +#13#10'          i:=0;'#13#10'          repeat'#13#10'            inc(p);'#13
  +#10'            if p>l then exit;'#13#10'            case Name[p] of'#13#10
  +'            ''}'': break;'#13#10'            ''0''..''9'': i:=i*16+ord(Name'
  +'[p])-ord(''0'');'#13#10'            ''a''..''f'': i:=i*16+ord(Name[p])-ord('
  +'''a'')+10;'#13#10'            ''A''..''F'': i:=i*16+ord(Name[p])-ord(''A'')'
  +'+10;'#13#10'            else exit;'#13#10'            end;'#13#10'         '
  +'   if i>$FFFF then exit;'#13#10'          until false;'#13#10'          if '
  +'(i>=$D800) and (i<$E000) then exit;'#13#10'          inc(p);'#13#10'       '
  +'   end'#13#10'        else'#13#10'          begin'#13#10'          // \u000'
  +'0'#13#10'          for i:=1 to 4 do'#13#10'            begin'#13#10'       '
  +'     inc(p);'#13#10'            if (p>l) or not (Name[p] in HexChars) then '
  +'exit;'#13#10'            end;'#13#10'          end;'#13#10'        // ToDo:'
  +' check for invalid values like #$D800 and #$0041'#13#10'        end'#13#10
  +'      else'#13#10'        exit; // unknown sequence'#13#10'      end;'#13#10
  +'    #$200C,#$200D: inc(p); // zero width non-joiner/joiner'#13#10'    #$00A'
  +'A..#$2000,'#13#10'    #$200E..#$D7FF:'#13#10'      inc(p); // ToDo: only th'
  +'ose with ID_START/ID_CONTINUE see https://codepoints.net/search?IDC=1'#13#10
  +'    #$D800..#$DFFF:'#13#10'      exit; // double code units are not allowed'
  +' for JS identifiers'#13#10'    #$E000..#$FFFF:'#13#10'      inc(p);'#13#10
  +'    else'#13#10'      exit;'#13#10'    end;'#13#10'  Result:=true;'#13#10'e'
  +'nd;'#13#10'{$else}'#13#10'var'#13#10'  p: TJSPChar;'#13#10'  i: Integer;'#13
  +#10'begin'#13#10'  Result:=false;'#13#10'  if Name='''' then exit;'#13#10'  '
  +'p:=TJSPChar(Name);'#13#10'  repeat'#13#10'    case p^ of'#13#10'    #0:'#13
  +#10'      if p-TJSPChar(Name)=length(Name) then'#13#10'        exit(true)'#13
  +#10'      else'#13#10'        exit;'#13#10'    ''0''..''9'':'#13#10'      if'
  +' p=TJSPChar(Name) then'#13#10'        exit'#13#10'      else'#13#10'       '
  +' inc(p);'#13#10'    ''a''..''z'',''A''..''Z'',''_'',''$'': inc(p);'#13#10' '
  +'   ''\'':'#13#10'      begin'#13#10'      if not AllowEscapeSeq then exit;'
  +#13#10'      inc(p);'#13#10'      if p^=''x'' then'#13#10'        begin'#13
  +#10'        // \x00'#13#10'        for i:=1 to 2 do'#13#10'          begin'
  +#13#10'          inc(p);'#13#10'          if not (p^ in [''0''..''9'',''a''.'
  +'.''f'',''A''..''F'']) then exit;'#13#10'          end;'#13#10'        end'
  +#13#10'      else if p^=''u'' then'#13#10'        begin'#13#10'        inc(p'
  +');'#13#10'        if p^=''{'' then'#13#10'          begin'#13#10'          '
  +'// \u{00000}'#13#10'          i:=0;'#13#10'          repeat'#13#10'        '
  +'    inc(p);'#13#10'            case p^ of'#13#10'            ''}'': break;'
  +#13#10'            ''0''..''9'': i:=i*16+ord(p^)-ord(''0'');'#13#10'        '
  +'    ''a''..''f'': i:=i*16+ord(p^)-ord(''a'')+10;'#13#10'            ''A''..'
  +'''F'': i:=i*16+ord(p^)-ord(''A'')+10;'#13#10'            else exit;'#13#10
  +'            end;'#13#10'            if i>$FFFF then exit;'#13#10'          '
  +'until false;'#13#10'          if (i>=$D800) and (i<$E000) then exit;'#13#10
  +'          inc(p);'#13#10'          end'#13#10'        else'#13#10'         '
  +' begin'#13#10'          // \u0000'#13#10'          for i:=1 to 4 do'#13#10
  +'            begin'#13#10'            inc(p);'#13#10'            if not (p^ '
  +'in [''0''..''9'',''a''..''f'',''A''..''F'']) then exit;'#13#10'            '
  +'end;'#13#10'          end;'#13#10'        // ToDo: check for invalid values'
  +' like #$D800 and #$0041'#13#10'        end'#13#10'      else'#13#10'       '
  +' exit; // unknown sequence'#13#10'      end;'#13#10'    #$200C,#$200D: inc('
  +'p); // zero width non-joiner/joiner'#13#10'    #$00AA..#$2000,'#13#10'    #'
  +'$200E..#$D7FF:'#13#10'      inc(p); // ToDo: only those with ID_START/ID_CO'
  +'NTINUE see https://codepoints.net/search?IDC=1'#13#10'    #$D800..#$DFFF:'
  +#13#10'      exit; // double code units are not allowed for JS identifiers'
  +#13#10'    #$E000..#$FFFF:'#13#10'      inc(p);'#13#10'    else'#13#10'     '
