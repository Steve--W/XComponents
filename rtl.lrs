  +#13#10'{$else}'#13#10#13#10#13#10'procedure addMenuBarStyles;'#13#10'begin'
  +#13#10'asm'#13#10'// ----------------------------------------check if the st'
  +'yles have already been set'#13#10'var x = document.getElementsByTagName("ST'
  +'YLE");'#13#10'var StyleIsSet = false;'#13#10'if (x.length>0){'#13#10'  for '
  +'(var i=0; i<x.length; i++){'#13#10'    var y= x[i].innerHTML;'#13#10'    if'
  +' (y.indexOf("menuBar") !=-1) { StyleIsSet =true}'#13#10'  }'#13#10'}'#13#10
  +#13#10'if (StyleIsSet==false) {'#13#10'//First, the bar. A DIV tag is used w'
  +'ith a style class defined to set the appearance.'#13#10#13#10'var StyleText'
  +'=''<style>'';'#13#10#13#10'StyleText=StyleText + ''div.menuBar {'';'#13#10
  +'StyleText=StyleText + ''font-family: "MS Sans Serif", Arial, sans-serif;'';'
  +#13#10'StyleText=StyleText + ''font-size: 8pt;'';'#13#10'StyleText=StyleText'
  +' + ''font-style: normal;'';'#13#10'StyleText=StyleText + ''font-weight: nor'
  +'mal;'';'#13#10'StyleText=StyleText + ''color: #000000;'';'#13#10'StyleText='
  +'StyleText + ''}'';'#13#10#13#10'StyleText=StyleText + ''div.menuBar {'';'#13
  +#10'StyleText=StyleText + ''  background-color: #d0d0d0;'';'#13#10'StyleText'
  +'=StyleText + ''  border: 2px solid;'';'#13#10'StyleText=StyleText + ''  bor'
  +'der-color: #f0f0f0 #909090 #909090 #f0f0f0;'';'#13#10'StyleText=StyleText +'
  +' ''  padding: 4px 2px 4px 2px;'';'#13#10'StyleText=StyleText + ''  text-ali'
  +'gn: left;'';'#13#10'StyleText=StyleText + ''}'';'#13#10#13#10#13#10'//For t'
  +'he buttons, normal hypertext links (A tags) are used. This way, both a styl'
  +'e class and a hover: pseudo-class can be defined to'#13#10'//set the defaul'
  +'t and mouseover appearance. The style sheet is updated as follows.'#13#10#13
  ,#10'StyleText=StyleText + ''div.menuBar,'';'#13#10'StyleText=StyleText + ''d'
  +'iv.menuBar a.menuButton {'';'#13#10'StyleText=StyleText + ''  font-family: '
  +'"MS Sans Serif", Arial, sans-serif;'';'#13#10'StyleText=StyleText + ''  fon'
  +'t-size: 8pt;'';'#13#10'StyleText=StyleText + ''  font-style: normal;'';'#13
  +#10'StyleText=StyleText + ''  font-weight: normal;'';'#13#10'StyleText=Style'
  +'Text + ''  color: #000000;'';'#13#10'StyleText=StyleText + ''}'';'#13#10#13
  +#10'StyleText=StyleText + ''div.menuBar {'';'#13#10'StyleText=StyleText + '''
  +'  background-color: #d0d0d0;'';'#13#10'StyleText=StyleText + ''  border: 2p'
  +'x solid;'';'#13#10'StyleText=StyleText + ''  border-color: #f0f0f0 #909090 '
  +'#909090 #f0f0f0;'';'#13#10'StyleText=StyleText + ''  padding: 4px 2px 4px 2'
  +'px;'';'#13#10'StyleText=StyleText + ''  text-align: left;'';'#13#10'StyleTe'
  +'xt=StyleText + ''}'';'#13#10#13#10'StyleText=StyleText + ''div.menuBar a.me'
  +'nuButton {'';'#13#10'StyleText=StyleText + ''  background-color: transparen'
  +'t; '';'#13#10'StyleText=StyleText + ''  border: 1px solid #d0d0d0;'';'#13#10
  +'StyleText=StyleText + ''  color: #000000;'';'#13#10'StyleText=StyleText + '
  +'''  cursor: default;'';'#13#10'StyleText=StyleText + ''  left: 0px;'';'#13
  +#10'StyleText=StyleText + ''  margin: 1px;'';'#13#10'StyleText=StyleText + '
  +'''  padding: 2px 6px 2px 6px;'';'#13#10'StyleText=StyleText + ''  position:'
  +' relative;'';'#13#10'StyleText=StyleText + ''  text-decoration: none;'';'#13
  +#10'StyleText=StyleText + ''  top: 0px;'';'#13#10'StyleText=StyleText + ''  '
  +'z-index: 100;'';'#13#10'StyleText=StyleText + ''}'';'#13#10#13#10'StyleText'
  +'=StyleText + ''div.menuBar a.menuButton:hover {'';'#13#10'StyleText=StyleTe'
  +'xt + ''  background-color: transparent;'';'#13#10'StyleText=StyleText + '' '
  +' border-color: #f0f0f0 #909090 #909090 #f0f0f0;'';'#13#10'StyleText=StyleTe'
  +'xt + ''  color: #000000;'';'#13#10'StyleText=StyleText + ''}'';'#13#10'//Fi'
  +'rst, note that the button''s border color on the normal class matches that '
  +'of the bar background, so it will'#13#10'//remain invisible until moused ov'
  +'er. Also, the cursor:default setting to used prevent the normal link cursor'
  +' from'#13#10'//displaying when the buttons are moused over. This makes it l'
  +'ook more like a menu bar found on a typical application window.'#13#10'//Th'
  +'e reason for using relative positioning will be seen later.'#13#10'//'#13#10
  +#13#10#13#10'//When a button is clicked on, we want to change its appearance'
  +', making it look depressed. This is done by defining another style class.'
  +#13#10#13#10'StyleText=StyleText + ''div.menuBar a.menuButtonActive,'';'#13
  +#10'StyleText=StyleText + ''div.menuBar a.menuButtonActive:hover {'';'#13#10
  +'StyleText=StyleText + ''  background-color: #a0a0a0;'';'#13#10'StyleText=St'
  +'yleText + ''  border-color: #909090 #f0f0f0 #f0f0f0 #909090;'';'#13#10'Styl'
  +'eText=StyleText + ''  color: #ffffff;'';'#13#10'StyleText=StyleText + ''  l'
  +'eft: 1px;'';'#13#10'StyleText=StyleText + ''  top: 1px;'';'#13#10'StyleText'
  +'=StyleText + ''}'';'#13#10#13#10#13#10'//A similar approach is used for the'
