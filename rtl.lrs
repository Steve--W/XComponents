  +'ntific then'#13#10'      PadZeroes:=0 // No padding.'#13#10'    else'#13#10
  +'      begin'#13#10'      PadZeroes:=FV.Exponent-(DecimalPos-1);'#13#10'    '
  +'  if (PadZeroes>=0) then'#13#10'        DistToDecimal:=FV.Exponent'#13#10' '
