  +':='')]}''''''+LineEnding;'#13#10'end;'#13#10#13#10'function EncodeBase64VLQ'
  +'(i: NativeInt): String;'#13#10'{ Convert signed number to base64-VLQ:'#13#10
  +'  Each base64 has 6bit, where the most significant bit is the continuation '
  +'bit'#13#10'  (1=there is a next base64 character).'#13#10'  The first chara'
  +'cter contains the sign bit in the last bit (1=negative)'#13#10'  and the 5 '
  +'least significant bits of the number.'#13#10'  For example:'#13#10'  A = 0 '
  +'= %000000 => 0'#13#10'  B = 1 = %000001 => -0'#13#10'  C = 2 = %000010 => 1'
  +#13#10'  iF = 34 5 = %100010 %000101 = + 0001 00101 = 100101 = 37'#13#10'}'
  +#13#10#13#10'  procedure RaiseRange;'#13#10'  begin'#13#10'    raise ERangeE'
  +'rror.Create(''EncodeBase64VLQ'');'#13#10'  end;'#13#10#13#10'var'#13#10'  d'
  +'igits: NativeInt;'#13#10'begin'#13#10'  Result:='''';'#13#10'  if i<0 then'
  +#13#10'    begin'#13#10'    i:=-i;'#13#10'    if i>(High(NativeInt)-1) shr 1'
  +' then'#13#10'      RaiseRange;'#13#10'    i:=(i shl 1)+1;'#13#10'    end'#13
  +#10'  else'#13#10'    begin'#13#10'    if i>High(NativeInt) shr 1 then'#13#10
  +'      RaiseRange;'#13#10'    i:=i shl 1;'#13#10'    end;'#13#10'  repeat'#13
  +#10'    digits:=i and %11111;'#13#10'    i:=i shr 5;'#13#10'    if i>0 then'
  +#13#10'      inc(digits,%100000); // need another char -> set continuation b'
  +'it'#13#10'    Result:=Result+Base64Chars[digits+1];'#13#10'  until i=0;'#13
  +#10'end;'#13#10#13#10'function DecodeBase64VLQ(const s: string): NativeInt;'
  +#13#10'var'#13#10'  {$ifdef UsePChar}'#13#10'  p: PChar;'#13#10'  {$else}'#13
  +#10'  p: integer;'#13#10'  {$endif}'#13#10'begin'#13#10'  if s='''' then'#13
  +#10'    raise EConvertError.Create(''DecodeBase64VLQ empty'');'#13#10'  {$if'
  +'def UsePChar}'#13#10'  p:=PChar(s);'#13#10'  Result:=DecodeBase64VLQ(p);'#13
  +#10'  if p-PChar(s)<>length(s) then'#13#10'    raise EConvertError.Create('''
  +'DecodeBase64VLQ waste'');'#13#10'  {$else}'#13#10'  p:=1;'#13#10'  Result:='
  ,'DecodeBase64VLQ(s,p);'#13#10'  {$endif}'#13#10'end;'#13#10#13#10'function D'
  +'ecodeBase64VLQ('#13#10'  {$ifdef UsePChar}var p: PChar{$else}const s: strin'
  +'g; var p: integer{$endif}): NativeInt;'#13#10'{ Convert base64-VLQ to signe'
  +'d number,'#13#10'  For the fomat see EncodeBase64VLQ'#13#10'}'#13#10'var'#13
  +#10'  {$ifdef UsePChar}'#13#10'  run: PChar;'#13#10'  {$else}'#13#10'  run, '
  +'l: integer;'#13#10'  {$endif}'#13#10#13#10'  procedure RaiseInvalid;'#13#10
  +'  begin'#13#10'    p:=run;'#13#10'    raise ERangeError.Create(''DecodeBase'
  +'64VLQ'');'#13#10'  end;'#13#10#13#10'const'#13#10'  MaxShift = {$ifdef pas2'
  +'js}32{$else}63{$endif}-5; // actually log2(High(NativeInt))-5'#13#10'var'#13
  +#10'  c: Char;'#13#10'  digit, Shift: Integer;'#13#10'begin'#13#10'  Result:'
  +'=0;'#13#10'  Shift:=0;'#13#10'  run:=p;'#13#10'  {$ifdef UsePChar}'#13#10' '
  +' {$else}'#13#10'  l:=length(s);'#13#10'  {$endif}'#13#10'  repeat'#13#10'  '
  +'  {$ifdef UsePChar}'#13#10'    c:=run^;'#13#10'    {$else}'#13#10'    if ru'
  +'n>l then'#13#10'      RaiseInvalid;'#13#10'    c:=s[run];'#13#10'    {$endi'
  +'f}'#13#10'    case c of'#13#10'    ''A''..''Z'': digit:=ord(c)-ord(''A'');'
  +#13#10'    ''a''..''z'': digit:=ord(c)-ord(''a'')+26;'#13#10'    ''0''..''9'
  +''': digit:=ord(c)-ord(''0'')+52;'#13#10'    ''+'': digit:=62;'#13#10'    '''
  +'/'': digit:=63;'#13#10'    else RaiseInvalid;'#13#10'    end;'#13#10'    in'
  +'c(run);'#13#10'    if Shift>MaxShift then'#13#10'      RaiseInvalid;'#13#10
  +'    inc(Result,(digit and %11111) shl Shift);'#13#10'    inc(Shift,5);'#13
  +#10'  until digit<%100000;'#13#10'  if (Result and 1)>0 then'#13#10'    Resu'
  +'lt:=-(Result shr 1)'#13#10'  else'#13#10'    Result:=Result shr 1;'#13#10' '
  +' p:=run;'#13#10'end;'#13#10#13#10'function CompareSegmentWithGeneratedLineC'
  +'ol('#13#10'    Item1, Item2: {$ifdef pas2js}jsvalue{$else}Pointer{$endif}):'
  +' Integer;'#13#10'var'#13#10'  Seg1: TSourceMapSegment absolute Item1;'#13#10
  +'  Seg2: TSourceMapSegment absolute Item2;'#13#10'begin'#13#10'  if Seg1.Gen'
  +'eratedLine<Seg2.GeneratedLine then'#13#10'    Result:=-1'#13#10'  else if S'
  +'eg1.GeneratedLine>Seg2.GeneratedLine then'#13#10'    Result:=1'#13#10'  els'
  +'e if Seg1.GeneratedColumn<Seg2.GeneratedColumn then'#13#10'    Result:=-1'
  +#13#10'  else if Seg1.GeneratedColumn>Seg2.GeneratedColumn then'#13#10'    R'
  +'esult:=1'#13#10'  // compare Index to keep adding order'#13#10'  else if Se'
  +'g1.Index<Seg2.Index then'#13#10'    Result:=-1'#13#10'  else if Seg1.Index>'
