  +'egin'#13#10'    asm'#13#10'     Section=E.toPrecision(15);'#13#10'    end;'
  +#13#10'    Result:=Section;'#13#10'    end;'#13#10'  // Get Started'#13#10' '
  +' I:=1;'#13#10'  Current:=0;'#13#10'  Q:='' '';'#13#10'  InLiteral:=False;'
  +#13#10'  if (FV.Negative) and (S=1) then'#13#10'    ToResult(''-'');'#13#10
  +'  while (I<=SectionLength) do'#13#10'    begin'#13#10'    C:=Section[i];'#13
  +#10'    // Writeln(''Analyzing pos '',I,'': "'',C,''"'');'#13#10'    If (C i'
