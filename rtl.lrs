  +'irtual,pmOverride]*TPasProcedure(Arg.Parent.Parent).Modifiers<>[]) then'#13
  +#10'          EmitMessage(20180625153623,mtHint,nPAParameterInOverrideNotUse'
  +'d,'#13#10'            sPAParameterInOverrideNotUsed,[Arg.Name],Arg)'#13#10
  +'        else'#13#10'          EmitMessage(20170312094401,mtHint,nPAParamete'
  +'rNotUsed,'#13#10'            sPAParameterNotUsed,[Arg.Name],Arg);'#13#10'  '
  +'      end'#13#10'      else'#13#10'        begin'#13#10'        // paramete'
  +'r was used'#13#10'        if (Usage.Access=paiaWrite) and not (Arg.Access i'
  +'n [argOut,argVar]) then'#13#10'          EmitMessage(20170312095348,mtHint,'
  +'nPAValueParameterIsAssignedButNeverUsed,'#13#10'            sPAValueParamet'
  +'erIsAssignedButNeverUsed,[Arg.Name],Arg);'#13#10'        end;'#13#10'      '
  +'end;'#13#10'    // check result'#13#10'    if (El is TPasFunction) then'#13
  +#10'      begin'#13#10'      PosEl:=TPasFunction(El).FuncType.ResultEl;'#13
  +#10'      if (ProcScope.ImplProc<>nil) and (TPasFunction(ProcScope.ImplProc)'
  +'.FuncType.ResultEl<>nil) then'#13#10'        PosEl:=TPasFunction(ProcScope.'
  +'ImplProc).FuncType.ResultEl;'#13#10'      Usage:=FindElement(TPasFunction(E'
