  +'nteger;'#13#10'  Data: TJSONData;'#13#10'  El: TPasElement;'#13#10'  C: TCl'
  +'ass;'#13#10'begin'#13#10'  if not ReadArray(Obj,''Declarations'',Arr,Sectio'
