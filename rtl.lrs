  +'Year, AWeekOfYear: Word): TDateTime;  // ADayOFWeek 1'#13#10'begin'#13#10' '
  +' Result:=StartOfAWeek(AYear,AWeekOfYear,1)'#13#10'end;'#13#10#13#10#13#10'F'
  +'unction EndOfAWeek(const AYear, AWeekOfYear: Word; const ADayOfWeek: Word):'
  +' TDateTime;'#13#10'begin'#13#10'  Result := EndOfTheDay(EncodeDateWeek(AYea'
  +'r, AWeekOfYear, ADayOfWeek));'#13#10'end;'#13#10#13#10#13#10'Function EndOf'
  +'AWeek(const AYear, AWeekOfYear: Word): TDateTime; // const ADayOfWeek: Word'
  +' = 7'#13#10#13#10#13#10'begin'#13#10'  Result:=EndOfAWeek(AYear,AWeekOfYear'
  +',7);'#13#10'end;'#13#10#13#10'{ -------------------------------------------'
  +'--------------------------'#13#10'    Start/End of day functions.'#13#10'  '
  ,'---------------------------------------------------------------------}'#13
  +#10#13#10'Function StartOfTheDay(const AValue: TDateTime): TDateTime;'#13#10
  +'begin'#13#10'  Result:=Trunc(Avalue);'#13#10'end;'#13#10#13#10#13#10'Functi'
  +'on EndOfTheDay(const AValue: TDateTime): TDateTime;'#13#10#13#10'Var'#13#10
  +'  Y,M,D : Word;'#13#10#13#10'begin'#13#10'  DecodeDate(AValue,Y,M,D);'#13#10
  +'  Result:=EncodeDateTime(Y,M,D,23,59,59,999);'#13#10'end;'#13#10#13#10#13#10
  +'Function StartOfADay(const AYear, AMonth, ADay: Word): TDateTime;'#13#10'be'
  +'gin'#13#10'  Result:=EncodeDate(AYear,AMonth,ADay);'#13#10'end;'#13#10#13#10
  +#13#10'Function StartOfADay(const AYear, ADayOfYear: Word): TDateTime;'#13#10
  +'begin'#13#10'  Result:=StartOfAYear(AYear)+ADayOfYear-1;'#13#10'end;'#13#10
  +#13#10#13#10'Function EndOfADay(const AYear, AMonth, ADay: Word): TDateTime;'
  +#13#10'begin'#13#10'  Result:=EndOfTheDay(EncodeDate(AYear,AMonth,ADay));'#13
  +#10'end;'#13#10#13#10#13#10'Function EndOfADay(const AYear, ADayOfYear: Word'
  +'): TDateTime;'#13#10#13#10#13#10'begin'#13#10'  Result:=StartOfAYear(AYear)'
  +'+ADayOfYear-1+EncodeTime(23,59,59,999);'#13#10'end;'#13#10#13#10'{ --------'
  +'-------------------------------------------------------------'#13#10'    Pa'
  +'rt of year functions.'#13#10'  --------------------------------------------'
  +'-------------------------}'#13#10#13#10#13#10'Function MonthOfTheYear(const'
  +' AValue: TDateTime): Word;'#13#10'begin'#13#10'  Result:=MonthOf(AValue);'
  +#13#10'end;'#13#10#13#10#13#10'Function WeekOfTheYear(const AValue: TDateTim'
