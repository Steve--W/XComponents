  +#10'    {$ENDIF}'#13#10'    {$IFDEF Pas2js}'#13#10'    if (Len >= 2) and (Re'
  +'sult[2]=Result[1]) and (PathDelim=''\'') then'#13#10'      MinLen := 2; // '
  +'keep UNC ''\\'', chomp ''a\'' to ''a'''#13#10'    {$ENDIF}'#13#10'  end'#13
  +#10'  else begin'#13#10'    MinLen := 0;'#13#10'    {$IFdef MSWindows}'#13#10
  +'    if (Len >= 3) and (Result[1] in [''a''..''z'', ''A''..''Z''])  and'#13
  +#10'       (Result[2] = '':'') and (Result[3] in AllowDirectorySeparators)'
  +#13#10'    then'#13#10'      MinLen := 3;'#13#10'    {$ENDIF}'#13#10'    {$I'
  +'Fdef Pas2js}'#13#10'    if (PathDelim=''\'')'#13#10'        and (Len >= 3) '
  ,'and (Result[1] in [''a''..''z'', ''A''..''Z''])'#13#10'        and (Result['
  +'2] = '':'') and (Result[3] in AllowDirectorySeparators)'#13#10'    then'#13
  +#10'      MinLen := 3;'#13#10'    {$ENDIF}'#13#10'  end;'#13#10#13#10'  whil'
  +'e (Len > MinLen) and (Result[Len] in AllowDirectorySeparators) do dec(Len);'
  +#13#10'  if Len<length(Result) then'#13#10'    SetLength(Result,Len);'#13#10
  +'end;'#13#10#13#10'function NormalizeEncoding(const Encoding: string): strin'
  +'g;'#13#10'var'#13#10'  i: Integer;'#13#10'begin'#13#10'  Result:=LowerCase('
  +'Encoding);'#13#10'  for i:=length(Result) downto 1 do'#13#10'    if Result['
  +'i]=''-'' then Delete(Result,i,1);'#13#10'end;'#13#10#13#10'{$IFDEF WINDOWS}'
  +#13#10'function GetWindowsEncoding(AConsole: Boolean = False): string;'#13#10
  +'var'#13#10'  cp : UINT;'#13#10'{$IFDEF WinCE}'#13#10'// CP_UTF8 is missing '
  +'in the windows unit of the Windows CE RTL'#13#10'const'#13#10'  CP_UTF8 = 6'
  +'5001;'#13#10'{$ENDIF}'#13#10'begin'#13#10'  if AConsole then cp := GetOEMCP'
  +#13#10'  else cp := GetACP;'#13#10#13#10'  case cp of'#13#10'    CP_UTF8: Re'
  +'sult := EncodingUTF8;'#13#10'  else'#13#10'    Result:=''cp''+IntToStr(cp);'
  +#13#10'  end;'#13#10'end;'#13#10'{$ENDIF}'#13#10#13#10'function IsASCII(cons'
  +'t s: string): boolean; inline;'#13#10'{$IFDEF Pas2js}'#13#10'var'#13#10'  i'
  +': Integer;'#13#10'begin'#13#10'  for i:=1 to length(s) do'#13#10'    if s[i'
  +']>#127 then exit(false);'#13#10'  Result:=true;'#13#10'end;'#13#10'{$ELSE}'
  +#13#10'var'#13#10'  p: PChar;'#13#10'begin'#13#10'  if s='''' then exit(true'
  +');'#13#10'  p:=PChar(s);'#13#10'  repeat'#13#10'    case p^ of'#13#10'    #'
  +'0: if p-PChar(s)=length(s) then exit(true);'#13#10'    #128..#255: exit(fal'
  +'se);'#13#10'    end;'#13#10'    inc(p);'#13#10'  until false;'#13#10'end;'
  +#13#10'{$ENDIF}'#13#10#13#10'{$IFDEF FPC_HAS_CPSTRING}'#13#10'function UTF8C'
  +'haracterStrictLength(P: PChar): integer;'#13#10'begin'#13#10'  if p=nil the'
  +'n exit(0);'#13#10'  if ord(p^)<%10000000 then'#13#10'  begin'#13#10'    // '
  +'regular single byte character'#13#10'    exit(1);'#13#10'  end'#13#10'  els'
  +'e if ord(p^)<%11000000 then'#13#10'  begin'#13#10'    // invalid single byt'
  +'e character'#13#10'    exit(0);'#13#10'  end'#13#10'  else if ((ord(p^) and'
  +' %11100000) = %11000000) then'#13#10'  begin'#13#10'    // should be 2 byte'
  +' character'#13#10'    if (ord(p[1]) and %11000000) = %10000000 then'#13#10
  +'      exit(2)'#13#10'    else'#13#10'      exit(0);'#13#10'  end'#13#10'  e'
  +'lse if ((ord(p^) and %11110000) = %11100000) then'#13#10'  begin'#13#10'   '
  +' // should be 3 byte character'#13#10'    if ((ord(p[1]) and %11000000) = %'
  +'10000000)'#13#10'    and ((ord(p[2]) and %11000000) = %10000000) then'#13#10
  +'      exit(3)'#13#10'    else'#13#10'      exit(0);'#13#10'  end'#13#10'  e'
  +'lse if ((ord(p^) and %11111000) = %11110000) then'#13#10'  begin'#13#10'   '
  +' // should be 4 byte character'#13#10'    if ((ord(p[1]) and %11000000) = %'
  +'10000000)'#13#10'    and ((ord(p[2]) and %11000000) = %10000000)'#13#10'   '
  +' and ((ord(p[3]) and %11000000) = %10000000) then'#13#10'      exit(4)'#13
  +#10'    else'#13#10'      exit(0);'#13#10'  end else'#13#10'    exit(0);'#13
  +#10'end;'#13#10#13#10'function UTF8ToUTF16(const s: string): UnicodeString;'
  +#13#10'begin'#13#10'  Result:=UTF8Decode(s);'#13#10'end;'#13#10#13#10'functi'
  +'on UTF16ToUTF8(const s: UnicodeString): string;'#13#10'begin'#13#10'  if s='
  +''''' then exit('''');'#13#10'  Result:=UTF8Encode(s);'#13#10'  // prevent U'
  +'TF8 codepage appear in the strings - we don''t need codepage'#13#10'  // co'
  +'nversion magic'#13#10'  SetCodePage(RawByteString(Result), CP_ACP, False);'
  +#13#10'end;'#13#10'{$ENDIF}'#13#10#13#10'function IsNonUTF8System: boolean;'
  +#13#10'begin'#13#10'  Result:=NonUTF8System;'#13#10'end;'#13#10#13#10'{$IFDE'
  +'F UNIX}'#13#10'{$IFNDEF Darwin}'#13#10'function GetUnixEncoding: string;'#13
  +#10'var'#13#10'  i: integer;'#13#10'begin'#13#10'  Result:=EncodingSystem;'
  +#13#10'  i:=pos(''.'',Lang);'#13#10'  if (i>0) and (i<=length(Lang)) then'#13
  +#10'    Result:=copy(Lang,i+1,length(Lang)-i);'#13#10'end;'#13#10'{$ENDIF}'
  +#13#10'{$ENDIF}'#13#10#13#10'function GetDefaultTextEncoding: string;'#13#10
  +#13#10#13#10'begin'#13#10'  if EncodingValid then'#13#10'  begin'#13#10'    '
  +'Result:=DefaultTextEncoding;'#13#10'    exit;'#13#10'  end;'#13#10#13#10'  '
  +'{$IFDEF Pas2js}'#13#10'  Result:=EncodingUTF8;'#13#10'  {$ELSE}'#13#10'    '
  +'{$IFDEF Windows}'#13#10'    Result:=GetWindowsEncoding;'#13#10'    {$ELSE}'
  +#13#10'      {$IFDEF Darwin}'#13#10'      Result:=EncodingUTF8;'#13#10'     '
  +' {$ELSE}'#13#10'      // unix'#13#10'      Lang := GetEnvironmentVariable('
  +'''LC_ALL'');'#13#10'      if Lang='''' then'#13#10'      begin'#13#10'     '
  +'   Lang := GetEnvironmentVariable(''LC_MESSAGES'');'#13#10'        if Lang='
  +''''' then'#13#10'          Lang := GetEnvironmentVariable(''LANG'');'#13#10
  +'      end;'#13#10'      Result:=GetUnixEncoding;'#13#10'      {$ENDIF}'#13
  ,#10'    {$ENDIF}'#13#10'  {$ENDIF}'#13#10'  Result:=NormalizeEncoding(Result'
  +');'#13#10#13#10'  DefaultTextEncoding:=Result;'#13#10'  EncodingValid:=true'
  +';'#13#10'end;'#13#10#13#10'procedure InternalInit;'#13#10'begin'#13#10'  {$'
  +'IFDEF FPC_HAS_CPSTRING}'#13#10'  SetMultiByteConversionCodePage(CP_UTF8);'
  +#13#10'  // SetMultiByteFileSystemCodePage(CP_UTF8); not needed, this is the'
  +' default under Windows'#13#10'  SetMultiByteRTLFileSystemCodePage(CP_UTF8);'
  +#13#10#13#10'  GetDefaultTextEncoding;'#13#10'  {$IFDEF Windows}'#13#10'  gN'
  +'onUTF8System:=true;'#13#10'  {$ELSE}'#13#10'  gNonUTF8System:=SysUtils.Comp'
  +'areText(DefaultTextEncoding,''UTF8'')<>0;'#13#10'  {$ENDIF}'#13#10'  {$ENDI'
  +'F}'#13#10'end;'#13#10'procedure SplitCmdLineParams(const Params: string; Pa'
  +'ramList: TStrings;'#13#10'                             ReadBackslash: boole'
  +'an = false);'#13#10'// split spaces, quotes are parsed as single parameter'
  +#13#10'// if ReadBackslash=true then \" is replaced to " and not treated as '
  +'quote'#13#10'// #0 is always end'#13#10'type'#13#10'  TMode = (mNormal,mApo'
  +'strophe,mQuote);'#13#10'var'#13#10'  p: Integer;'#13#10'  Mode: TMode;'#13
  +#10'  Param: String;'#13#10'begin'#13#10'  p:=1;'#13#10'  while p<=length(Pa'
  +'rams) do'#13#10'  begin'#13#10'    // skip whitespace'#13#10'    while (p<='
  +'length(Params)) and (Params[p] in ['' '',#9,#10,#13]) do inc(p);'#13#10'   '
  +' if (p>length(Params)) or (Params[p]=#0) then'#13#10'      break;'#13#10'  '
  +'  // read param'#13#10'    Param:='''';'#13#10'    Mode:=mNormal;'#13#10'  '
  +'  while p<=length(Params) do'#13#10'    begin'#13#10'      case Params[p] o'
  +'f'#13#10'      #0:'#13#10'        break;'#13#10'      ''\'':'#13#10'       '
  +' begin'#13#10'          inc(p);'#13#10'          if ReadBackslash then'#13
  +#10'            begin'#13#10'            // treat next character as normal c'
  +'haracter'#13#10'            if (p>length(Params)) or (Params[p]=#0) then'#13
  +#10'              break;'#13#10'            if ord(Params[p])<128 then'#13#10
  +'            begin'#13#10'              Param+=Params[p];'#13#10'           '
  +'   inc(p);'#13#10'            end else begin'#13#10'              // next c'
  +'haracter is already a normal character'#13#10'            end;'#13#10'     '
  +'     end else begin'#13#10'            // treat backslash as normal charact'
  +'er'#13#10'            Param+=''\'';'#13#10'          end;'#13#10'        en'
  +'d;'#13#10'      '''''''':'#13#10'        begin'#13#10'          inc(p);'#13
  +#10'          case Mode of'#13#10'          mNormal:'#13#10'            Mode'
  +':=mApostrophe;'#13#10'          mApostrophe:'#13#10'            Mode:=mNorm'
  +'al;'#13#10'          mQuote:'#13#10'            Param+='''''''';'#13#10'   '
  +'       end;'#13#10'        end;'#13#10'      ''"'':'#13#10'        begin'#13
  +#10'          inc(p);'#13#10'          case Mode of'#13#10'          mNormal'
  +':'#13#10'            Mode:=mQuote;'#13#10'          mApostrophe:'#13#10'   '
  +'         Param+=''"'';'#13#10'          mQuote:'#13#10'            Mode:=mN'
  +'ormal;'#13#10'          end;'#13#10'        end;'#13#10'      '' '',#9,#10,'
  +'#13:'#13#10'        begin'#13#10'          if Mode=mNormal then break;'#13
  +#10'          Param+=Params[p];'#13#10'          inc(p);'#13#10'        end;'
  +#13#10'      else'#13#10'        Param+=Params[p];'#13#10'        inc(p);'#13
  +#10'      end;'#13#10'    end;'#13#10'    //writeln(''SplitCmdLineParams Par'
  +'am=#''+Param+''#'');'#13#10'    ParamList.Add(Param);'#13#10'  end;'#13#10
  +'end;'#13#10#13#10#13#10'initialization'#13#10'  InternalInit;'#13#10'end.'
  +#13#10#13#10
]);
LazarusResources.Add('pas2jscompiler','PP',[
  '{ Author: Mattias Gaertner  2018  mattias@freepascal.org'#13#10#13#10'Abstra'
  +'ct:'#13#10'  TPas2jsCompiler is the wheel boss of the pas2js compiler.'#13
  +#10'  It can be used in a command line program or compiled into an applicati'
  +'on.'#13#10#13#10'  TPas2jsCompiler does not have understanding of the file '
  +'system.'#13#10'  DO NOT ADD filesystem related calls to this unit.'#13#10' '
  +' The file system is abstracted out in TPas2JSFS (unit pas2jsfs)'#13#10'  Ad'
  +'d high-level calls to TPas2JSFS instead or  create virtual methods that can'
  +' be overridden.'#13#10#13#10'  FileSystem specific things should go in Pas2'
  +'JSFileCache and Pas2JSFSCompiler.'#13#10#13#10'Compiler-ToDos:'#13#10'  War'
  +'n if -Ju and -Fu intersect'#13#10'  -Fa<x>[,y] (for a program) load units <'
  +'x> and [y] before uses is parsed'#13#10'  Add Windows macros, see InitMacro'
  +'s.'#13#10'  add options for names of globals like ''pas'' and ''rtl'''#13#10
  +'}'#13#10'unit Pas2jsCompiler;'#13#10#13#10'{$mode objfpc}{$H+}'#13#10#13#10
  +'{$I pas2js_defines.inc}'#13#10#13#10'{$IF defined(VerboseUnitQueue) or defi'
  +'ned(VerbosePCUFiler)}'#13#10'{$DEFINE ReallyVerbose}'#13#10'{$ENDIF}'#13#10
  +#13#10'interface'#13#10#13#10'uses'#13#10'  {$IFDEF Pas2js}'#13#10'  JS,'#13
  +#10'  {$ELSE}'#13#10'  RtlConsts,'#13#10'  {$ENDIF}'#13#10'  // !! No filesy'
  +'stem units here.'#13#10'  Classes, SysUtils, contnrs,'#13#10'  jstree, jswr'
  +'iter, JSSrcMap,'#13#10'  PScanner, PParser, PasTree, PasResolver, PasUseAna'
  +'lyzer, PasResolveEval,'#13#10'  FPPas2Js, FPPJsSrcMap, Pas2jsLogger, Pas2js'
  +'FS, Pas2jsPParser;'#13#10#13#10'const'#13#10'  VersionMajor = 1;'#13#10'  V'
  +'ersionMinor = 1;'#13#10'  VersionRelease = 1;'#13#10'  VersionExtra = '''';'
  +#13#10'  DefaultConfigFile = ''pas2js.cfg'';'#13#10#13#10'//----------------'
  +'--------------------------------------------------------------'#13#10'// Me'
  +'ssages'#13#10'const'#13#10'  nOptionIsEnabled = 101; sOptionIsEnabled = ''O'
  +'ption "%s" is %s'';'#13#10'  nSyntaxModeIs = 102; sSyntaxModeIs = ''Syntax '
  +'mode is %s'';'#13#10'  nMacroDefined = 103; sMacroDefined = ''Macro defined'
  +': %s'';'#13#10'  nNameValue = 106; sNameValue = ''%s: %s'';'#13#10'  nReadi'
  +'ngOptionsFromFile = 107; sReadingOptionsFromFile = ''Reading options from f'
  +'ile %s'';'#13#10'  nEndOfReadingConfigFile = 108; sEndOfReadingConfigFile ='
  +' ''End of reading config file %s'';'#13#10'  nInterpretingFileOption = 109;'
  +' sInterpretingFileOption = ''interpreting file option %s'';'#13#10'  nSourc'
  +'eFileNotFound = 110; sSourceFileNotFound = ''source file not found %s'';'#13
  +#10'  nFileIsFolder = 111; sFileIsFolder = ''expected file, but found direct'
  +'ory %s'';'#13#10'  nConfigFileSearch = 112; sConfigFileSearch = ''Configfil'
  +'e search: %s'';'#13#10'  nHandlingOption = 113; sHandlingOption = ''handlin'
  +'g option %s'';'#13#10'  nQuickHandlingOption = 114; sQuickHandlingOption = '
  +'''quick handling option %s'';'#13#10'  nOutputDirectoryNotFound = 115; sOut'
  +'putDirectoryNotFound = ''output directory not found: %s'';'#13#10'  nUnable'
  +'ToWriteFile = 116; sUnableToWriteFile = ''Unable to write file %s'';'#13#10
  +'  nWritingFile = 117; sWritingFile = ''Writing file %s ...'';'#13#10'  nCom'
  +'pilationAborted = 118; sCompilationAborted = ''Compilation aborted'';'#13#10
  +'  nCfgDirective = 119; sCfgDirective = ''cfg directive %s: %s'';'#13#10'  n'
  +'UnitCycle = 120; sUnitCycle = ''Unit cycle found %s'';'#13#10'  nOptionForb'
  +'idsCompile = 121; sOptionForbidsCompile = ''Option -Ju forbids to compile u'
  +'nit "%s"'';'#13#10'  nUnitNeedsCompileDueToUsedUnit = 122; sUnitsNeedCompil'
  +'eDueToUsedUnit = ''Unit "%s" needs compile due to used unit "%s"'';'#13#10
  +'  nUnitNeedsCompileDueToOption = 123; sUnitsNeedCompileDueToOption = ''Unit'
  +' "%s" needs compile due to option "%s"'';'#13#10'  nUnitNeedsCompileJSMissi'
  +'ng = 124; sUnitsNeedCompileJSMissing = ''Unit "%s" needs compile, js file m'
  +'issing "%s"'';'#13#10'  nUnitNeedsCompilePasHasChanged = 125; sUnitsNeedCom'
  +'pilePasHasChanged = ''Unit "%s" needs compile, Pascal file has changed, js '
  +'is %s'';'#13#10'  nParsingFile = 126; sParsingFile = ''Parsing %s ...'';'#13
  +#10'  nCompilingFile = 127; sCompilingFile = ''Compiling %s ...'';'#13#10'  '
  +'nExpectedButFound = 128; sExpectedButFound = ''Illegal unit name: Expected '
  +'"%s", but found "%s"'';'#13#10'  nLinesInFilesCompiled = 129; sLinesInFiles'
  +'Compiled = ''%s lines in %s files compiled, %s sec%s'';'#13#10'  nTargetPla'
  +'tformIs = 130; sTargetPlatformIs = ''Target platform is %s'';'#13#10'  nTar'
  +'getProcessorIs = 131; sTargetProcessorIs = ''Target processor is %s'';'#13
  +#10'  nMessageEncodingIs = 132; sMessageEncodingIs = ''Message encoding is %'
  +'s'';'#13#10'  nUnableToTranslatePathToDir = 133; sUnableToTranslatePathToDi'
  +'r = ''Unable to translate path %s to directory %s'';'#13#10'  nSrcMapSource'
  +'RootIs = 134; sSrcMapSourceRootIs = ''source map "sourceRoot" is %s'';'#13
  +#10'  nSrcMapBaseDirIs = 135; sSrcMapBaseDirIs = ''source map "local base di'
  ,'rectory" is %s'';'#13#10'  nUnitFileNotFound = 136; sUnitFileNotFound = ''u'
  +'nit file not found %s'';'#13#10'  nClassInterfaceStyleIs = 137; sClassInter'
  +'faceStyleIs = ''Class interface style is %s'';'#13#10'  nMacroXSetToY = 138'
  +'; sMacroXSetToY = ''Macro %s set to %s'';'#13#10'  nPostProcessorInfoX = 13'
  +'9; sPostProcessorInfoX = ''Post processor: %s'';'#13#10'  nPostProcessorRun'
  +'X = 140; sPostProcessorRunX = ''Run post processor: %s'';'#13#10'  nPostPro'
  +'cessorFailX = 141; sPostProcessorFailX = ''Post processor failed: %s'';'#13
  +#10'  nPostProcessorWarnX = 142; sPostProcessorWarnX = ''Post processor: %s'
  +''';'#13#10'  nPostProcessorFinished = 143; sPostProcessorFinished = ''Post '
  +'processor finished'';'#13#10'  // Note: error numbers 201+ are used by Pas2'
  +'jsFileCache'#13#10#13#10'//------------------------------------------------'
  +'------------------------------'#13#10'// Options'#13#10'type'#13#10'  TP2js'
  +'CompilerOption = ('#13#10'    coSkipDefaultConfigs,'#13#10'    coBuildAll,'
  +#13#10'    // verbosity'#13#10'    coShowLogo,'#13#10'    coShowErrors,'#13
  +#10'    coShowWarnings,'#13#10'    coShowNotes,'#13#10'    coShowHints,'#13
  +#10'    coShowInfos,'#13#10'    coShowLineNumbers,'#13#10'    coShowTriedUse'
  +'dFiles,'#13#10'    coShowConditionals,'#13#10'    coShowUsedTools,'#13#10' '
  +'   coShowDebug,'#13#10'    coShowMessageNumbers, // not in "show all"'#13#10
  +'    // checks'#13#10'    coOverflowChecks,'#13#10'    coRangeChecks,'#13#10
  +'    coObjectChecks,'#13#10'    coAssertions,'#13#10'    // features'#13#10
  +'    coAllowCAssignments,'#13#10'    coAllowMacros,'#13#10'    // output'#13
  +#10'    coLowerCase,'#13#10'    coUseStrict,'#13#10'    coWriteDebugLog,'#13
  +#10'    coWriteMsgToStdErr,'#13#10'    // optimizations'#13#10'    coEnumVal'
  +'uesAsNumbers,'#13#10'    coKeepNotUsedPrivates,'#13#10'    coKeepNotUsedDec'
  +'larationsWPO,'#13#10'    // source map'#13#10'    coSourceMapCreate,'#13#10
  +'    coSourceMapInclude,'#13#10'    coSourceMapXSSIHeader'#13#10'    );'#13
  +#10'  TP2jsCompilerOptions = set of TP2jsCompilerOption;'#13#10'  TP2jsOptim'
  +'ization = coEnumValuesAsNumbers..coKeepNotUsedDeclarationsWPO;'#13#10'  TP2'
  +'jsRTLVersionCheck = ('#13#10'    rvcNone,'#13#10'    rvcMain,'#13#10'    rv'
  +'cSystem,'#13#10'    rvcUnit'#13#10'    );'#13#10'const'#13#10'  DefaultP2js'
  +'CompilerOptions = [coShowErrors,coSourceMapXSSIHeader,coUseStrict];'#13#10
  +'  DefaultP2jsRTLVersionCheck = rvcNone;'#13#10'  coShowAll = [coShowErrors.'
  +'.coShowDebug];'#13#10'  coO1Enable = [coEnumValuesAsNumbers];'#13#10'  coO1'
  +'Disable = [coKeepNotUsedPrivates,coKeepNotUsedDeclarationsWPO];'#13#10#13#10
  +'  p2jscoCaption: array[TP2jsCompilerOption] of string = ('#13#10'    // onl'
  +'y used by experts or programs parsing the pas2js output, no need for resour'
  +'cestrings'#13#10'    ''Skip default configs'','#13#10'    ''Build all'','#13
  +#10'    ''Show logo'','#13#10'    ''Show errors'','#13#10'    ''Show warning'
  +'s'','#13#10'    ''Show notes'','#13#10'    ''Show hints'','#13#10'    ''Sho'
  +'w infos'','#13#10'    ''Show line numbers'','#13#10'    ''Show tried/used f'
  +'iles'','#13#10'    ''Show conditionals'','#13#10'    ''Show used tools'','
  +#13#10'    ''Show debug'','#13#10'    ''Show message numbers'','#13#10'    '
  +'''Overflow checking'','#13#10'    ''Range checking'','#13#10'    ''Method c'
  +'all checking'','#13#10'    ''Assertions'','#13#10'    ''Allow C assignments'
  +''','#13#10'    ''Allow macros'','#13#10'    ''Lowercase identifiers'','#13
